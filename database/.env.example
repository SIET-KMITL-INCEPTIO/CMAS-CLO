# Supabase session pooler (Connect → Session pooler, port 5432). Not the
# transaction pooler (6543 + pgbouncer=true): it wraps every query in BEGIN/COMMIT.
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=5"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require"
