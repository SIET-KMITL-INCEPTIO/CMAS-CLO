# Keeps formatting consistent across VS Code / WebStorm / vim before Prettier
# even runs. Pairs with .gitattributes (line endings) and .prettierrc (style).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown uses trailing double-space for hard line breaks
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.sql]
indent_size = 2

[Makefile]
indent_style = tab
