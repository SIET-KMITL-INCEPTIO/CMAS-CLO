<?xml version="1.0" encoding="UTF-8"?>
<!-- The CMAS tab. Added to CMAS.xlam by `python scripts/build-excel-addin.py package`.
     Callbacks live in src/modCmasRibbon.bas. Labels are Thai: this is XML, not VBA source. -->
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui">
  <ribbon>
    <tabs>
      <tab id="cmasTab" label="CMAS">
        <group id="cmasConnectGroup" label="เชื่อมต่อ">
          <button id="cmasConnect" label="เชื่อมต่อ" size="large" imageMso="HyperlinkInsert"
                  screentip="เชื่อมต่อกับ CMAS" supertip="ขอรหัส 8 ตัว กรอกในหน้าเว็บ CMAS แล้วเลือกรายวิชา"
                  onAction="CmasRibbonConnect"/>
          <button id="cmasDisconnect" label="ตัดการเชื่อมต่อ" imageMso="Cancel"
                  onAction="CmasRibbonDisconnect"/>
        </group>
        <group id="cmasSyncGroup" label="คะแนน">
          <button id="cmasSyncNow" label="ซิงก์ตอนนี้" size="large" imageMso="Refresh"
                  supertip="ส่งช่องที่แก้ แล้วโหลดค่าล่าสุดจาก CMAS (ปกติทำเองทุก 10 วินาที)"
                  onAction="CmasRibbonSync"/>
          <button id="cmasKeepMine" label="ใช้ค่าของฉัน"
                  supertip="ช่องสีแดงที่เลือก: บันทึกค่าที่คุณกรอกทับค่าใน CMAS"
                  onAction="CmasRibbonKeepMine"/>
          <button id="cmasTakeServer" label="ใช้ค่าใน CMAS"
                  supertip="ช่องสีแดงที่เลือก: ทิ้งค่าที่คุณกรอก ใช้ค่าใน CMAS"
                  onAction="CmasRibbonTakeServer"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
