VITE_API_URL="http://localhost:3001"
VITE_APP_NAME="CLO System"
# Same OAuth client as app/server's GOOGLE_CLIENT_ID — this id is public
# (it's meant to be shipped to the browser), the server does the actual
# verification (FR-08).
VITE_GOOGLE_CLIENT_ID="[your-client-id].apps.googleusercontent.com"
