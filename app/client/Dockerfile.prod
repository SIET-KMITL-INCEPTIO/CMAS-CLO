# Multi-stage production build for React SPA client
# Deployment targets: Vercel (prefer), Docker registry, Fly.io, Railway
# Usage: docker build -f app/client/Dockerfile.prod -t cmas-client:latest .

# Stage 1: Build
# Base images are pinned by digest; Dependabot (docker) proposes new digests.
FROM node:25-alpine@sha256:bdf2cca6fe3dabd014ea60163eca3f0f7015fbd5c7ee1b0e9ccb4ced6eb02ef4 AS builder

WORKDIR /app

# Copy workspace manifests
COPY package.json package-lock.json ./
COPY app/client/package.json app/client/package.json
COPY app/server/package.json app/server/package.json

# Install exactly what package-lock.json records; fails if it is out of sync
RUN npm ci

# Copy source
COPY app/client ./app/client

# Build the client
RUN npm run build -w app/client

# Stage 2: Serve via lightweight nginx
# 1.30 is nginx's stable line; 1.27 stopped getting Alpine rebuilds and carried
# OpenSSL 3.3.3 with CRITICAL CVEs (Grype, PR #38).
FROM nginx:1.30-alpine@sha256:47928bf67eb62a1863cb08d9ecb52d3e704304ba614eaee17884204677702951

# Alpine ships fixes before the nginx image is rebuilt (brotli-libs CVE-2026-111497
# was fixed in 1.2.1-r0 two days after nginx:1.30-alpine was published).
RUN apk upgrade --no-cache

# Copy built assets from builder
COPY --from=builder /app/app/client/dist /usr/share/nginx/html

# Copy nginx config for SPA (all routes → index.html)
COPY <<EOF /etc/nginx/conf.d/default.conf
server {
    listen 5173;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Cache static assets (JS, CSS, images)
    location ~* \.(?:js|css|woff2?|png|jpg|jpeg|svg|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA fallback: all non-file routes → index.html
    location / {
        try_files \$uri \$uri/ /index.html;
    }

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
}
EOF

EXPOSE 5173

CMD ["nginx", "-g", "daemon off;"]
