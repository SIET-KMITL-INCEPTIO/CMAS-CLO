# Multi-stage production build for React SPA client
# Deployment targets: Vercel (prefer), Docker registry, Fly.io, Railway
# Usage: docker build -f app/client/Dockerfile.prod -t cmas-client:latest .

# Stage 1: Build
# Base images are pinned by digest; Dependabot (docker) proposes new digests.
FROM node:24-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS builder

WORKDIR /app

# Copy workspace manifests
COPY package.json package-lock.json ./
COPY app/client/package.json app/client/package.json
COPY app/server/package.json app/server/package.json

# Install exactly what package-lock.json records; fails if it is out of sync
RUN npm ci

# Copy source
COPY app/client ./app/client

# Build the client
RUN npm run build -w app/client

# Stage 2: Serve via lightweight nginx
FROM nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10

# Copy built assets from builder
COPY --from=builder /app/app/client/dist /usr/share/nginx/html

# Copy nginx config for SPA (all routes → index.html)
COPY <<EOF /etc/nginx/conf.d/default.conf
server {
    listen 5173;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Cache static assets (JS, CSS, images)
    location ~* \.(?:js|css|woff2?|png|jpg|jpeg|svg|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA fallback: all non-file routes → index.html
    location / {
        try_files \$uri \$uri/ /index.html;
    }

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
}
EOF

EXPOSE 5173

CMD ["nginx", "-g", "daemon off;"]
