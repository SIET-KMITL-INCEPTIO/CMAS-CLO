# Multi-stage production build for React SPA client
# Deployment targets: Vercel (prefer), Docker registry, Fly.io, Railway
# Usage: docker build -f app/client/Dockerfile.prod -t cmas-client:latest .

# Stage 1: Build
# Base images are pinned by digest; Dependabot (docker) proposes new digests.
FROM node:24-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS builder

WORKDIR /app

# Copy workspace manifests
COPY package.json package-lock.json ./
COPY app/client/package.json app/client/package.json
COPY app/server/package.json app/server/package.json

# Install exactly what package-lock.json records; fails if it is out of sync
RUN npm ci

# Copy source
COPY app/client ./app/client

# Build the client
RUN npm run build -w app/client

# Stage 2: Serve via lightweight nginx
# 1.30 is nginx's stable line; 1.27 stopped getting Alpine rebuilds and carried
# OpenSSL 3.3.3 with CRITICAL CVEs (Grype, PR #38).
# 1.30.7 (2026-11-18) fixes CVE-2026-113425, -121810, -123007, -123633, -123634
# (CRITICAL, in nginx itself, so `apk upgrade` below cannot reach them).
FROM nginx:1.30.7-alpine@sha256:bef154735288bc38d99fac41ae63730684bcc661503673a04a0f9bc526ba8598

# Alpine ships fixes before the nginx image is rebuilt (brotli-libs CVE-2026-111497
# was fixed in 1.2.1-r0 two days after nginx:1.30-alpine was published).
RUN apk upgrade --no-cache

# Copy built assets from builder
COPY --from=builder /app/app/client/dist /usr/share/nginx/html

# Copy nginx config for SPA (all routes → index.html)
# security.conf goes into every location: nginx drops the server's add_header
# lines in any location that sets one of its own (Cache-Control below), so the
# JS and CSS used to go out with no security header at all.
COPY <<EOF /etc/nginx/security.conf
add_header X-Frame-Options "SAMEORIGIN" always;
add_header X-Content-Type-Options "nosniff" always;
# OWASP: switch the old browser XSS filter off; "1; mode=block" can be abused.
add_header X-XSS-Protection "0" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
EOF
COPY <<EOF /etc/nginx/conf.d/default.conf
server {
    listen 5173;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Text compressed on the way out (the overview chunk: 414 kB, 119 kB gzipped).
    # Fonts and images are compressed already.
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript image/svg+xml application/json;

    # Cache static assets (JS, CSS, images)
    location ~* \.(?:js|css|woff2?|png|jpg|jpeg|svg|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/security.conf;
    }

    # SPA fallback: all non-file routes → index.html
    location / {
        try_files \$uri \$uri/ /index.html;
        include /etc/nginx/security.conf;
    }
}
EOF

EXPOSE 5173

CMD ["nginx", "-g", "daemon off;"]
