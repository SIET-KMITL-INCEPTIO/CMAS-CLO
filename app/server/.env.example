# Database (mirrors database/.env.example — Prisma client is generated from ../../database/schema.prisma)
DATABASE_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres"

# Auth
JWT_SECRET="[random-256-bit-string]"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Google sign-in (FR-08). Create an OAuth client (Web application) in Google
# Cloud Console; the client id is public (it's shipped to the browser as
# VITE_GOOGLE_CLIENT_ID too) — the server only uses it to check the `aud`
# claim on incoming ID tokens, no client secret is needed for this flow.
GOOGLE_CLIENT_ID="[your-client-id].apps.googleusercontent.com"
# Sign-ins from this domain (or with this Workspace `hd` claim) are approved
# automatically as INSTRUCTOR; anyone else lands PENDING for an ADMIN to
# approve by hand.
INSTITUTION_EMAIL_DOMAIN="kmitl.ac.th"

# App
NODE_ENV="development"
PORT=3001
CORS_ORIGIN="http://localhost:5173"

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW="1 minute"
