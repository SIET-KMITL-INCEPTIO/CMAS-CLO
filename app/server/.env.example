# Database (mirrors database/.env.example — Prisma client is generated from ../../database/schema.prisma)
# Supabase session pooler (Connect → Session pooler, port 5432). Not the
# transaction pooler (6543 + pgbouncer=true): it wraps every query in BEGIN/COMMIT.
# connection_limit=10: one page fires ~6 requests at once and each reads ~10
# tables in parallel; at 5 they queued (NFR-01, measured 2026-11-28). The
# session pooler gives a project 15 clients on the smallest compute, so 10
# leaves room for migrations and Prisma Studio.
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=10"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require"

# Auth
JWT_SECRET="[random-256-bit-string]"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Google sign-in (FR-08). Create an OAuth client (Web application) in Google
# Cloud Console; the client id is public (it's shipped to the browser as
# VITE_GOOGLE_CLIENT_ID too) — the server only uses it to check the `aud`
# claim on incoming ID tokens, no client secret is needed for this flow.
GOOGLE_CLIENT_ID="[your-client-id].apps.googleusercontent.com"
# Sign-ins from this domain (or with this Workspace `hd` claim) are approved
# automatically as INSTRUCTOR; anyone else lands PENDING for an ADMIN to
# approve by hand.
INSTITUTION_EMAIL_DOMAIN="kmitl.ac.th"
# Comma-separated emails that become ADMIN (and ACTIVE) on Google sign-in,
# from any domain (FR-05a). This is how the first ADMIN is made. Removing an
# email later does not demote the account — change its role by hand.
ADMIN_EMAILS=""

# Email sign-in link (FR-07). smtp://user:pass@host:587 or smtps://user:pass@host:465
# (the faculty mail server, Google Workspace SMTP relay, or any provider's SMTP).
# Leave empty in development: the link is printed in the server log instead.
# Empty in production: asking for a link answers 503 and only Google works.
SMTP_URL=""
MAIL_FROM="CMAS <no-reply@kmitl.ac.th>"

# App
NODE_ENV="development"
PORT=3001
CORS_ORIGIN="http://localhost:5173"

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW="1 minute"
# Requests from the Excel add-in / score workbook, per IP, counted apart from the web app
RATE_LIMIT_EXCEL_MAX=1200
# Behind a reverse proxy: what to trust for the client's IP ("1" = one hop, or the proxy's
# addresses). Unset = the socket's address, so all users behind the proxy share one rate limit.
# TRUST_PROXY=1
# POST /auth/refresh per IP per 15 minutes (default 30)
AUTH_REFRESH_LIMIT_MAX=30
