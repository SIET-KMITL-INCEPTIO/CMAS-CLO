 target="cmasGenStruct_Merged_20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cmasGenStruct_Merged_38" style="edgeStyle=none;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cmasGenStruct_Merged_24" target="cmasGenStruct_Merged_21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cmasGenStruct_Merged_39" style="edgeStyle=none;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cmasGenStruct_Merged_24" target="cmasGenStruct_Merged_22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cmasGenStruct_Merged_40" style="edgeStyle=none;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cmasGenStruct_Merged_24" target="cmasGenStruct_Merged_23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cmasGenStruct_Merged_41" value="System" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="546" width="160" height="60" as="geometry"/></mxCell><mxCell id="cmasGenStruct_Merged_42" style="edgeStyle=none;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cmasGenStruct_Merged_41" target="cmasGenStruct_Merged_5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cmasGenStruct_Merged_43" style="edgeStyle=none;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cmasGenStruct_Merged_41" target="cmasGenStruct_Merged_24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cmasGenStruct_Merged_44" value="&lt;b&gt;สิ่งที่หายไปพร้อมกับบทบาท&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;SEC-4 · การยกระดับสิทธิ์ตนเอง&lt;/b&gt;&lt;br&gt;วันนี้กันด้วยเส้นแบ่งสองเส้น — ผู้ประสานงานเชิญได้แค่ผู้ช่วยสอน และมีแต่ผู้ดูแลระบบที่ตั้ง LEAD/CO ได้ · ถ้ามีบทบาทเดียว การเชิญใครเข้ามาคือการให้สิทธิ์เต็มทันที&lt;br&gt;&lt;br&gt;&lt;b&gt;EX-7 · ที่มาของไฟล์ Excel&lt;/b&gt;&lt;br&gt;บรรทัด &quot;จัดทำโดยผู้ช่วยสอน — รอผู้สอนตรวจสอบ&quot; ต้องรู้บทบาทของผู้สร้าง ไม่มีบทบาท ก็ไม่มีที่มา&lt;br&gt;&lt;br&gt;&lt;b&gt;can() เหลือความหมายเดียว&lt;/b&gt;&lt;br&gt;เมทริกซ์ 18 แถวยุบเหลือคำถาม &quot;อยู่ในรายวิชานี้ไหม&quot;&lt;br&gt;&lt;br&gt;&lt;b&gt;ASM-03 กลับมา&lt;/b&gt;&lt;br&gt;ข้อสมมุติที่ยกเลิกไปเมื่อ 2568-09-10 เพราะผู้ช่วยสอนตรึงเกรดได้ · การยุบคือการย้อนมตินั้น ไม่ใช่การทำให้ง่ายขึ้นเฉย ๆ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#B8912B;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="90" width="300" height="420" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
