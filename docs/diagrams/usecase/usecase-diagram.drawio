mxCell id="KS-gj86TwRRw6v9gwuPp-29" value="ดูข้อมูลทุกรายวิชาได้ (อ่านอย่างเดียว) แต่ไม่ทำงานสอน&lt;br&gt;เส้นทึบ = ผู้ใช้ทำเอง · «include» = ทำร่วมกันเสมอ · «extend» = ทำเพิ่มเมื่อจำเป็น · พื้นสีฟ้าอ่อน = ใช้ได้แล้วในระบบจริง ที่เหลือยังอยู่ในต้นแบบ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%2BThai;fontSize=16;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="80" y="90" width="1140" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram>
