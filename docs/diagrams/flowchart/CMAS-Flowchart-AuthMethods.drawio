text;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1480" y="266" width="120" height="26" as="geometry"/></mxCell><mxCell id="am-0-40" value="" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.06;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="1260" y="300" width="44" height="26" as="geometry"/></mxCell><mxCell id="am-0-41" value="กระบวนการย่อย" style="whiteSpace=wrap;html=1;text;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1310" y="300" width="120" height="26" as="geometry"/></mxCell><mxCell id="am-0-42" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1430" y="300" width="44" height="26" as="geometry"/></mxCell><mxCell id="am-0-43" value="แจ้งข้อผิดพลาด" style="whiteSpace=wrap;html=1;text;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1480" y="300" width="120" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="am-1" name="1 · ผังลำดับงาน"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="2060" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="am-1-1" value="เข้าสู่ระบบ 2 ทางเลือก — ผังลำดับงาน" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="20" width="1100" height="34" as="geometry"/></mxCell><mxCell id="am-1-2" value="&lt;b&gt;ผู้ใช้งาน:&lt;/b&gt; ผู้ใช้ที่ยังไม่มี session" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" parent="1" vertex="1"><mxGeometry x="40" y="62" width="1100" height="22" as="geometry"/></mxCell><mxCell id="am-1-3" value="&lt;b&gt;อ้างอิง:&lt;/b&gt; AUTH ในต้นแบบ · ทาง A = POST /auth/google · ทาง B = POST /auth/email-link และ /auth/email-link/verify" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" parent="1" vertex="1"><mxGeometry x="40" y="84" width="1100" height="22" as="geometry"/></mxCell><mxCell id="am-1-4" value="&lt;b&gt;อ่านอย่างไร:&lt;/b&gt; สองทางแยกกันจนได้ “อีเมลที่ยืนยันแล้ว” จากนั้นเข้ากฎร่วมชุดเดียว (C1) ลูกศรประ = เขียนหรืออ่านข้อมูล" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" parent="1" vertex="1"><mxGeometry x="40" y="106" width="1100" height="22" as="geometry"/></mxCell><mxCell id="am-1-5" value="&lt;b&gt;สัญลักษณ์&lt;/b&gt;" style="whiteSpace=wrap;html=1;text;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1230" y="140" width="330" height="24" as="geometry"/></mxCell><mxCell id="am-1-6" value="" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1230" y="168" width="44" height="26" as="geometry"/></mxCell><mxCell id="am-1-7" value="เริ่ม" style="whiteSpace=wrap;html=1;text;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1280" y="168" width="120" height="26" as="geometry"/></mxCell><mxCell id="am-1-8" value="" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#666666;fontStyle=1;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1400" y="168" width="44" height="26" as="geometry"/></mxCell><mxCell id="am-1-9" value="จบ" style="whiteSpace=wrap;html=1;text;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1450" y="168" width="120" height="26" as="geometry"/></mxCell><mxCell id="am-1-10" value="" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1230" y="202" width="44" height="26" as="geometry"/></mxCell><mxCell id="am-1-11" value="รับข้อมูล / แสดงผล" style="whiteSpace=wrap;html=1;text;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1280" y="202" width="120" height="26" as="geometry"/></mxCell><mxCell id="am-1-12" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1400" y="202" width="44" height="26" as="geometry"/></mxCell><mxCell id="am-1-13" value="ประมวลผล" style="whiteSpace=wrap;html=1;text;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1450" y="202" width="120" height="26" as="geometry"/></mxCell><mxCell id="am-1-14" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1230" y="236" width="44" height="26" as="geometry"/></mxCell><mxCell id="am-1-15" value="เงื่อนไข" style="whiteSpace=wrap;html=1;text;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1280" y="236" width="120" height="26" as="geometry"/></mxCell><mxCell id="am-1-16" value="" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1400" y="236" width="44" height="26" as="geometry"/></mxCell><mxCell id="am-1-17" value="ข้อมูล" style="whiteSpace=wrap;html=1;text;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1450" y="236" width="120" height="26" as="geometry"/></mxCell><mxCell id="am-1-18" value="" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.06;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="1230" y="270" width="44" height="26" as="geometry"/></mxCell><mxCell id="am-1-19" value="กระบวนการย่อย" style="whiteSpace=wrap;html=1;text;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1280" y="270" width="120" height="26" as="geometry"/></mxCell><mxCell id="am-1-20" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1400" y="270" width="44" height="26" as="geometry"/></mxCell><mxCell id="am-1-21" value="แจ้งข้อผิดพลาด" style="whiteSpace=wrap;html=1;text;align=left;verticalAlign=middle;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1450" y="270" width="120" height="26" as="geometry"/></mxCell><mxCell id="am-1-22" value="เริ่ม · เปิดหน้าเข้าสู่ระบบ" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;fontSize=13;" parent="1" vertex="1"><mxGeometry x="480" y="140" width="240" height="56" as="geometry"/></mxCell><mxCell id="am-1-23" value="ผู้ใช้เลือกวิธีเข้า" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" parent="1" vertex="1"><mxGeometry x="480" y="235" width="240" height="100" as="geometry"/></mxCell><mxCell id="am-1-24" value="กดปุ่ม Google · เลือกบัญชี" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" parent="1" vertex="1"><mxGeometry x="180" y="380" width="240" height="64" as="geometry"/></mxCell><mxCell id="am-1-25" value="Google ยืนยันตัวตน&lt;br&gt;แล้วออก ID token" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.06;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="180" y="480" width="240" height="64" as="geometry"/></mxCell><mxCell id="am-1-26" value="ส่ง idToken ไปที่&lt;br&gt;POST /auth/google" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;" parent="1" vertex="1"><mxGeometry x="180" y="580" width="240" height="64" as="geometry"/></mxCell><mxCell id="am-1-27" value="token ผ่านไหม?&lt;br&gt;(ลายเซ็น · aud · iss · email_verified · hd)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" parent="1" vertex="1"><mxGeometry x="160" y="690" width="280" height="110" as="geometry"/></mxCell><mxCell id="am-1-28" value="เข้าสู่ระบบไม่สำเร็จ&lt;br&gt;(ข้อความเดียวกันทุกกรณี)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" parent="1" vertex="1"><mxGeometry x="465" y="715" width="190" height="60" as="geometry"/></mxCell><mxCell id="am-1-29" value="&lt;b&gt;ทำไมมี 2 ทาง&lt;/b&gt;&lt;br&gt;• Google ล่มหรือตั้งค่าพลาด ยังมีลิงก์อีเมลเป็นทางสำรอง&lt;br&gt;• ผู้สอนที่ไม่มีบัญชี Google ผูกกับอีเมลคณะ เข้าด้วยลิงก์ได้ ไม่ต้องรอ ADMIN สร้างบัญชี&lt;br&gt;• ทั้งสองทางผ่านกฎร่วม C1 เดียวกัน" style="whiteSpace=wrap;html=1;rounded=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12.5;fillColor=#F5F5F5;strokeColor=#999999;" parent="1" vertex="1"><mxGeometry x="330" y="880" width="290" height="190" as="geometry"/></mxCell><mxCell id="am-1-30" value="กรอกอีเมล" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" parent="1" vertex="1"><mxGeometry x="780" y="380" width="240" height="64" as="geometry"/></mxCell><mxCell id="am-1-31" value="รูปแบบอีเมลถูกต้อง?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" parent="1" vertex="1"><mxGeometry x="780" y="475" width="240" height="100" as="geometry"/></mxCell><mxCell id="am-1-32" value="แจ้ง “กรอกอีเมลให้ถูกต้อง”&lt;br&gt;แล้วกรอกใหม่" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1150" y="495" width="200" height="60" as="geometry"/></mxCell><mxCell id="am-1-33" value="ส่งอีเมลไปที่&lt;br&gt;POST /auth/email-link&lt;br&gt;(จำกัดความถี่ 60 วินาที)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;" parent="1" vertex="1"><mxGeometry x="780" y="620" width="240" height="76" as="geometry"/></mxCell><mxCell id="am-1-34" value="สร้างโทเคน 32 bytes&lt;br&gt;เก็บเฉพาะ hash · อายุ 24 ชม.&lt;br&gt;ส่งลิงก์ทางอีเมล" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;" parent="1" vertex="1"><mxGeometry x="780" y="730" width="240" height="76" as="geometry"/></mxCell><mxCell id="am-1-35" value="D1&lt;br&gt;โทเคนลิงก์เข้าสู่ระบบ&lt;br&gt;(hash · ใช้ครั้งเดียว)&lt;br&gt;EmailVerificationToken ใช้ซ้ำได้" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1140" y="710" width="220" height="80" as="geometry"/></mxCell><mxCell id="am-1-36" value="หน้า “ตรวจสอบอีเมลของคุณ”&lt;br&gt;เหมือนกันทุกกรณี (FR-07)" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" parent="1" vertex="1"><mxGeometry x="770" y="850" width="260" height="70" as="geometry"/></mxCell><mxCell id="am-1-37" value="ผู้ใช้เปิดลิงก์ในอีเมล&lt;br&gt;/auth/verify?token=…" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" parent="1" vertex="1"><mxGeometry x="770" y="960" width="260" height="70" as="geometry"/></mxCell><mxCell id="am-1-38" value="ส่งโทเคนไปที่&lt;br&gt;POST /auth/email-link/verify" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;" parent="1" vertex="1"><mxGeometry x="770" y="1070" width="260" height="64" as="geometry"/></mxCell><mxCell id="am-1-39" value="โทเคนใช้ได้?&lt;br&gt;(มีอยู่ · ยังไม่ใช้ · ไม่หมดอายุ)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" parent="1" vertex="1"><mxGeometry x="760" y="1170" width="280" height="110" as="geometry"/></mxCell><mxCell id="am-1-40" value="ลิงก์ใช้ไม่ได้&lt;br&gt;ขอลิงก์ใหม่" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1150" y="1195" width="200" height="60" as="geometry"/></mxCell><mxCell id="am-1-41" value="ทำเครื่องหมายโทเคนว่าใช้แล้ว&lt;br&gt;ได้ “อีเมลที่ยืนยันแล้ว”" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;" parent="1" vertex="1"><mxGeometry x="770" y="1305" width="260" height="64" as="geometry"/></mxCell><mxCell id="am-1-42" value="ได้ “อีเมลที่ยืนยันแล้ว”&lt;br&gt;จากทางใดทางหนึ่ง" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;" parent="1" vertex="1"><mxGeometry x="470" y="1410" width="260" height="70" as="geometry"/></mxCell><mxCell id="am-1-43" value="ตัดสินตามกฎเดียว (ฟังก์ชันตัวเดียว)&lt;br&gt;หาบัญชีจากอีเมล · ไม่มีก็สร้าง&lt;br&gt;โดเมนคณะ → ACTIVE · โดเมนอื่น → PENDING" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.06;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="430" y="1520" width="340" height="96" as="geometry"/></mxCell><mxCell id="am-1-44" value="สถานะบัญชี?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" parent="1" vertex="1"><mxGeometry x="470" y="1660" width="260" height="100" as="geometry"/></mxCell><mxCell id="am-1-45" value="ปฏิเสธ&lt;br&gt;บัญชีถูกปิด (isActive = false)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" parent="1" vertex="1"><mxGeometry x="115" y="1685" width="230" height="60" as="geometry"/></mxCell><mxCell id="am-1-46" value="ออก access token (15 นาที)&lt;br&gt;และ refresh cookie (7 วัน)&lt;br&gt;บันทึก AuthEvent" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;" parent="1" vertex="1"><mxGeometry x="460" y="1830" width="280" height="76" as="geometry"/></mxCell><mxCell id="am-1-47" value="จบ · เข้าหน้าแรก" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#666666;fontStyle=1;fontSize=13;" parent="1" vertex="1"><mxGeometry x="490" y="1950" width="220" height="56" as="geometry"/></mxCell><mxCell id="am-1-48" value="หน้า “รอผู้ดูแลระบบอนุมัติ”&lt;br&gt;(ไม่ออก token)" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" parent="1" vertex="1"><mxGeometry x="870" y="1830" width="260" height="76" as="geometry"/></mxCell><mxCell id="am-1-49" value="ADMIN อนุมัติ&lt;br&gt;PATCH /users/:id/approve (FR-08b)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;" parent="1" vertex="1"><mxGeometry x="860" y="1950" width="280" height="64" as="geometry"/></mxCell><mxCell id="am-1-50" value="D2&lt;br&gt;User" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1180" y="1635" width="150" height="70" as="geometry"/></mxCell><mxCell id="am-1-51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="am-1-22" target="am-1-23" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="am-1-52" value="Google" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="am-1-23" target="am-1-24" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="am-1-53" value