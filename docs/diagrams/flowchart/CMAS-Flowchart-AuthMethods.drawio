Space=wrap;html=1;fillColor=#333333;strokeColor=#333333;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" parent="1" vertex="1"><mxGeometry x="104" y="130" width="70" height="36" as="geometry"/></mxCell><mxCell id="am-2-6" value="ประเด็น" style="whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#333333;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" parent="1" vertex="1"><mxGeometry x="174" y="130" width="330" height="36" as="geometry"/></mxCell><mxCell id="am-2-7" value="ตัวเลือก" style="whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#333333;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" parent="1" vertex="1"><mxGeometry x="504" y="130" width="560" height="36" as="geometry"/></mxCell><mxCell id="am-2-8" value="มติ / ข้อเสนอ" style="whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#333333;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1064" y="130" width="380" height="36" as="geometry"/></mxCell><mxCell id="am-2-9" value="Q1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=center;verticalAlign=middle;fontSize=12.5;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="166" width="64" height="76" as="geometry"/></mxCell><mxCell id="am-2-10" value="M4" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=center;verticalAlign=middle;fontSize=12.5;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="104" y="166" width="70" height="76" as="geometry"/></mxCell><mxCell id="am-2-11" value="ใช้ “ลิงก์” หรือ “รหัส 6 หลัก” ในอีเมล" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12.5;" parent="1" vertex="1"><mxGeometry x="174" y="166" width="330" height="76" as="geometry"/></mxCell><mxCell id="am-2-12" value="ลิงก์: กดครั้งเดียวเข้า แต่เปิดคนละเครื่องกับที่กรอกไม่สะดวก · รหัส: พิมพ์กลับเข้าหน้าเดิม ต้องกันเดารหัส" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12.5;" parent="1" vertex="1"><mxGeometry x="504" y="166" width="560" height="76" as="geometry"/></mxCell><mxCell id="am-2-13" value="มติแล้ว: ลิงก์ (FR-07 · ต้นแบบทำเป็นลิงก์) 32 bytes ใช้ครั้งเดียว 24 ชม." style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12.5;" parent="1" vertex="1"><mxGeometry x="1064" y="166" width="380" height="76" as="geometry"/></mxCell><mxCell id="am-2-14" value="Q2" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=center;verticalAlign=middle;fontSize=12.5;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="242" width="64" height="76" as="geometry"/></mxCell><mxCell id="am-2-15" value="C1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=center;verticalAlign=middle;fontSize=12.5;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="104" y="242" width="70" height="76" as="geometry"/></mxCell><mxCell id="am-2-16" value="อีเมลโดเมนอื่นขอลิงก์ได้ไหม" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12.5;" parent="1" vertex="1"><mxGeometry x="174" y="242" width="330" height="76" as="geometry"/></mxCell><mxCell id="am-2-17" value="ได้ แล้วไป PENDING · หรือไม่ส่งลิงก์ให้เลย (จะเปิดช่องให้เดาว่าโดเมนใดผ่าน)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12.5;" parent="1" vertex="1"><mxGeometry x="504" y="242" width="560" height="76" as="geometry"/></mxCell><mxCell id="am-2-18" value="มติแล้ว: ได้ ตาม FR-08 กฎเดียวกับ Google ผู้ใช้เห็นหน้าเดิม ไม่รู้ว่าอีเมลนั้นมีบัญชีหรือไม่" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12.5;" parent="1" vertex="1"><mxGeometry x="1064" y="242" width="380" height="76" as="geometry"/></mxCell><mxCell id="am-2-19" value="Q3" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=center;verticalAlign=middle;fontSize=12.5;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="318" width="64" height="76" as="geometry"/></mxCell><mxCell id="am-2-20" value="C1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=center;verticalAlign=middle;fontSize=12.5;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="104" y="318" width="70" height="76" as="geometry"/></mxCell><mxCell id="am-2-21" value="อีเมลที่ยังไม่มีบัญชี สร้างให้เลยหรือไม่" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12.5;" parent="1" vertex="1"><mxGeometry x="174" y="318" width="330" height="76" as="geometry"/></mxCell><mxCell id="am-2-22" value="สร้างตอนเปิดลิงก์ · หรือต้องให้ ADMIN สร้างก่อน" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12.5;" parent="1" vertex="1"><mxGeometry x="504" y="318" width="560" height="76" as="geometry"/></mxCell><mxCell id="am-2-23" value="มติแล้ว: สร้างตอนเปิดลิงก์ (คลิกได้แปลว่าเป็นเจ้าของอีเมล) ชื่อใช้ส่วนหน้าของอีเมล แก้ได้ที่ UC 9.1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12.5;" parent="1" vertex="1"><mxGeometry x="1064" y="318" width="380" height="76" as="geometry"/></mxCell><mxCell id="am-2-24" value="Q4" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=center;verticalAlign=middle;fontSize=12.5;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="394" width="64" height="76" as="geometry"/></mxCell><mxCell id="am-2-25" value="C1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=center;verticalAlign=middle;fontSize=12.5;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="104" y="394" width="70" height="76" as="geometry"/></mxCell><mxCell id="am-2-26" value="จับคู่บัญชี Google กับบัญชีลิงก์อีเมลของคนเดียวกัน" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12.5;" parent="1" vertex="1"><mxGeometry x="174" y="394" width="330" height="76" as="geometry"/></mxCell><mxCell id="am-2-27" value="จับด้วย sub (Google) กับอีเมล (ลิงก์) แยกกัน อาจเกิดสองบัญชี · หรือจับด้วยอีเมลที่ยืนยันแล้วทั้งคู่ แล้วเก็บ sub ตอน Google ครั้งแรก" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12.5;" parent="1" vertex="1"><mxGeometry x="504" y="394" width="560" height="76" as="geometry"/></mxCell><mxCell id="am-2-28" value="ยังต้องตัดสิน · เสนอ: จับด้วยอีเมลที่ยืนยันแล้ว เก็บ sub ไว้ตรวจครั้งต่อไป เขียนลงกฎร่วมที่เดียว" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12.5;" parent="1" vertex="1"><mxGeometry x="1064" y="394" width="380" height="76" as="geometry"/></mxCell><mxCell id="am-2-29" value="Q5" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=center;verticalAlign=middle;fontSize=12.5;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="470" width="64" height="76" as="geometry"/></mxCell><mxCell id="am-2-30" value="S1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=center;verticalAlign=middle;fontSize=12.5;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="104" y="470" width="70" height="76" as="geometry"/></mxCell><mxCell id="am-2-31" value="บันทึก AuthEvent ของทางลิงก์อีเมลเป็นค่าอะไร" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12.5;" parent="1" vertex="1"><mxGeometry x="174" y="470" width="330" height="76" as="geometry"/></mxCell><mxCell id="am-2-32" value="ใช้ LOGIN เดิม · หรือเพิ่มค่าใหม่ เช่น LOGIN_EMAIL_LINK ใน enum AuthEventAction" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12.5;" parent="1" vertex="1"><mxGeometry x="504" y="470" width="560" height="76" as="geometry"/></mxCell><mxCell id="am-2-33" value="มติแล้ว: ใช้ LOGIN (ความหมายใหม่ = ลิงก์อีเมล) ไม่ต้องแก้ enum · ต้นแบบทำแบบนี้" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12.5;" parent="1" vertex="1"><mxGeometry x="1064" y="470" width="380" height="76" as="geometry"/></mxCell><mxCell id="am-2-34" value="Q6" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=center;verticalAlign=middle;fontSize=12.5;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="546" width="64" height="76" as="geometry"/></mxCell><mxCell id="am-2-35" value="M4" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=center;verticalAlign=middle;fontSize=12.5;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="104" y="546" width="70" height="76" as="geometry"/></mxCell><mxCell id="am-2-36" value="ส่งอีเมลด้วยอะไร" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12.5;" parent="1" vertex="1"><mxGeometry x="174" y="546" width="330" height="76" as="geometry"/></mxCell><mxCell id="am-2-37" value="SMTP ของคณะ · บริการส่งอีเมล (เช่น Resend, SES) · ต้องมีโดเมนผู้ส่งที่ผ่าน SPF/DKIM" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12.5;" parent="1" vertex="1"><mxGeometry x="504" y="546" width="560" height="76" as="geometry"/></mxCell><mxCell id="am-2-38" value="ยังต้องตัดสิน · ต้องมีก่อนเปิดทางสำรอง เพราะถ้าอีเมลไม่ถึง ทางสำรองก็ใช้ไม่ได้" style="whiteSpace=wrap;html=