Width=2;strokeColor=#000000;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l-7" parent="1" vertex="1" value="ผ่าน" style="text;html=1;align=left;verticalAlign=middle;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%2BThai;fontSize=14;fontColor=#000000;"><mxGeometry x="292" y="412" width="120" height="20" as="geometry"/></mxCell><mxCell id="e-8" parent="1" edge="1" source="n-d1" target="n-s3" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeWidth=2;strokeColor=#000000;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="40" y="364"/><mxPoint x="40" y="268"/></Array></mxGeometry></mxCell><mxCell id="l-8" parent="1" vertex="1" value="ไม่ผ่าน (แก้ไข)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%2BThai;fontSize=14;fontColor=#000000;"><mxGeometry x="48" y="336" width="120" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>