lowGuid>f3abc5c7-249f-48f7-990e-5831cbd680c7</b:FlowGuid><b:Id>291</b:Id><b:InteractionKey>1f8976b5-43ee-4f0c-9f16-d8889a8ebe44:f3abc5c7-249f-48f7-990e-5831cbd680c7:3a1ff44a-51b2-47f5-afb6-d29deb3a84a9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in 1.0 เข้าสู่ระบบและดูแลบัญชี</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into 1.0 เข้าสู่ระบบและดูแลบัญชี in order to change the flow of program execution within 1.0 เข้าสู่ระบบและดูแลบัญชี to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ข้อมูลบัญชี</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>1f8976b5-43ee-4f0c-9f16-d8889a8ebe44</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3a1ff44a-51b2-47f5-afb6-d29deb3a84a9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S21f8976b5-43ee-4f0c-9f16-d8889a8ebe44c559f97b-e30a-4469-b622-d8e0160236d2f21494b5-dcc7-4d98-9dd9-3c701f15d4fc</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>0df06edf-e481-4ed2-b4c5-4c53b6b2b1e4</b:DrawingSurfaceGuid><b:FlowGuid>c559f97b-e30a-4469-b622-d8e0160236d2</b:FlowGuid><b:Id>292</b:Id><b:InteractionKey>1f8976b5-43ee-4f0c-9f16-d8889a8ebe44:c559f97b-e30a-4469-b622-d8e0160236d2:f21494b5-dcc7-4d98-9dd9-3c701f15d4fc</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the 2.0 จัดการรายวิชาและผู้สอน Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>2.0 จัดการรายวิชาและผู้สอน may be spoofed by an attacker and this may lead to information disclosure by D1 บัญชีผู้ใช้. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายชื่อผู้สอน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>1f8976b5-43ee-4f0c-9f16-d8889a8ebe44</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f21494b5-dcc7-4d98-9dd9-3c701f15d4fc</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R61f8976b5-43ee-4f0c-9f16-d8889a8ebe44c559f97b-e30a-4469-b622-d8e0160236d2f21494b5-dcc7-4d98-9dd9-3c701f15d4fc</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>0df06edf-e481-4ed2-b4c5-4c53b6b2b1e4</b:DrawingSurfaceGuid><b:FlowGuid>c559f97b-e30a-4469-b622-d8e0160236d2</b:FlowGuid><b:Id>293</b:Id><b:InteractionKey>1f8976b5-43ee-4f0c-9f16-d8889a8ebe44:c559f97b-e30a-4469-b622-d8e0160236d2:f21494b5-dcc7-4d98-9dd9-3c701f15d4fc</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by 2.0 จัดการรายวิชาและผู้สอน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>2.0 จัดการรายวิชาและผู้สอน claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายชื่อผู้สอน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>1f8976b5-43ee-4f0c-9f16-d8889a8ebe44</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f21494b5-dcc7-4d98-9dd9-3c701f15d4fc</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upg