atCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent prevents access to a data store on the other side of the trust boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายชื่อ (ไม่นับผู้ถอน)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c16770c8-07a4-424e-b80f-b45e5eb2beb4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f5955920-e121-4620-becd-c3deca036284</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E6c16770c8-07a4-424e-b80f-b45e5eb2beb45ba4b45e-2f02-4c78-a653-d19b2e817a46f5955920-e121-4620-becd-c3deca036284</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>5ba4b45e-2f02-4c78-a653-d19b2e817a46</b:FlowGuid><b:Id>547</b:Id><b:InteractionKey>c16770c8-07a4-424e-b80f-b45e5eb2beb4:5ba4b45e-2f02-4c78-a653-d19b2e817a46:f5955920-e121-4620-becd-c3deca036284</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D4 นักศึกษา may be able to remotely execute code for 6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายชื่อ (ไม่นับผู้ถอน)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c16770c8-07a4-424e-b80f-b45e5eb2beb4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f5955920-e121-4620-becd-c3deca036284</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E7c16770c8-07a4-424e-b80f-b45e5eb2beb45ba4b45e-2f02-4c78-a653-d19b2e817a46f5955920-e121-4620-becd-c3deca036284</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>5ba4b45e-2f02-4c78-a653-d19b2e817a46</b:FlowGuid><b:Id>548</b:Id><b:InteractionKey>c16770c8-07a4-424e-b80f-b45e5eb2beb4:5ba4b45e-2f02-4c78-a653-d19b2e817a46:f5955920-e121-4620-becd-c3deca036284</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in 6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into 6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด in order to change the flow of program execution within 6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายชื่อ (ไม่นับผู้ถอน)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c16770c8-07a4-424e-b80f-b45e5eb2beb4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f5955920-e121-4620-becd-c3deca036284</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S26fbd1295-fff0-4ece-9789-a72e03749475546146db-bca2-4409-a2f7-cfbba73fa884f5955920-e121-4620-becd-c3deca036284</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>546146db-bca2-4409-a2f7-cfbba73fa884</b:FlowGuid><b:Id>549</b:Id><b:InteractionKey>6fbd1295-fff0-4ece-9789-a72e03749475:546146db-bca2-4409-a2f7-cfbba73fa884:f5955920-e121-4620-becd-c3deca036284</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the 6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด may be spoofed by an attacker and this may lead to information disclosure by D5 คะแนน. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6fbd1295-fff0-4ece-9789-a72e03749475</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f5955920-e121-4620-becd-c3deca036284</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R66fbd1295-fff0-4ece-9789-a72e03749475546146db-bca2-4409-a2f7-cfbba73fa884f5955920-e121-4620-becd-c3deca036284</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>546146db-bca2-4409-a2f7-cfbba73fa884</b:FlowGuid><b:Id>550</b:Id><b:InteractionKey>6fbd1295-fff0-4ece-9789-a72e03749475:546146db-bca2-4409-a2f7-cfbba73fa884:f5955920-e121-4620-becd-c3deca036284</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by 6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6fbd1295-fff0-4ece-9789-a72e03749475</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f5955920-e121-4620-becd-c3deca036284</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D36fbd1295-fff0-4ece-9789-a72e03749475546146db-bca2-4409-a2f7-cfbba73fa884f5955920-e121-4620-becd-c3deca036284</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>546146db-bca2-4409-a2f7-cfbba73fa884</b:FlowGuid><b:Id>551</b:Id><b:InteractionKey>6fbd1295-fff0-4ece-9789-a72e03749475:546146db-bca2-4409-a2f7-cfbba73fa884:f5955920-e121-4620-becd-c3deca036284</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for 6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6fbd1295-fff0-4ece-9789-a72e03749475</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f5955920-e121-4620-becd-c3deca036284</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false<