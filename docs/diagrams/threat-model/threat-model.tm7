reatDescription</a:Key><a:Value>An external agent prevents access to a data store on the other side of the trust boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอรายชื่อ</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>3a183061-e82a-4278-ac3d-b13f48ea57e9</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E63a183061-e82a-4278-ac3d-b13f48ea57e9ea5c39dc-3b45-4c87-967b-f4f7dd15b3cfb53f4936-2fd9-4b5a-961d-015067f3fd8e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>ea5c39dc-3b45-4c87-967b-f4f7dd15b3cf</b:FlowGuid><b:Id>863</b:Id><b:InteractionKey>3a183061-e82a-4278-ac3d-b13f48ea57e9:ea5c39dc-3b45-4c87-967b-f4f7dd15b3cf:b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>6.1 ประเมินผล CLO และติดตามนักศึกษา May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D5 คะแนน may be able to remotely execute code for 6.1 ประเมินผล CLO และติดตามนักศึกษา.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอรายชื่อ</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>3a183061-e82a-4278-ac3d-b13f48ea57e9</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E73a183061-e82a-4278-ac3d-b13f48ea57e9ea5c39dc-3b45-4c87-967b-f4f7dd15b3cfb53f4936-2fd9-4b5a-961d-015067f3fd8e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>ea5c39dc-3b45-4c87-967b-f4f7dd15b3cf</b:FlowGuid><b:Id>864</b:Id><b:InteractionKey>3a183061-e82a-4278-ac3d-b13f48ea57e9:ea5c39dc-3b45-4c87-967b-f4f7dd15b3cf:b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in 6.1 ประเมินผล CLO และติดตามนักศึกษา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into 6.1 ประเมินผล CLO และติดตามนักศึกษา in order to change the flow of program execution within 6.1 ประเมินผล CLO และติดตามนักศึกษา to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอรายชื่อ</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>3a183061-e82a-4278-ac3d-b13f48ea57e9</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S1b53f4936-2fd9-4b5a-961d-015067f3fd8e1527411a-43e9-4a09-9dfe-6ce2ac4d65b13a183061-e82a-4278-ac3d-b13f48ea57e9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>1527411a-43e9-4a09-9dfe-6ce2ac4d65b1</b:FlowGuid><b:Id>865</b:Id><b:InteractionKey>b53f4936-2fd9-4b5a-961d-015067f3fd8e:1527411a-43e9-4a09-9dfe-6ce2ac4d65b1:3a183061-e82a-4278-ac3d-b13f48ea57e9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the 6.1 ประเมินผล CLO และติดตามนักศึกษา Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>6.1 ประเมินผล CLO และติดตามนักศึกษา may be spoofed by an attacker and this may lead to unauthorized access to D5 คะแนน. Consider using a standard authentication mechanism to identify the source process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายชื่อ (ไม่นับผู้ถอน)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3a183061-e82a-4278-ac3d-b13f48ea57e9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T18b53f4936-2fd9-4b5a-961d-015067f3fd8e1527411a-43e9-4a09-9dfe-6ce2ac4d65b13a183061-e82a-4278-ac3d-b13f48ea57e9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>1527411a-43e9-4a09-9dfe-6ce2ac4d65b1</b:FlowGuid><b:Id>866</b:Id><b:InteractionKey>b53f4936-2fd9-4b5a-961d-015067f3fd8e:1527411a-43e9-4a09-9dfe-6ce2ac4d65b1:3a183061-e82a-4278-ac3d-b13f48ea57e9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>The D5 คะแนน Data Store Could Be Corrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across รายชื่อ (ไม่นับผู้ถอน) may be tampered with by an attacker. This may lead to corruption of D5 คะแนน. Ensure the integrity of the data flow to the data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายชื่อ (ไม่นับผู้ถอน)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3a183061-e82a-4278-ac3d-b13f48ea57e9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T18</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R8b53f4936-2fd9-4b5a-961d-015067f3fd8e1527411a-43e9-4a09-9dfe-6ce2ac4d65b13a183061-e82a-4278-ac3d-b13f48ea57e9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>1527411a-43e9-4a09-9dfe-6ce2ac4d65b1</b:FlowGuid><b:Id>867</b:Id><b:InteractionKey>b53f4936-2fd9-4b5a-961d-015067f3fd8e:1527411a-43e9-4a09-9dfe-6ce2ac4d65b1:3a183061-e82a-4278-ac3d-b13f48ea57e9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Denies D5 คะแนน Potentially Writing Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D5 คะแนน claims that it did not write data received from an entity on the other side of the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายชื่อ (ไม่นับผู้ถอน)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3a183061-e82a-4278-ac3d-b13f48ea57e9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R8</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I6b53f4936-2fd9-4b5a-961d-015067f3fd8e1527411a-43e9-4a09-9dfe-6ce2ac4d65b13a183061-e82a-4278-ac3d-b13f48ea57e9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>1527411a-43e9-4a09-9dfe-6ce2ac4d65b1</b:FlowGuid><b:Id>868</b:Id><b:InteractionKey>b53f4936-2fd9-4b5a-961d-015067f3fd8e:1527411a-43e9-4a09-9dfe-6ce2ac4d65b1:3a183061-e82a-4278-ac3d-b13f48ea57e9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across รายชื่อ (ไม่นับผู้ถอน) may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายชื่อ (ไม่นับผู้ถอน)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3a183061-e82a-4278-ac3d-b13f48ea57e9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4b53f4936-2fd9-4b5a-961d-015067f3fd8e1527411a-43e9-4a09-9dfe-6ce2ac4d65b13a183061-e82a-4278-ac3d-b13f48ea57e9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>1527411a-43e9-4a09-9dfe-6ce2ac4d65b1</b:FlowGuid><b:Id>869</b:Id><b:InteractionKey>b53f4936-2fd9-4b5a-961d-015067f3fd8e:1527411a-43e9-4a09-9dfe-6ce2ac4d65b1:3a183061-e82a-4278-ac3d-b13f48ea57e9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow รายชื่อ (ไม่นับผู้ถอน) Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายชื่อ (ไม่นับผู้ถอน)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3a183061-e82a-4278-ac3d-b13f48ea57e9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D5b53f4936-2fd9-4b5a-961d-015067f3fd8e1527411a-43e9-4a09-9dfe-6ce2ac4d65b13a183061-e82a-4278-ac3d-b13f48ea57e9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>1527411a-43e9-4a09-9dfe-6ce2ac4d65b1</b:FlowGuid><b:Id>870</b:Id><b:InteractionKey>b53f4936-2fd9-4b5a-961d-015067f3fd8e:1527411a-43e9-4a09-9dfe-6ce2ac4d65b1:3a183061-e82a-4278-ac3d-b13f48ea57e9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Inaccessible</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent prevents access to a data store on the other side of the trust boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายชื่อ (ไม่นับผู้ถอน)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3a183061-e82a-4278-ac3d-b13f48ea57e9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S1b53f4936-2fd9-4b5a-961d-015067f3fd8e102f77d2-90dd-4bde-b8cf-38d1b92ae03a782935bb-a69c-4a0c-a166-daf122d94e1c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>102f77d2-90dd-4bde-b8cf-38d1b92ae03a</b:FlowGuid><b:Id>871</b:Id><b:InteractionKey>b53f4936-2fd9-4b5a-961d-015067f3fd8e:102f77d2-90dd-4bde-b8cf-38d1b92ae03a:782935bb-a69c-4a0c-a166-daf122d94e1c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the 6.1 ประเมินผล CLO และติดตามนักศึกษา Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>6.1 ประเมินผล CLO และติดตามนักศึกษา may be spoofed by an attacker and this may lead to unauthorized access to D2 รายวิชา. Consider using a standard authentication mechanism to identify the source process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอวิธีตัดเกรด</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>782935bb-a69c-4a0c-a166-daf122d94e1c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T18b53f4936-2fd9-4b5a-961d-015067f3fd8e102f77d2-90dd-4bde-b8cf-38d1b92ae03a782935bb-a69c-4a0c-a166-daf122d94e1c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>102f77d2-90dd-4bde-b8cf-38d1b92ae03a</b:FlowGuid><b:Id>872</b:Id><b:InteractionKey>b53f4936-2fd9-4b5a-961d-015067f3fd8e:102f77d2-90dd-4bde-b8cf-38d1b92ae03a:782935bb-a69c-4a0c-a166-daf122d94e1c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>The D2 รายวิชา Data Store Could Be Corrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across คำขอวิธีตัดเกรด may be tampered with by an attacker. This may lead to corruption of D2 รายวิชา. Ensure the integrity of the data flow to the data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอวิธีตัดเกรด</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>782935bb-a69c-4a0c-a166-daf122d94e1c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T18</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R8b53f4936-2fd9-4b5a-961d-015067f3fd8e102f77d2-90dd-4bde-b8cf-38d1b92ae03a782935bb-a69c-4a0c-a166-daf122d94e1c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>102f77d2-90dd-4bde-b8cf-38d1b92ae03a</b:FlowGuid><b:Id>873</b:Id><b:InteractionKey>b53f4936-2fd9-4b5a-961d-015067f3fd8e:102f77d2-90dd-4bde-b8cf-38d1b92ae03a:782935bb-a69c-4a0c-a166-daf122d94e1c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Denies D2 รายวิชา Potentially Writing Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D2 รายวิชา claims that it did not write data received from an entity on the other side of the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอวิธีตัดเกรด</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>782935bb-a69c-4a0c-a166-daf122d94e1c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R8</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I6b53f4936-2fd9-4b5a-961d-015067f3fd8e102f77d2-90dd-4bde-b8cf-38d1b92ae03a782935bb-a69c-4a0c-a166-daf122d94e1c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>102f77d2-90dd-4bde-b8cf-38d1b92ae03a</b:FlowGuid><b:Id>874</b:Id><b:InteractionKey>b53f4936-2fd9-4b5a-961d-015067f3fd8e:102f77d2-90dd-4bde-b8cf-38d1b92ae03a:782935bb-a69c-4a0c-a166-daf122d94e1c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across คำขอวิธีตัดเกรด may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอวิธีตัดเกรด</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>782935bb-a69c-4a0c-a166-daf122d94e1c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4b53f4936-2fd9-4b5a-961d-015067f3fd8e102f77d2-90dd-4bde-b8cf-38d1b92ae03a782935bb-a69c-4a0c-a166-daf122d94e1c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>102f77d2-90dd-4bde-b8cf-38d1b92ae03a</b:FlowGuid><b:Id>875</b:Id><b:InteractionKey>b53f4936-2fd9-4b5a-961d-015067f3fd8e:102f77d2-90dd-4bde-b8cf-38d1b92ae03a:782935bb-a69c-4a0c-a166-daf122d94e1c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow คำขอวิธีตัดเกรด Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอวิธีตัดเกรด</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>782935bb-a69c-4a0c-a166-daf122d94e1c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D5b53f4936-2fd9-4b5a-961d-015067f3fd8e102f77d2-90dd-4bde-b8cf-38d1b92ae03a782935bb-a69c-4a0c-a166-daf122d94e1c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>102f77d2-90dd-4bde-b8cf-38d1b92ae03a</b:FlowGuid><b:Id>876</b:Id><b:InteractionKey>b53f4936-2fd9-4b5a-961d-015067f3fd8e:102f77d2-90dd-4bde-b8cf-38d1b92ae03a:782935bb-a69c-4a0c-a166-daf122d94e1c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Inaccessible</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent prevents access to a data store on the other side of the trust boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอวิธีตัดเกรด</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>782935bb-a69c-4a0c-a166-daf122d94e1c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S2782935bb-a69c-4a0c-a166-daf122d94e1c138a81c8-c421-42d9-a71e-eef03d3821b9b53f4936-2fd9-4b5a-961d-015067f3fd8e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>138a81c8-c421-42d9-a71e-eef03d3821b9</b:FlowGuid><b:Id>877</b:Id><b:InteractionKey>782935bb-a69c-4a0c-a166-daf122d94e1c:138a81c8-c421-42d9-a71e-eef03d3821b9:b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the 6.1 ประเมินผล CLO และติดตามนักศึกษา Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>6.1 ประเมินผล CLO และติดตามนักศึกษา may be spoofed by an attacker and this may lead to information disclosure by D2 รายวิชา. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>วิธีตัดเกรด</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>782935bb-a69c-4a0c-a166-daf122d94e1c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R6782935bb-a69c-4a0c-a166-daf122d94e1c138a81c8-c421-42d9-a71e-eef03d3821b9b53f4936-2fd9-4b5a-961d-015067f3fd8e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>138a81c8-c421-42d9-a71e-eef03d3821b9</b:FlowGuid><b:Id>878</b:Id><b:InteractionKey>782935bb-a69c-4a0c-a166-daf122d94e1c:138a81c8-c421-42d9-a71e-eef03d3821b9:b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by 6.1 ประเมินผล CLO และติดตามนักศึกษา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>6.1 ประเมินผล CLO และติดตามนักศึกษา claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>วิธีตัดเกรด</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>782935bb-a69c-4a0c-a166-daf122d94e1c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D3782935bb-a69c-4a0c-a166-daf122d94e1c138a81c8-c421-42d9-a71e-eef03d3821b9b53f4936-2fd9-4b5a-961d-015067f3fd8e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>138a81c8-c421-42d9-a71e-eef03d3821b9</b:FlowGuid><b:Id>879</b:Id><b:InteractionKey>782935bb-a69c-4a0c-a166-daf122d94e1c:138a81c8-c421-42d9-a71e-eef03d3821b9:b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for 6.1 ประเมินผล CLO และติดตามนักศึกษา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>6.1 ประเมินผล CLO และติดตามนักศึกษา crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>วิธีตัดเกรด</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>782935bb-a69c-4a0c-a166-daf122d94e1c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4782935bb-a69c-4a0c-a166-daf122d9