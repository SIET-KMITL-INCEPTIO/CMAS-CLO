Guid>d27e3d6e-466b-41e6-b9f7-1a81d7fae93b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f5955920-e121-4620-becd-c3deca036284</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E7d27e3d6e-466b-41e6-b9f7-1a81d7fae93bbbbfdb12-5d4e-45fb-8209-2c7eccfca08ef5955920-e121-4620-becd-c3deca036284</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>bbbfdb12-5d4e-45fb-8209-2c7eccfca08e</b:FlowGuid><b:Id>610</b:Id><b:InteractionKey>d27e3d6e-466b-41e6-b9f7-1a81d7fae93b:bbbfdb12-5d4e-45fb-8209-2c7eccfca08e:f5955920-e121-4620-becd-c3deca036284</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in 6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into 6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด in order to change the flow of program execution within 6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ช่วงเกรด เกรดที่มีอยู่</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>d27e3d6e-466b-41e6-b9f7-1a81d7fae93b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f5955920-e121-4620-becd-c3deca036284</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S8fa2e0525-17fd-47e8-8a55-efdca2f2acb59979f36f-7414-42f5-a7ec-1465e13bba7c6a3f0d57-9c2b-452b-9b47-8ea337a13250</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>9979f36f-7414-42f5-a7ec-1465e13bba7c</b:FlowGuid><b:Id>611</b:Id><b:InteractionKey>fa2e0525-17fd-47e8-8a55-efdca2f2acb5:9979f36f-7414-42f5-a7ec-1465e13bba7c:6a3f0d57-9c2b-452b-9b47-8ea337a13250</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of the Google บริการยืนยันตัวตน External Destination Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Google บริการยืนยันตัวตน may be spoofed by an attacker and this may lead to data being sent to the attacker's target instead of Google บริการยืนยันตัวตน. Consider using a standard authentication mechanism to identify the external entity.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอยืนยันตัวตน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6a3f0d57-9c2b-452b-9b47-8ea337a13250</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S8</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R7fa2e0525-17fd-47e8-8a55-efdca2f2acb59979f36f-7414-42f5-a7ec-1465e13bba7c6a3f0d57-9c2b-452b-9b47-8ea337a13250</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>9979f36f-7414-42f5-a7ec-1465e13bba7c</b:FlowGuid><b:Id>612</b:Id><b:InteractionKey>fa2e0525-17fd-47e8-8a55-efdca2f2acb5:9979f36f-7414-42f5-a7ec-1465e13bba7c:6a3f0d57-9c2b-452b-9b47-8ea337a13250</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>External Entity Google บริการยืนยันตัวตน Potentially Denies Receiving Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Google บริการยืนยันตัวตน claims that it did not receive data from a process on the other side of the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอยืนยันตัวตน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6a3f0d57-9c2b-452b-9b47-8ea337a13250</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4fa2e0525-17fd-47e8-8a55-efdca2f2acb59979f36f-7414-42f5-a7ec-1465e13bba7c6a3f0d57-9c2b-452b-9b47-8ea337a13250</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>9979f36f-7414-42f5-a7ec-1465e13bba7c</b:FlowGuid><b:Id>613</b:Id><b:InteractionKey>fa2e0525-17fd-47e8-8a55-efdca2f2acb5:9979f36f-7414-42f5-a7ec-1465e13bba7c:6a3f0d57-9c2b-452b-9b47-8ea337a13250</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow คำขอยืนยันตัวตน Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอยืนยันตัวตน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6a3f0d57-9c2b-452b-9b47-8ea337a13250</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S26a3f0d57-9c2b-452b-9b47-8ea337a13250fca09af9-be69-45d0-9d59-2ca1d318b0d3fa2e0525-17fd-47e8-8a55-efdca2f2acb5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>fca09af9-be69-45d0-9d59-2ca1d318b0d3</b:FlowGuid><b:Id>614</b:Id><b:InteractionKey>6a3f0d57-9c2b-452b-9b47-8ea337a13250:fca09af9-be69-45d0-9d59-2ca1d318b0d3:fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the 1.0 เข้าสู่ระบบและดูแลบัญชี Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>1.0 เข้าสู่ระบบและดูแลบัญชี may be spoofed by an attacker and this may lead to information disclosure by Google บริการยืนยันตัวตน. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ผลยืนยันตัวตน (อีเมล ชื่อ)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6a3f0d57-9c2b-452b-9b47-8ea337a13250</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T16a3f0d57-9c2b-452b-9b47-8ea337a13250fca09af9-be69-45d0-9d59-2ca1d318b0d3fa2e0525-17fd-47e8-8a55-efdca2f2acb5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>fca09af9-be69-45d0-9d59-2ca1d318b0d3</b:FlowGuid><b:Id>615</b:Id><b:InteractionKey>6a3f0d57-9c2b-452b-9b47-8ea337a13250:fca09af9-be69-45d0-9d59-2ca1d318b0d3:fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Lack of Input Validation for 1.0 เข้าสู่ระบบและดูแลบัญชี</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across ผลยืนยันตัวตน (อีเมล ชื่อ) may be tampered with by an attacker. This may lead to a denial of service attack against 1.0 เข้าสู่ระบบและดูแลบัญชี or an elevation of privilege attack against 1.0 เข้าสู่ระบบและดูแลบัญชี or an information disclosure by 1.0 เข้าสู่ระบบและดูแลบัญชี. Failure to verify that input is as expected is a root cause of a very large number of exploitable issues. Consider all paths and the way they handle data. Verify that all input is verified for correctness using an approved list input validation approach.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ผลยืนยันตัวตน (อีเมล ชื่อ)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6a3f0d57-9c2b-452b-9b47-8ea337a13250</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R66a3f0d57-9c2b-452b-9b47-8ea337a13250fca09af9-be69-45d0-9d59-2ca1d318b0d3fa2e0525-17fd-47e8-8a55-efdca2f2acb5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>fca09af9-be69-45d0-9d59-2ca1d318b0d3</b:FlowGuid><b:Id>616</b:Id><b:InteractionKey>6a3f0d57-9c2b-452b-9b47-8ea337a13250:fca09af9-be69-45d0-9d59-2ca1d318b0d3:fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by 1.0 เข้าสู่ระบบและดูแลบัญชี</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>1.0 เข้าสู่ระบบและดูแลบัญชี claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ผลยืนยันตัวตน (อีเมล ชื่อ)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6a3f0d57-9c2b-452b-9b47-8ea337a13250</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I66a3f0d57-9c2b-452b-9b47-8ea337a13250fca09af9-be69-45d0-9d59-2ca1d318b0d3fa2e0525-17fd-47e8-8a55-efdca2f2acb5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>fca09af9-be69-45d0-9d59-2ca1d318b0d3</b:FlowGuid><b:Id>617</b:Id><b:InteractionKey>6a3f0d57-9c2b-452b-9b47-8ea337a13250:fca09af9-be69-45d0-9d59-2ca1d318b0d3:fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across ผลยืนยันตัวตน (อีเมล ชื่อ) may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ผลยืนยันตัวตน (อีเมล ชื่อ)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6a3f0d57-9c2b-452b-9b47-8ea337a13250</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D36a3f0d57-9c2b-452b-9b47-8ea337a13250fca09af9-be69-45d0-9d59-2ca1d318b0d3fa2e0525-17fd-47e8-8a55-efdca2f2acb5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>fca09af9-be69-45d0-9d59-2ca1d318b0d3</b:FlowGuid><b:Id>618</b:Id><b:InteractionKey>6a3f0d57-9c2b-452b-9b47-8ea337a13250:fca09af9-be69-45d0-9d59-2ca1d318b0d3:fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for 1.0 เข้าสู่ระบบและดูแลบัญชี</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>1.0 เข้าสู่ระบบและดูแลบัญชี crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ผลยืนยันตัวตน (อีเมล ชื่อ)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6a3f0d57-9c2b-452b-9b47-8ea337a13250</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D46a3f0d57-9c2b-452b-9b47-8ea337a13250fca09af9-be69-45d0-9d59-2ca1d318b0d3fa2e0525-17fd-47e8-8a55-efdca2f2acb5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>fca09af9-be69-45d0-9d59-2ca1d318b0d3</b:FlowGuid><b:Id>619</b:Id><b:InteractionKey>6a3f0d57-9c2b-452b-9b47-8ea337a13250:fca09af9-be69-45d0-9d59-2ca1d318b0d3:fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow ผลยืนยันตัวตน (อีเมล ชื่อ) Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ผลยืนยันตัวตน (อีเมล ชื่อ)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6a3f0d57-9c2b-452b-9b47-8ea337a13250</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E66a3f0d57-9c2b-452b-9b47-8ea337a13250fca09af9-be69-45d0-9d59-2ca1d318b0d3fa2e0525-17fd-47e8-8a55-efdca2f2acb5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>fca09af9-be69-45d0-9d59-2ca1d318b0d3</b:FlowGuid><b:Id>620</b:Id><b:InteractionKey>6a3f0d57-9c2b-452b-9b47-8ea337a13250:fca09af9-be69-45d0-9d59-2ca1d318b0d3:fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>1.0 เข้าสู่ระบบและดูแลบัญชี May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Google บริการยืนยันตัวตน may be able to remotely execute code for 1.0 เข้าสู่ระบบและดูแลบัญชี.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ผลยืนยันตัวตน (อีเมล ชื่อ)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6a3f0d57-9c2b-452b-9b47-8ea337a13250</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E76a3f0d57-9c2b-452b-9b47-8ea337a13250fca09af9-be69-45d0-9d59-2ca1d318b0d3fa2e0525-17fd-47e8-8a55-efdca2f2acb5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>fca09af9-be69-45d0-9d59-2ca1d318b0d3</b:FlowGuid><b:Id>621</b:Id><b:InteractionKey>6a3f0d57-9c2b-452b-9b47-8ea337a13250:fca09af9-be69-45d0-9d59-2ca1d318b0d3:fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in 1.0 เข้าสู่ระบบและดูแลบัญชี</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into 1.0 เข้าสู่ระบบและดูแลบัญชี in order to change the flow of program execution within 1.0 เข้าสู่ระบบและดูแลบัญชี to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ผลยืนยันตัวตน (อีเมล ชื่อ)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6a3f0d57-9c2b-452b-9b47-8ea337a13250</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S255aa40c0-7498-452a-b45b-52f39cf002c57e3cc16e-58cc-41fa-acfd-ffb3ed8d266ffa2e0525-17fd-47e8-8a55-efdca2f2acb5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>7e3cc16e-58cc-41fa-acfd-ffb3ed8d266f</b:FlowGuid><b:Id>622</b:Id><b:InteractionKey>55aa40c0-7498-452a-b45b-52f39cf002c5:7e3cc16e-58cc-41fa-acfd-ffb3ed8d266f:fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the 1.0 เข้าสู่ระบบและดูแลบัญชี Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>1.0 เข้าสู่ระบบและดูแลบัญชี may be spoofed by an attacker and this may lead to information disclosure by ผู้ดูแลระบบ. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอเข้าสู่ระบบ การอนุมัติและปิดบัญชี</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>55aa40c0-7498-452a-b45b-52f39cf002c5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T155aa40c0-7498-452a-b45b-52f39cf002c57e3cc16e-58cc-41fa-acfd-ffb3ed8d266ffa2e0525-17fd-47e8-8a55-efdca2f2acb5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>7e3cc16e-58cc-41fa-acfd-ffb3ed8d266f</b:FlowGuid><b:Id>623</b:Id><b:InteractionKey>55aa40c0-7498-452a-b45b-52f39cf002c5:7e3cc16e-58cc-41fa-acfd-ffb3ed8d266f:fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Lack of Input Validation for 1.0 เข้าสู่ระบบและดูแลบัญชี</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across คำขอเข้าสู่ระบบ การอนุมัติและปิดบัญชี may be tampered with by an attacker. This may lead to a denial of service attack against 1.0 เข้าสู่ระบบและดูแลบัญชี or an elevation of privilege attack against 1.0 เข้าสู่ระบบและดูแลบัญชี or an information disclosure by 1.0 เข้าสู่ระบบและดูแลบัญชี. Failure to verify that input is as expected is a root cause of a very large number of exploitable issues. Consider all paths and the way they handle data. Verify that all input is verified for correctness using an approved list input validation approach.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอเข้าสู่ระบบ การอนุมัติและปิดบัญชี</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>55aa40c0-7498-452a-b45b-52f39cf002c5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R655aa40c0-7498-452a-b45b-52f39cf002c57e3cc16e-58cc-41fa-acfd-ffb3ed8d266ffa2e0525-17fd-47e8-8a55-efdca2f2acb5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>7e3cc16e-58cc-41fa-acfd-ffb3ed8d266f</b:FlowGuid><b:Id>624</b:Id><b:InteractionKey>55aa40c0-7498-452a-b45b-52f39cf002c5:7e3cc16e-58cc-41fa-acfd-ffb3ed8d266f:fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by 1.0 เข้าสู่ระบบและดูแลบัญชี</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>1.0 เข้าสู่ระบบและดูแลบัญชี claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอเข้าสู่ระบบ การอนุมัติและปิดบัญชี</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>55aa40c0-7498-452a-b45b-52f39cf002c5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I655aa40c0-7498-452a-b45b-52f39cf002c57e3cc16e-58cc-41fa-acfd-ffb3ed8d266ffa2e0525-17fd-47e8-8a55-efdca2f2acb5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>7e3cc16e-58cc-41fa-acfd-ffb3ed8d266f</b:FlowGuid><b:Id>625</b:Id><b:InteractionKey>55aa40c0-7498-452a-b45b-52f39cf002c5:7e3cc16e-58cc-41fa-acfd-ffb3ed8d266f:fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across คำขอเข้าสู่ระบบ การอนุมัติและปิดบัญชี may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอเข้าสู่ระบบ การอนุมัติและปิดบัญชี</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>55aa40c0-7498-452a-b45b-52f39cf002c5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D355aa40c0-7498-452a-b45b-52f39cf002c57e3cc16e-58cc-41fa-acfd-ffb3ed8d266ffa2e0525-17fd-47e8-8a55-efdca2f2acb5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>7e3cc16e-58cc-41fa-acfd-ffb3ed8d266f</b:FlowGuid><b:Id>626</b:Id><b:InteractionKey>55aa40c0-7498-452a-b45b-52f39cf002c5:7e3cc16e-58cc-41fa-acfd-ffb3ed8d266f:fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for 1.0 เข้าสู่ระบบและดูแลบัญชี</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>1.0 เข้าสู่ระบบและดูแลบัญชี crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอเข้าสู่ระบบ การอนุมัติและปิดบัญชี</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>55aa40c0-7498-452a-b45b-52f39cf002c5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D455aa40c0-7498-452a-b45b-52f39cf002c57e3cc16e-58cc-41fa-acfd-ffb3ed8d266ffa2e0525-17fd-47e8-8a55-efdca2f2acb5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>7e3cc16e-58cc-41fa-acfd-ffb3ed8d266f</b:FlowGuid><b:Id>627</b:Id><b:InteractionKey>55aa40c0-7498-452a-b45b-52f39cf002c5:7e3cc16e-58cc-41fa-acfd-ffb3ed8d266f:fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow คำขอเข้าสู่ระบบ การอนุมัติและปิดบัญชี Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอเข้าสู่ระบบ การอนุมัติและปิดบัญชี</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>55aa40c0-7498-452a-b45b-52f39cf002c5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E655aa40c0-7498-452a-b45b-52f39cf002c57e3cc16e-58cc-41fa-acfd-ffb3ed8d266ffa2e0525-17fd-47e8-8a55-efdca2f2acb5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>7e3cc16e-58cc-41fa-acfd-ffb3ed8d266f</b:FlowGuid><b:Id>628</b:Id><b:InteractionKey>55aa40c0-7498-452a-b45b-52f39cf002c5:7e3cc16e-58cc-41fa-acfd-ffb3ed8d266f:fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>1.0 เข้าสู่ระบบและดูแลบัญชี May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้ดูแลระบบ may be able to remotely execute code for 1.0 เข้าสู่ระบบและดูแลบัญชี.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอเข้าสู่ระบบ การอนุมัติและปิดบัญชี</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>55aa40c0-7498-452a-b45b-52f39cf002c5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E755aa40c0-7498-452a-b45b-52f39cf002c57e3cc16e-58cc-41fa-acfd-ffb3ed8d266ffa2e0525-17fd-47e8-8a55-efdca2f2acb5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>7e3cc16e-58cc-41fa-acfd-ffb3ed8d266f</b:FlowGuid><b:Id>629</b:Id><b:InteractionKey>55aa40c0-7498-452a-b45b-52f39cf002c5:7e3cc16e-58cc-41fa-acfd-ffb3ed8d266f:fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in 1.0 เข้าสู่ระบบและดูแลบัญชี</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into 1.0 เข้าสู่ระบบและดูแลบัญชี in order to change the flow of program execution within 1.0 เข้าสู่ระบบและดูแลบัญชี to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอเข้าสู่ระบบ การอนุมัติและปิดบัญชี</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>55aa40c0-7498-452a-b45b-52f39cf002c5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>8404dcf5-bdd8-4902-abc2-3b6c967b026155aa40c0-7498-452a-b45b-52f39cf002c57e3cc16e-58cc-41fa-acfd-ffb3ed8d266ffa2e0525-17fd-47e8-8a55-efdca2f2acb5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>7e3cc16e-58cc-41fa-acfd-ffb3ed8d266f</b:FlowGuid><b:Id>630</b:Id><b:InteractionKey>55aa40c0-7498-452a-b45b-52f39cf002c5:7e3cc16e-58cc-41fa-acfd-ffb3ed8d266f:fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cross Site Request Forgery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Cross-site request forgery (CSRF or XSRF) is a type of attack in which an attacker forces a user's browser to make a forged request to a vulnerable site by exploiting an existing trust relationship between the browser and the vulnerable web site.  In a simple scenario, a user is logged in to web site A using a cookie as a credential.  The other browses to web site B.  Web site B returns a page with a hidden form that posts to web site A.  Since the browser will carry the user's cookie to web site A, web site B now can take any action on web site A, for example, adding an admin to an account.  The attack can be used to exploit any requests that the browser automatically authenticates, e.g. by session cookie, integrated authentication, IP whitelisting, …  The attack can be carried out in many ways such as by luring the victim to a site under control of the attacker, getting the user to click a link in a phishing email, or hacking a reputable web site that the victim will visit. The issue can only be resolved on the server side by requiring that all authenticated state-changing requests include an additional piece of secret payload (canary or CSRF token) which is known only to the legitimate web site and the browser and which is protected in transit through SSL/TLS. See the Forgery Protection property on the flow stencil for a list of mitigations.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอเข้าสู่ระบบ การอนุมัติและปิดบัญชี</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>55aa40c0-7498-452a-b45b-52f39cf002c5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>8404dcf5-bdd8-4902-abc2-3b6c967b0261</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S8fa2e0525-17fd-47e8-8a55-efdca2f2acb5a6b12ad5-59e9-44ab-82b2-58f7fcae3c8155aa40c0-7498-452a-b45b-52f39cf002c5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>a6b12ad5-59e9-44ab-82b2-58f7fcae3c81</b:FlowGuid><b:Id>631</b:Id><b:InteractionKey>fa2e0525-17fd-47e8-8a55-efdca2f2acb5:a6b12ad5-59e9-44ab-82b2-58f7fcae3c81:55aa40c0-7498-452a-b45b-52f39cf002c5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of the ผู้ดูแลระบบ External Destination Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้ดูแลระบบ may be spoofed by an attacker and this may lead to data being sent to the attacker's target instead of ผู้ดูแลระบบ. Consider using a standard authentication mechanism to identify the external entity.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายการบัญชี ประวัติการใช้งาน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>55aa40c0-7498-452a-b45b-52f39cf002c5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S8</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R7fa2e0525-17fd-47e8-8a55-efdca2f2acb5a6b12ad5-59e9-44ab-82b2-58f7fcae3c8155aa40c0-7498-452a-b45b-52f39cf002c5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>a6b12ad5-59e9-44ab-82b2-58f7fcae3c81</b:FlowGuid><b:Id>632</b:Id><b:InteractionKey>fa2e0525-17fd-47e8-8a55-efdca2f2acb5:a6b12ad5-59e9-44ab-82b2-58f7fcae3c81:55aa40c0-7498-452a-b45b-52f39cf002c5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>External Entity ผู้ดูแลระบบ Potentially Denies Receiving Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้ดูแลระบบ claims that it did not receive data from a process on the other side of the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายการบัญชี ประวัติการใช้งาน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>55aa40c0-7498-452a-b45b-52f39cf002c5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4fa2e0525-17fd-47e8-8a55-efdca2f2acb5a6b12ad5-59e9-44ab-82b2-58f7fcae3c8155aa40c0-7498-452a-b45b-52f39cf002c5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>a6b12ad5-59e9-44ab-82b2-58f7fcae3c81</b:FlowGuid><b:Id>633</b:Id><b:InteractionKey>fa2e0525-17fd-47e8-8a55-efdca2f2acb5:a6b12ad5-59e9-44ab-82b2-58f7fcae3c81:55aa40c0-7498-452a-b45b-52f39cf002c5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow รายการบัญชี ประวัติการใช้งาน Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายการบัญชี ประวัติการใช้งาน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>55aa40c0-7498-452a-b45b-52f39cf002c5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S2c6386458-3bb0-42ae-a01e-5cc88646a797b12594e8-04cf-4efd-a5e6-b421fc8f2022fa2e0525-17fd-47e8-8a55-efdca2f2acb5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>b12594e8-04cf-4efd-a5e6-b421fc8f2022</b:FlowGuid><b:Id>634</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:b12594e8-04cf-4efd-a5e6-b421fc8f2022:fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the 1.0 เข้าสู่ระบบและดูแลบัญชี Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>1.0 เข้าสู่ระบบและดูแลบัญชี may be spoofed by an attacker and this may lead to information disclosure by ผู้สอน. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอเข้าสู่ระบบ</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T1c6386458-3bb0-42ae-a01e-5cc88646a797b12594e8-04cf-4efd-a5e6-b421fc8f2022fa2e0525-17fd-47e8-8a55-efdca2f2acb5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>b12594e8-04cf-4efd-a5e6-b421fc8f2022</b:FlowGuid><b:Id>635</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:b12594e8-04cf-4efd-a5e6-b421fc8f2022:fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Lack of Input Validation for 1.0 เข้าสู่ระบบและดูแลบัญชี</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across คำขอเข้าสู่ระบบ may be tampered with by an attacker. This may lead to a denial of service attack against 1.0 เข้าสู่ระบบและดูแลบัญชี or an elevation of privilege attack against 1.0 เข้าสู่ระบบและดูแลบัญชี or an information disclosure by 1.0 เข้าสู่ระบบและดูแลบัญชี. Failure to verify that input is as expected is a root cause of a very large number of exploitable issues. Consider all paths and the way they handle data. Verify that all input is verified for correctness using an approved list input validation approach.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอเข้าสู่ระบบ</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R6c6386458-3bb0-42ae-a01e-5cc88646a797b12594e8-04cf-4efd-a5e6-b421fc8f2022fa2e0525-17fd-47e8-8a55-efdca2f2acb5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>b12594e8-04cf-4efd-a5e6-b421fc8f2022</b:FlowGuid><b:Id>636</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:b12594e8-04cf-4efd-a5e6-b421fc8f2022:fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by 1.0 เข้าสู่ระบบและดูแลบัญชี</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>1.0 เข้าสู่ระบบและดูแลบัญชี claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอเข้าสู่ระบบ</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I6c6386458-3bb0-42ae-a01e-5cc88646a797b12594e8-04cf-4efd-a5e6-b421fc8f2022fa2e0525-17fd-47e8-8a55-efdca2f2acb5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>b12594e8-04cf-4efd-a5e6-b421fc8f2022</b:FlowGuid><b:Id>637</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:b12594e8-04cf-4efd-a5e6-b421fc8f2022:fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across คำขอเข้าสู่ระบบ may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอเข้าสู่ระบบ</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D3c6386458-3bb0-42ae-a01e-5cc88646a797b12594e8-04cf-4efd-a5e6-b421fc8f2022fa2e0525-17fd-47e8-8a55-efdca2f2acb5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>b12594e8-04cf-4efd-a5e6-b421fc8f2022</b:FlowGuid><b:Id>638</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:b12594e8-04cf-4efd-a5e6-b421fc8f2022:fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for 1.0 เข้าสู่ระบบและดูแลบัญชี</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>1.0 เข้าสู่ระบบและดูแลบัญชี crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอเข้าสู่ระบบ</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4c6386458-3bb0-42ae-a01e-5cc88646a797b12594e8-04cf-4efd-a5e6-b421fc8f2022fa2e0525-17fd-47e8-8a55-efdca2f2acb5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>b12594e8-04cf-4efd-a5e6-b421fc8f2022</b:FlowGuid><b:Id>639</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:b12594e8-04cf-4efd-a5e6-b421fc8f2022:fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow คำขอเข้าสู่ระบบ Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอเข้าสู่ระบบ</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E6c6386458-3bb0-42ae-a01e-5cc88646a797b12594e8-04cf-4efd-a5e6-b421fc8f2022fa2e0525-17fd-47e8-8a55-efdca2f2acb5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>b12594e8-04cf-4efd-a5e6-b421fc8f2022</b:FlowGuid><b:Id>640</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:b12594e8-04cf-4efd-a5e6-b421fc8f2022:fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>1.0 เข้าสู่ระบบและดูแลบัญชี May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้สอน may be able to remotely execute code for 1.0 เข้าสู่ระบบและดูแลบัญชี.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอเข้าสู่ระบบ</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E7c6386458-3bb0-42ae-a01e-5cc88646a797b12594e8-04cf-4efd-a5e6-b421fc8f2022fa2e0525-17fd-47e8-8a55-efdca2f2acb5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>b12594e8-04cf-4efd-a5e6-b421fc8f2022</b:FlowGuid><b:Id>641</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:b12594e8-04cf-4efd-a5e6-b421fc8f2022:fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in 1.0 เข้าสู่ระบบและดูแลบัญชี</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into 1.0 เข้าสู่ระบบและดูแลบัญชี in order to change the flow of program execution within 1.0 เข้าสู่ระบบและดูแลบัญชี to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอเข้าสู่ระบบ</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>8404dcf5-bdd8-4902-abc2-3b6c967b0261c6386458-3bb0-42ae-a01e-5cc88646a797b12594e8-04cf-4efd-a5e6-b421fc8f2022fa2e0525-17fd-47e8-8a55-efdca2f2acb5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>b12594e8-04cf-4efd-a5e6-b421fc8f2022</b:FlowGuid><b:Id>642</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:b12594e8-04cf-4efd-a5e6-b421fc8f2022:fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cross Site Request Forgery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Cross-site request forgery (CSRF or XSRF) is a type of attack in which an attacker forces a user's browser to make a forged request to a vulnerable site by exploiting an existing trust relationship between the browser and the vulnerable web site.  In a simple scenario, a user is logged in to web site A using a cookie as a credential.  The other browses to web site B.  Web site B returns a page with a hidden form that posts to web site A.  Since the browser will carry the user's cookie to web site A, web site B now can take any action on web site A, for example, adding an admin to an account.  The attack can be used to exploit any requests that the browser automatically authenticates, e.g. by session cookie, integrated authentication, IP whitelisting, …  The attack can be carried out in many ways such as by luring the victim to a site under control of the attacker, getting the user to click a link in a phishing email, or hacking a reputable web site that the victim will visit. The issue can only be resolved on the server side by requiring that all authenticated state-changing requests include an additional piece of secret payload (canary or CSRF token) which is known only to the legitimate web site and the browser and which is protected in transit through SSL/TLS. See the Forgery Protection property on the flow stencil for a list of mitigations.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอเข้าสู่ระบบ</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>8404dcf5-bdd8-4902-abc2-3b6c967b0261</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S8fa2e0525-17fd-47e8-8a55-efdca2f2acb560aa0859-73ac-42ce-ae30-b9fcc4990387c6386458-3bb0-42ae-a01e-5cc88646a797</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>60aa0859-73ac-42ce-ae30-b9fcc4990387</b:FlowGuid><b:Id>643</b:Id><b:InteractionKey>fa2e0525-17fd-47e8-8a55-efdca2f2acb5:60aa0859-73ac-42ce-ae30-b9fcc4990387:c6386458-3bb0-42ae-a01e-5cc88646a797</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of the ผู้สอน External Destination Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้สอน may be spoofed by an attacker and this may lead to data being sent to the attacker's target instead of ผู้สอน. Consider using a standard authentication mechanism to identify the external entity.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ผลการเข้าสู่ระบบ</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S8</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R7fa2e0525-17fd-47e8-8a55-efdca2f2acb560aa0859-73ac-42ce-ae30-b9fcc4990387c6386458-3bb0-42ae-a01e-5cc88646a797</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>60aa0859-73ac-42ce-ae30-b9fcc4990387</b:FlowGuid><b:Id>644</b:Id><b:InteractionKey>fa2e0525-17fd-47e8-8a55-efdca2f2acb5:60aa0859-73ac-42ce-ae30-b9fcc4990387:c6386458-3bb0-42ae-a01e-5cc88646a797</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>External Entity ผู้สอน Potentially Denies Receiving Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้สอน claims that it did not receive data from a process on the other side of the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ผลการเข้าสู่ระบบ</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4fa2e0525-17fd-47e8-8a55-efdca2f2acb560aa0859-73ac-42ce-ae30-b9fcc4990387c6386458-3bb0-42ae-a01e-5cc88646a797</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>60aa0859-73ac-42ce-ae30-b9fcc4990387</b:FlowGuid><b:Id>645</b:Id><b:InteractionKey>fa2e0525-17fd-47e8-8a55-efdca2f2acb5:60aa0859-73ac-42ce-ae30-b9fcc4990387:c6386458-3bb0-42ae-a01e-5cc88646a797</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow ผลการเข้าสู่ระบบ Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ผลการเข้าสู่ระบบ</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S255aa40c0-7498-452a-b45b-52f39cf002c588b3fec4-bcc7-4388-86ae-6ddebb0292b1a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>88b3fec4-bcc7-4388-86ae-6ddebb0292b1</b:FlowGuid><b:Id>646</b:Id><b:InteractionKey>55aa40c0-7498-452a-b45b-52f39cf002c5:88b3fec4-bcc7-4388-86ae-6ddebb0292b1:a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the 2.0 จัดการรายวิชาและผู้สอน Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>2.0 จัดการรายวิชาและผู้สอน may be spoofed by an attacker and this may lead to information disclosure by ผู้ดูแลระบบ. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ข้อมูลรายวิชา · การตั้งค่า</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>55aa40c0-7498-452a-b45b-52f39cf002c5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T155aa40c0-7498-452a-b45b-52f39cf002c588b3fec4-bcc7-4388-86ae-6ddebb0292b1a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>88b3fec4-bcc7-4388-86ae-6ddebb0292b1</b:FlowGuid><b:Id>647</b:Id><b:InteractionKey>55aa40c0-7498-452a-b45b-52f39cf002c5:88b3fec4-bcc7-4388-86ae-6ddebb0292b1:a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Lack of Input Validation for 2.0 จัดการรายวิชาและผู้สอน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across ข้อมูลรายวิชา · การตั้งค่า may be tampered with by an attacker. This may lead to a denial of service attack against 2.0 จัดการรายวิชาและผู้สอน or an elevation of privilege attack against 2.0 จัดการรายวิชาและผู้สอน or an information disclosure by 2.0 จัดการรายวิชาและผู้สอน. Failure to verify that input is as expected is a root cause of a very large number of exploitable issues. Consider all paths and the way they handle data. Verify that all input is verified for correctness using an approved list input validation approach.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ข้อมูลรายวิชา · การตั้งค่า</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>55aa40c0-7498-452a-b45b-52f39cf002c5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R655aa40c0-7498-452a-b45b-52f39cf002c588b3fec4-bcc7-4388-86ae-6ddebb0292b1a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>88b3fec4-bcc7-4388-86ae-6ddebb0292b1</b:FlowGuid><b:Id>648</b:Id><b:InteractionKey>55aa40c0-7498-452a-b45b-52f39cf002c5:88b3fec4-bcc7-4388-86ae-6ddebb0292b1:a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by 2.0 จัดการรายวิชาและผู้สอน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>2.0 จัดการรายวิชาและผู้สอน claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ข้อมูลรายวิชา · การตั้งค่า</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>55aa40c0-7498-452a-b45b-52f39cf002c5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I655aa40c0-7498-452a-b45b-52f39cf002c588b3fec4-bcc7-4388-86ae-6ddebb0292b1a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>88b3fec4-bcc7-4388-86ae-6ddebb0292b1</b:FlowGuid><b:Id>649</b:Id><b:InteractionKey>55aa40c0-7498-452a-b45b-52f39cf002c5:88b3fec4-bcc7-4388-86ae-6ddebb0292b1:a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across ข้อมูลรายวิชา · การตั้งค่า may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ข้อมูลรายวิชา · การตั้งค่า</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>55aa40c0-7498-452a-b45b-52f39cf002c5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D355aa40c0-7498-452a-b45b-52f39cf002c588b3fec4-bcc7-4388-86ae-6ddebb0292b1a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>88b3fec4-bcc7-4388-86ae-6ddebb0292b1</b:FlowGuid><b:Id>650</b:Id><b:InteractionKey>55aa40c0-7498-452a-b45b-52f39cf002c5:88b3fec4-bcc7-4388-86ae-6ddebb0292b1:a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for 2.0 จัดการรายวิชาและผู้สอน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>2.0 จัดการรายวิชาและผู้สอน crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ข้อมูลรายวิชา · การตั้งค่า</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>55aa40c0-7498-452a-b45b-52f39cf002c5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D455aa40c0-7498-452a-b45b-52f39cf002c588b3fec4-bcc7-4388-86ae-6ddebb0292b1a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>88b3fec4-bcc7-4388-86ae-6ddebb0292b1</b:FlowGuid><b:Id>651</b:Id><b:InteractionKey>55aa40c0-7498-452a-b45b-52f39cf002c5:88b3fec4-bcc7-4388-86ae-6ddebb0292b1:a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow ข้อมูลรายวิชา · การตั้งค่า Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ข้อมูลรายวิชา · การตั้งค่า</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>55aa40c0-7498-452a-b45b-52f39cf002c5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E655aa40c0-7498-452a-b45b-52f39cf002c588b3fec4-bcc7-4388-86ae-6ddebb0292b1a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>88b3fec4-bcc7-4388-86ae-6ddebb0292b1</b:FlowGuid><b:Id>652</b:Id><b:InteractionKey>55aa40c0-7498-452a-b45b-52f39cf002c5:88b3fec4-bcc7-4388-86ae-6ddebb0292b1:a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>2.0 จัดการรายวิชาและผู้สอน May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้ดูแลระบบ may be able to remotely execute code for 2.0 จัดการรายวิชาและผู้สอน.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ข้อมูลรายวิชา · การตั้งค่า</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>55aa40c0-7498-452a-b45b-52f39cf002c5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E755aa40c0-7498-452a-b45b-52f39cf002c588b3fec4-bcc7-4388-86ae-6ddebb0292b1a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>88b3fec4-bcc7-4388-86ae-6ddebb0292b1</b:FlowGuid><b:Id>653</b:Id><b:InteractionKey>55aa40c0-7498-452a-b45b-52f39cf002c5:88b3fec4-bcc7-4388-86ae-6ddebb0292b1:a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in 2.0 จัดการรายวิชาและผู้สอน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into 2.0 จัดการรายวิชาและผู้สอน in order to change the flow of program execution within 2.0 จัดการรายวิชาและผู้สอน to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ข้อมูลรายวิชา · การตั้งค่า</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>55aa40c0-7498-452a-b45b-52f39cf002c5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>8404dcf5-bdd8-4902-abc2-3b6c967b026155aa40c0-7498-452a-b45b-52f39cf002c588b3fec4-bcc7-4388-86ae-6ddebb0292b1a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>88b3fec4-bcc7-4388-86ae-6ddebb0292b1</b:FlowGuid><b:Id>654</b:Id><b:InteractionKey>55aa40c0-7498-452a-b45b-52f39cf002c5:88b3fec4-bcc7-4388-86ae-6ddebb0292b1:a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cross Site Request Forgery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Cross-site request forgery (CSRF or XSRF) is a type of attack in which an attacker forces a user's browser to make a forged request to a vulnerable site by exploiting an existing trust relationship between the browser and the vulnerable web site.  In a simple scenario, a user is logged in to web site A using a cookie as a credential.  The other browses to web site B.  Web site B returns a page with a hidden form that posts to web site A.  Since the browser will carry the user's cookie to web site A, web site B now can take any action on web site A, for example, adding an admin to an account.  The attack can be used to exploit any requests that the browser automatically authenticates, e.g. by session cookie, integrated authentication, IP whitelisting, …  The attack can be carried out in many ways such as by luring the victim to a site under control of the attacker, getting the user to click a link in a phishing email, or hacking a reputable web site that the victim will visit. The issue can only be resolved on the server side by requiring that all authenticated state-changing requests include an additional piece of secret payload (canary or CSRF token) which is known only to the legitimate web site and the browser and which is protected in transit through SSL/TLS. See the Forgery Protection property on the flow stencil for a list of mitigations.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ข้อมูลรายวิชา · การตั้งค่า</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>55aa40c0-7498-452a-b45b-52f39cf002c5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>8404dcf5-bdd8-4902-abc2-3b6c967b0261</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S2c6386458-3bb0-42ae-a01e-5cc88646a797f329d5d2-0f77-4947-8a34-fd9062682e09a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>f329d5d2-0f77-4947-8a34-fd9062682e09</b:FlowGuid><b:Id>655</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:f329d5d2-0f77-4947-8a34-fd9062682e09:a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the 2.0 จัดการรายวิชาและผู้สอน Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>2.0 จัดการรายวิชาและผู้สอน may be spoofed by an attacker and this may lead to information disclosure by ผู้สอน. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายการรายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T1c6386458-3bb0-42ae-a01e-5cc88646a797f329d5d2-0f77-4947-8a34-fd9062682e09a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>f329d5d2-0f77-4947-8a34-fd9062682e09</b:FlowGuid><b:Id>656</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:f329d5d2-0f77-4947-8a34-fd9062682e09:a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Lack of Input Validation for 2.0 จัดการรายวิชาและผู้สอน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across รายการรายวิชา may be tampered with by an attacker. This may lead to a denial of service attack against 2.0 จัดการรายวิชาและผู้สอน or an elevation of privilege attack against 2.0 จัดการรายวิชาและผู้สอน or an information disclosure by 2.0 จัดการรายวิชาและผู้สอน. Failure to verify that input is as expected is a root cause of a very large number of exploitable issues. Consider all paths and the way they handle data. Verify that all input is verified for correctness using an approved list input validation approach.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายการรายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R6c6386458-3bb0-42ae-a01e-5cc88646a797f329d5d2-0f77-4947-8a34-fd9062682e09a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>f329d5d2-0f77-4947-8a34-fd9062682e09</b:FlowGuid><b:Id>657</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:f329d5d2-0f77-4947-8a34-fd9062682e09:a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by 2.0 จัดการรายวิชาและผู้สอน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>2.0 จัดการรายวิชาและผู้สอน claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายการรายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I6c6386458-3bb0-42ae-a01e-5cc88646a797f329d5d2-0f77-4947-8a34-fd9062682e09a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>f329d5d2-0f77-4947-8a34-fd9062682e09</b:FlowGuid><b:Id>658</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:f329d5d2-0f77-4947-8a34-fd9062682e09:a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across รายการรายวิชา may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายการรายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D3c6386458-3bb0-42ae-a01e-5cc88646a797f329d5d2-0f77-4947-8a34-fd9062682e09a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>f329d5d2-0f77-4947-8a34-fd9062682e09</b:FlowGuid><b:Id>659</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:f329d5d2-0f77-4947-8a34-fd9062682e09:a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for 2.0 จัดการรายวิชาและผู้สอน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>2.0 จัดการรายวิชาและผู้สอน crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายการรายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4c6386458-3bb0-42ae-a01e-5cc88646a797f329d5d2-0f77-4947-8a34-fd9062682e09a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>f329d5d2-0f77-4947-8a34-fd9062682e09</b:FlowGuid><b:Id>660</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:f329d5d2-0f77-4947-8a34-fd9062682e09:a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow รายการรายวิชา Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายการรายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E6c6386458-3bb0-42ae-a01e-5cc88646a797f329d5d2-0f77-4947-8a34-fd9062682e09a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>f329d5d2-0f77-4947-8a34-fd9062682e09</b:FlowGuid><b:Id>661</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:f329d5d2-0f77-4947-8a34-fd9062682e09:a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>2.0 จัดการรายวิชาและผู้สอน May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้สอน may be able to remotely execute code for 2.0 จัดการรายวิชาและผู้สอน.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายการรายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E7c6386458-3bb0-42ae-a01e-5cc88646a797f329d5d2-0f77-4947-8a34-fd9062682e09a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>f329d5d2-0f77-4947-8a34-fd9062682e09</b:FlowGuid><b:Id>662</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:f329d5d2-0f77-4947-8a34-fd9062682e09:a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in 2.0 จัดการรายวิชาและผู้สอน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into 2.0 จัดการรายวิชาและผู้สอน in order to change the flow of program execution within 2.0 จัดการรายวิชาและผู้สอน to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายการรายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>8404dcf5-bdd8-4902-abc2-3b6c967b0261c6386458-3bb0-42ae-a01e-5cc88646a797f329d5d2-0f77-4947-8a34-fd9062682e09a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>f329d5d2-0f77-4947-8a34-fd9062682e09</b:FlowGuid><b:Id>663</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:f329d5d2-0f77-4947-8a34-fd9062682e09:a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cross Site Request Forgery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Cross-site request forgery (CSRF or XSRF) is a type of attack in which an attacker forces a user's browser to make a forged request to a vulnerable site by exploiting an existing trust relationship between the browser and the vulnerable web site.  In a simple scenario, a user is logged in to web site A using a cookie as a credential.  The other browses to web site B.  Web site B returns a page with a hidden form that posts to web site A.  Since the browser will carry the user's cookie to web site A, web site B now can take any action on web site A, for example, adding an admin to an account.  The attack can be used to exploit any requests that the browser automatically authenticates, e.g. by session cookie, integrated authentication, IP whitelisting, …  The attack can be carried out in many ways such as by luring the victim to a site under control of the attacker, getting the user to click a link in a phishing email, or hacking a reputable web site that the victim will visit. The issue can only be resolved on the server side by requiring that all authenticated state-changing requests include an additional piece of secret payload (canary or CSRF token) which is known only to the legitimate web site and the browser and which is protected in transit through SSL/TLS. See the Forgery Protection property on the flow stencil for a list of mitigations.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายการรายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>8404dcf5-bdd8-4902-abc2-3b6c967b0261</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S8a9c3bd3a-15ff-4b60-83c3-0204e68b0eae1b82919d-bd11-4c38-bb09-e9031ec15a27c6386458-3bb0-42ae-a01e-5cc88646a797</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>1b82919d-bd11-4c38-bb09-e9031ec15a27</b:FlowGuid><b:Id>664</b:Id><b:InteractionKey>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae:1b82919d-bd11-4c38-bb09-e9031ec15a27:c6386458-3bb0-42ae-a01e-5cc88646a797</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of the ผู้สอน External Destination Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้สอน may be spoofed by an attacker and this may lead to data being sent to the attacker's target instead of ผู้สอน. Consider using a standard authentication mechanism to identify the external entity.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ข้อมูลรายวิชา · การตั้งค่า</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S8</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R7a9c3bd3a-15ff-4b60-83c3-0204e68b0eae1b82919d-bd11-4c38-bb09-e9031ec15a27c6386458-3bb0-42ae-a01e-5cc88646a797</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>1b82919d-bd11-4c38-bb09-e9031ec15a27</b:FlowGuid><b:Id>665</b:Id><b:InteractionKey>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae:1b82919d-bd11-4c38-bb09-e9031ec15a27:c6386458-3bb0-42ae-a01e-5cc88646a797</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>External Entity ผู้สอน Potentially Denies Receiving Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้สอน claims that it did not receive data from a process on the other side of the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ข้อมูลรายวิชา · การตั้งค่า</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4a9c3bd3a-15ff-4b60-83c3-0204e68b0eae1b82919d-bd11-4c38-bb09-e9031ec15a27c6386458-3bb0-42ae-a01e-5cc88646a797</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>1b82919d-bd11-4c38-bb09-e9031ec15a27</b:FlowGuid><b:Id>666</b:Id><b:InteractionKey>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae:1b82919d-bd11-4c38-bb09-e9031ec15a27:c6386458-3bb0-42ae-a01e-5cc88646a797</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow ข้อมูลรายวิชา · การตั้งค่า Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ข้อมูลรายวิชา · การตั้งค่า</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S2c6386458-3bb0-42ae-a01e-5cc88646a7974872c01e-c731-45fd-b256-1ae753c4a36190902f09-4482-4985-ae7b-15a3f9714ac1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>4872c01e-c731-45fd-b256-1ae753c4a361</b:FlowGuid><b:Id>667</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:4872c01e-c731-45fd-b256-1ae753c4a361:90902f09-4482-4985-ae7b-15a3f9714ac1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the 3.0 กำหนด CLO กิจกรรมและเกณฑ์วัดผล Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>3.0 กำหนด CLO กิจกรรมและเกณฑ์วัดผล may be spoofed by an attacker and this may lead to information disclosure by ผู้สอน. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>CLO · จุดประสงค์ · กิจกรรม · น้ำหนัก</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>90902f09-4482-4985-ae7b-15a3f9714ac1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T1c6386458-3bb0-42ae-a01e-5cc88646a7974872c01e-c731-45fd-b256-1ae753c4a36190902f09-4482-4985-ae7b-15a3f9714ac1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>4872c01e-c731-45fd-b256-1ae753c4a361</b:FlowGuid><b:Id>668</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:4872c01e-c731-45fd-b256-1ae753c4a361:90902f09-4482-4985-ae7b-15a3f9714ac1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Lack of Input Validation for 3.0 กำหนด CLO กิจกรรมและเกณฑ์วัดผล</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across CLO · จุดประสงค์ · กิจกรรม · น้ำหนัก may be tampered with by an attacker. This may lead to a denial of service attack against 3.0 กำหนด CLO กิจกรรมและเกณฑ์วัดผล or an elevation of privilege attack against 3.0 กำหนด CLO กิจกรรมและเกณฑ์วัดผล or an information disclosure by 3.0 กำหนด CLO กิจกรรมและเกณฑ์วัดผล. Failure to verify that input is as expected is a root cause of a very large number of exploitable issues. Consider all paths and the way they handle data. Verify that all input is verified for correctness using an approved list input validation approach.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>CLO · จุดประสงค์ · กิจกรรม · น้ำหนัก</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>90902f09-4482-4985-ae7b-15a3f9714ac1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R6c6386458-3bb0-42ae-a01e-5cc88646a7974872c01e-c731-45fd-b256-1ae753c4a36190902f09-4482-4985-ae7b-15a3f9714ac1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>4872c01e-c731-45fd-b256-1ae753c4a361</b:FlowGuid><b:Id>669</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:4872c01e-c731-45fd-b256-1ae753c4a361:90902f09-4482-4985-ae7b-15a3f9714ac1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by 3.0 กำหนด CLO กิจกรรมและเกณฑ์วัดผล</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>3.0 กำหนด CLO กิจกรรมและเกณฑ์วัดผล claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>CLO · จุดประสงค์ · กิจกรรม · น้ำหนัก</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>90902f09-4482-4985-ae7b-15a3f9714ac1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I6c6386458-3bb0-42ae-a01e-5cc88646a7974872c01e-c731-45fd-b256-1ae753c4a36190902f09-4482-4985-ae7b-15a3f9714ac1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>4872c01e-c731-45fd-b256-1ae753c4a361</b:FlowGuid><b:Id>670</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:4872c01e-c731-45fd-b256-1ae753c4a361:90902f09-4482-4985-ae7b-15a3f9714ac1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across CLO · จุดประสงค์ · กิจกรรม · น้ำหนัก may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>CLO · จุดประสงค์ · กิจกรรม · น้ำหนัก</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>90902f09-4482-4985-ae7b-15a3f9714ac1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D3c6386458-3bb0-42ae-a01e-5cc88646a7974872c01e-c731-45fd-b256-1ae753c4a36190902f09-4482-4985-ae7b-15a3f9714ac1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>4872c01e-c731-45fd-b256-1ae753c4a361</b:FlowGuid><b:Id>671</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:4872c01e-c731-45fd-b256-1ae753c4a361:90902f09-4482-4985-ae7b-15a3f9714ac1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for 3.0 กำหนด CLO กิจกรรมและเกณฑ์วัดผล</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>3.0 กำหนด CLO กิจกรรมและเกณฑ์วัดผล crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>CLO · จุดประสงค์ · กิจกรรม · น้ำหนัก</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>90902f09-4482-4985-ae7b-15a3f9714ac1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4c6386458-3bb0-42ae-a01e-5cc88646a7974872c01e-c731-45fd-b256-1ae753c4a36190902f09-4482-4985-ae7b-15a3f9714ac1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>4872c01e-c731-45fd-b256-1ae753c4a361</b:FlowGuid><b:Id>672</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:4872c01e-c731-45fd-b256-1ae753c4a361:90902f09-4482-4985-ae7b-15a3f9714ac1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow CLO · จุดประสงค์ · กิจกรรม · น้ำหนัก Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>CLO · จุดประสงค์ · กิจกรรม · น้ำหนัก</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>90902f09-4482-4985-ae7b-15a3f9714ac1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E6c6386458-3bb0-42ae-a01e-5cc88646a7974872c01e-c731-45fd-b256-1ae753c4a36190902f09-4482-4985-ae7b-15a3f9714ac1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>4872c01e-c731-45fd-b256-1ae753c4a361</b:FlowGuid><b:Id>673</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:4872c01e-c731-45fd-b256-1ae753c4a361:90902f09-4482-4985-ae7b-15a3f9714ac1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>3.0 กำหนด CLO กิจกรรมและเกณฑ์วัดผล May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้สอน may be able to remotely execute code for 3.0 กำหนด CLO กิจกรรมและเกณฑ์วัดผล.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>CLO · จุดประสงค์ · กิจกรรม · น้ำหนัก</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>90902f09-4482-4985-ae7b-15a3f9714ac1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E7c6386458-3bb0-42ae-a01e-5cc88646a7974872c01e-c731-45fd-b256-1ae753c4a36190902f09-4482-4985-ae7b-15a3f9714ac1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>4872c01e-c731-45fd-b256-1ae753c4a361</b:FlowGuid><b:Id>674</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:4872c01e-c731-45fd-b256-1ae753c4a361:90902f09-4482-4985-ae7b-15a3f9714ac1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in 3.0 กำหนด CLO กิจกรรมและเกณฑ์วัดผล</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into 3.0 กำหนด CLO กิจกรรมและเกณฑ์วัดผล in order to change the flow of program execution within 3.0 กำหนด CLO กิจกรรมและเกณฑ์วัดผล to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>CLO · จุดประสงค์ · กิจกรรม · น้ำหนัก</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>90902f09-4482-4985-ae7b-15a3f9714ac1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>8404dcf5-bdd8-4902-abc2-3b6c967b0261c6386458-3bb0-42ae-a01e-5cc88646a7974872c01e-c731-45fd-b256-1ae753c4a36190902f09-4482-4985-ae7b-15a3f9714ac1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>4872c01e-c731-45fd-b256-1ae753c4a361</b:FlowGuid><b:Id>675</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:4872c01e-c731-45fd-b256-1ae753c4a361:90902f09-4482-4985-ae7b-15a3f9714ac1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cross Site Request Forgery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Cross-site request forgery (CSRF or XSRF) is a type of attack in which an attacker forces a user's browser to make a forged request to a vulnerable site by exploiting an existing trust relationship between the browser and the vulnerable web site.  In a simple scenario, a user is logged in to web site A using a cookie as a credential.  The other browses to web site B.  Web site B returns a page with a hidden form that posts to web site A.  Since the browser will carry the user's cookie to web site A, web site B now can take any action on web site A, for example, adding an admin to an account.  The attack can be used to exploit any requests that the browser automatically authenticates, e.g. by session cookie, integrated authentication, IP whitelisting, …  The attack can be carried out in many ways such as by luring the victim to a site under control of the attacker, getting the user to click a link in a phishing email, or hacking a reputable web site that the victim will visit. The issue can only be resolved on the server side by requiring that all authenticated state-changing requests include an additional piece of secret payload (canary or CSRF token) which is known only to the legitimate web site and the browser and which is protected in transit through SSL/TLS. See the Forgery Protection property on the flow stencil for a list of mitigations.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>CLO · จุดประสงค์ · กิจกรรม · น้ำหนัก</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>90902f09-4482-4985-ae7b-15a3f9714ac1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>8404dcf5-bdd8-4902-abc2-3b6c967b0261</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S890902f09-4482-4985-ae7b-15a3f9714ac1efefe74e-61a1-4546-bdd5-a5ba3825f6bcc6386458-3bb0-42ae-a01e-5cc88646a797</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>efefe74e-61a1-4546-bdd5-a5ba3825f6bc</b:FlowGuid><b:Id>676</b:Id><b:InteractionKey>90902f09-4482-4985-ae7b-15a3f9714ac1:efefe74e-61a1-4546-bdd5-a5ba3825f6bc:c6386458-3bb0-42ae-a01e-5cc88646a797</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of the ผู้สอน External Destination Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้สอน may be spoofed by an attacker and this may lead to data being sent to the attacker's target instead of ผู้สอน. Consider using a standard authentication mechanism to identify the external entity.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ตาราง CLO และกิจกรรม · ผลตรวจน้ำหนัก</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>90902f09-4482-4985-ae7b-15a3f9714ac1</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S8</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R790902f09-4482-4985-ae7b-15a3f9714ac1efefe74e-61a1-4546-bdd5-a5ba3825f6bcc6386458-3bb0-42ae-a01e-5cc88646a797</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>efefe74e-61a1-4546-bdd5-a5ba3825f6bc</b:FlowGuid><b:Id>677</b:Id><b:InteractionKey>90902f09-4482-4985-ae7b-15a3f9714ac1:efefe74e-61a1-4546-bdd5-a5ba3825f6bc:c6386458-3bb0-42ae-a01e-5cc88646a797</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>External Entity ผู้สอน Potentially Denies Receiving Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้สอน claims that it did not receive data from a process on the other side of the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ตาราง CLO และกิจกรรม · ผลตรวจน้ำหนัก</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>90902f09-4482-4985-ae7b-15a3f9714ac1</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D490902f09-4482-4985-ae7b-15a3f9714ac1efefe74e-61a1-4546-bdd5-a5ba3825f6bcc6386458-3bb0-42ae-a01e-5cc88646a797</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>efefe74e-61a1-4546-bdd5-a5ba3825f6bc</b:FlowGuid><b:Id>678</b:Id><b:InteractionKey>90902f09-4482-4985-ae7b-15a3f9714ac1:efefe74e-61a1-4546-bdd5-a5ba3825f6bc:c6386458-3bb0-42ae-a01e-5cc88646a797</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow ตาราง CLO และกิจกรรม · ผลตรวจน้ำหนัก Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ตาราง CLO และกิจกรรม · ผลตรวจน้ำหนัก</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>90902f09-4482-4985-ae7b-15a3f9714ac1</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S2c6386458-3bb0-42ae-a01e-5cc88646a7971bb1318c-bde8-406d-b704-c20f171a39f51b11bd38-67d1-4d31-9e54-bf5c662948b1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>1bb1318c-bde8-406d-b704-c20f171a39f5</b:FlowGuid><b:Id>679</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:1bb1318c-bde8-406d-b704-c20f171a39f5:1b11bd38-67d1-4d31-9e54-bf5c662948b1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the 5.0 จัดการรายชื่อนักศึกษา Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>5.0 จัดการรายชื่อนักศึกษา may be spoofed by an attacker and this may lead to information disclosure by ผู้สอน. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายชื่อ (กรอกเองหรือไฟล์ Excel) การถอนรายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>1b11bd38-67d1-4d31-9e54-bf5c662948b1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T1c6386458-3bb0-42ae-a01e-5cc88646a7971bb1318c-bde8-406d-b704-c20f171a39f51b11bd38-67d1-4d31-9e54-bf5c662948b1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>1bb1318c-bde8-406d-b704-c20f171a39f5</b:FlowGuid><b:Id>680</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:1bb1318c-bde8-406d-b704-c20f171a39f5:1b11bd38-67d1-4d31-9e54-bf5c662948b1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Lack of Input Validation for 5.0 จัดการรายชื่อนักศึกษา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across รายชื่อ (กรอกเองหรือไฟล์ Excel) การถอนรายวิชา may be tampered with by an attacker. This may lead to a denial of service attack against 5.0 จัดการรายชื่อนักศึกษา or an elevation of privilege attack against 5.0 จัดการรายชื่อนักศึกษา or an information disclosure by 5.0 จัดการรายชื่อนักศึกษา. Failure to verify that input is as expected is a root cause of a very large number of exploitable issues. Consider all paths and the way they handle data. Verify that all input is verified for correctness using an approved list input validation approach.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายชื่อ (กรอกเองหรือไฟล์ Excel) การถอนรายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>1b11bd38-67d1-4d31-9e54-bf5c662948b1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R6c6386458-3bb0-42ae-a01e-5cc88646a7971bb1318c-bde8-406d-b704-c20f171a39f51b11bd38-67d1-4d31-9e54-bf5c662948b1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>1bb1318c-bde8-406d-b704-c20f171a39f5</b:FlowGuid><b:Id>681</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:1bb1318c-bde8-406d-b704-c20f171a39f5:1b11bd38-67d1-4d31-9e54-bf5c662948b1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by 5.0 จัดการรายชื่อนักศึกษา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>5.0 จัดการรายชื่อนักศึกษา claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายชื่อ (กรอกเองหรือไฟล์ Excel) การถอนรายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>1b11bd38-67d1-4d31-9e54-bf5c662948b1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I6c6386458-3bb0-42ae-a01e-5cc88646a7971bb1318c-bde8-406d-b704-c20f171a39f51b11bd38-67d1-4d31-9e54-bf5c662948b1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>1bb1318c-bde8-406d-b704-c20f171a39f5</b:FlowGuid><b:Id>682</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:1bb1318c-bde8-406d-b704-c20f171a39f5:1b11bd38-67d1-4d31-9e54-bf5c662948b1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across รายชื่อ (กรอกเองหรือไฟล์ Excel) การถอนรายวิชา may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายชื่อ (กรอกเองหรือไฟล์ Excel) การถอนรายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>1b11bd38-67d1-4d31-9e54-bf5c662948b1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D3c6386458-3bb0-42ae-a01e-5cc88646a7971bb1318c-bde8-406d-b704-c20f171a39f51b11bd38-67d1-4d31-9e54-bf5c662948b1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>1bb1318c-bde8-406d-b704-c20f171a39f5</b:FlowGuid><b:Id>683</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:1bb1318c-bde8-406d-b704-c20f171a39f5:1b11bd38-67d1-4d31-9e54-bf5c662948b1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for 5.0 จัดการรายชื่อนักศึกษา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>5.0 จัดการรายชื่อนักศึกษา crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายชื่อ (กรอกเองหรือไฟล์ Excel) การถอนรายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>1b11bd38-67d1-4d31-9e54-bf5c662948b1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4c6386458-3bb0-42ae-a01e-5cc88646a7971bb1318c-bde8-406d-b704-c20f171a39f51b11bd38-67d1-4d31-9e54-bf5c662948b1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>1bb1318c-bde8-406d-b704-c20f171a39f5</b:FlowGuid><b:Id>684</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:1bb1318c-bde8-406d-b704-c20f171a39f5:1b11bd38-67d1-4d31-9e54-bf5c662948b1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow รายชื่อ (กรอกเองหรือไฟล์ Excel) การถอนรายวิชา Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายชื่อ (กรอกเองหรือไฟล์ Excel) การถอนรายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>1b11bd38-67d1-4d31-9e54-bf5c662948b1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E6c6386458-3bb0-42ae-a01e-5cc88646a7971bb1318c-bde8-406d-b704-c20f171a39f51b11bd38-67d1-4d31-9e54-bf5c662948b1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>1bb1318c-bde8-406d-b704-c20f171a39f5</b:FlowGuid><b:Id>685</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:1bb1318c-bde8-406d-b704-c20f171a39f5:1b11bd38-67d1-4d31-9e54-bf5c662948b1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>5.0 จัดการรายชื่อนักศึกษา May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้สอน may be able to remotely execute code for 5.0 จัดการรายชื่อนักศึกษา.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายชื่อ (กรอกเองหรือไฟล์ Excel) การถอนรายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>1b11bd38-67d1-4d31-9e54-bf5c662948b1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E7c6386458-3bb0-42ae-a01e-5cc88646a7971bb1318c-bde8-406d-b704-c20f171a39f51b11bd38-67d1-4d31-9e54-bf5c662948b1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>1bb1318c-bde8-406d-b704-c20f171a39f5</b:FlowGuid><b:Id>686</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:1bb1318c-bde8-406d-b704-c20f171a39f5:1b11bd38-67d1-4d31-9e54-bf5c662948b1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in 5.0 จัดการรายชื่อนักศึกษา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into 5.0 จัดการรายชื่อนักศึกษา in order to change the flow of program execution within 5.0 จัดการรายชื่อนักศึกษา to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายชื่อ (กรอกเองหรือไฟล์ Excel) การถอนรายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>1b11bd38-67d1-4d31-9e54-bf5c662948b1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>8404dcf5-bdd8-4902-abc2-3b6c967b0261c6386458-3bb0-42ae-a01e-5cc88646a7971bb1318c-bde8-406d-b704-c20f171a39f51b11bd38-67d1-4d31-9e54-bf5c662948b1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>1bb1318c-bde8-406d-b704-c20f171a39f5</b:FlowGuid><b:Id>687</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:1bb1318c-bde8-406d-b704-c20f171a39f5:1b11bd38-67d1-4d31-9e54-bf5c662948b1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cross Site Request Forgery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Cross-site request forgery (CSRF or XSRF) is a type of attack in which an attacker forces a user's browser to make a forged request to a vulnerable site by exploiting an existing trust relationship between the browser and the vulnerable web site.  In a simple scenario, a user is logged in to web site A using a cookie as a credential.  The other browses to web site B.  Web site B returns a page with a hidden form that posts to web site A.  Since the browser will carry the user's cookie to web site A, web site B now can take any action on web site A, for example, adding an admin to an account.  The attack can be used to exploit any requests that the browser automatically authenticates, e.g. by session cookie, integrated authentication, IP whitelisting, …  The attack can be carried out in many ways such as by luring the victim to a site under control of the attacker, getting the user to click a link in a phishing email, or hacking a reputable web site that the victim will visit. The issue can only be resolved on the server side by requiring that all authenticated state-changing requests include an additional piece of secret payload (canary or CSRF token) which is known only to the legitimate web site and the browser and which is protected in transit through SSL/TLS. See the Forgery Protection property on the flow stencil for a list of mitigations.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายชื่อ (กรอกเองหรือไฟล์ Excel) การถอนรายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>1b11bd38-67d1-4d31-9e54-bf5c662948b1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>8404dcf5-bdd8-4902-abc2-3b6c967b0261</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S81b11bd38-67d1-4d31-9e54-bf5c662948b100c0c37b-fb20-4fac-8f54-281630e986b7c6386458-3bb0-42ae-a01e-5cc88646a797</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>00c0c37b-fb20-4fac-8f54-281630e986b7</b:FlowGuid><b:Id>688</b:Id><b:InteractionKey>1b11bd38-67d1-4d31-9e54-bf5c662948b1:00c0c37b-fb20-4fac-8f54-281630e986b7:c6386458-3bb0-42ae-a01e-5cc88646a797</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of the ผู้สอน External Destination Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้สอน may be spoofed by an attacker and this may lead to data being sent to the attacker's target instead of ผู้สอน. Consider using a standard authentication mechanism to identify the external entity.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายชื่อนักศึกษา · ผลตรวจไฟล์</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>1b11bd38-67d1-4d31-9e54-bf5c662948b1</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S8</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R71b11bd38-67d1-4d31-9e54-bf5c662948b100c0c37b-fb20-4fac-8f54-281630e986b7c6386458-3bb0-42ae-a01e-5cc88646a797</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>00c0c37b-fb20-4fac-8f54-281630e986b7</b:FlowGuid><b:Id>689</b:Id><b:InteractionKey>1b11bd38-67d1-4d31-9e54-bf5c662948b1:00c0c37b-fb20-4fac-8f54-281630e986b7:c6386458-3bb0-42ae-a01e-5cc88646a797</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>External Entity ผู้สอน Potentially Denies Receiving Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้สอน claims that it did not receive data from a process on the other side of the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายชื่อนักศึกษา · ผลตรวจไฟล์</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>1b11bd38-67d1-4d31-9e54-bf5c662948b1</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D41b11bd38-67d1-4d31-9e54-bf5c662948b100c0c37b-fb20-4fac-8f54-281630e986b7c6386458-3bb0-42ae-a01e-5cc88646a797</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>00c0c37b-fb20-4fac-8f54-281630e986b7</b:FlowGuid><b:Id>690</b:Id><b:InteractionKey>1b11bd38-67d1-4d31-9e54-bf5c662948b1:00c0c37b-fb20-4fac-8f54-281630e986b7:c6386458-3bb0-42ae-a01e-5cc88646a797</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow รายชื่อนักศึกษา · ผลตรวจไฟล์ Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายชื่อนักศึกษา · ผลตรวจไฟล์</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>1b11bd38-67d1-4d31-9e54-bf5c662948b1</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S2c6386458-3bb0-42ae-a01e-5cc88646a79700c62e51-dca6-41cc-a7a3-eb332638e40c0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>00c62e51-dca6-41cc-a7a3-eb332638e40c</b:FlowGuid><b:Id>691</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:00c62e51-dca6-41cc-a7a3-eb332638e40c:0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the 4.0 บันทึกและนำเข้าคะแนน Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>4.0 บันทึกและนำเข้าคะแนน may be spoofed by an attacker and this may lead to information disclosure by ผู้สอน. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนน (กรอกเองหรือไฟล์ Excel)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T1c6386458-3bb0-42ae-a01e-5cc88646a79700c62e51-dca6-41cc-a7a3-eb332638e40c0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>00c62e51-dca6-41cc-a7a3-eb332638e40c</b:FlowGuid><b:Id>692</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:00c62e51-dca6-41cc-a7a3-eb332638e40c:0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Lack of Input Validation for 4.0 บันทึกและนำเข้าคะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across คะแนน (กรอกเองหรือไฟล์ Excel) may be tampered with by an attacker. This may lead to a denial of service attack against 4.0 บันทึกและนำเข้าคะแนน or an elevation of privilege attack against 4.0 บันทึกและนำเข้าคะแนน or an information disclosure by 4.0 บันทึกและนำเข้าคะแนน. Failure to verify that input is as expected is a root cause of a very large number of exploitable issues. Consider all paths and the way they handle data. Verify that all input is verified for correctness using an approved list input validation approach.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนน (กรอกเองหรือไฟล์ Excel)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R6c6386458-3bb0-42ae-a01e-5cc88646a79700c62e51-dca6-41cc-a7a3-eb332638e40c0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>00c62e51-dca6-41cc-a7a3-eb332638e40c</b:FlowGuid><b:Id>693</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:00c62e51-dca6-41cc-a7a3-eb332638e40c:0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by 4.0 บันทึกและนำเข้าคะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>4.0 บันทึกและนำเข้าคะแนน claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนน (กรอกเองหรือไฟล์ Excel)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I6c6386458-3bb0-42ae-a01e-5cc88646a79700c62e51-dca6-41cc-a7a3-eb332638e40c0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>00c62e51-dca6-41cc-a7a3-eb332638e40c</b:FlowGuid><b:Id>694</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:00c62e51-dca6-41cc-a7a3-eb332638e40c:0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across คะแนน (กรอกเองหรือไฟล์ Excel) may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนน (กรอกเองหรือไฟล์ Excel)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D3c6386458-3bb0-42ae-a01e-5cc88646a79700c62e51-dca6-41cc-a7a3-eb332638e40c0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>00c62e51-dca6-41cc-a7a3-eb332638e40c</b:FlowGuid><b:Id>695</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:00c62e51-dca6-41cc-a7a3-eb332638e40c:0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for 4.0 บันทึกและนำเข้าคะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>4.0 บันทึกและนำเข้าคะแนน crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนน (กรอกเองหรือไฟล์ Excel)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4c6386458-3bb0-42ae-a01e-5cc88646a79700c62e51-dca6-41cc-a7a3-eb332638e40c0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>00c62e51-dca6-41cc-a7a3-eb332638e40c</b:FlowGuid><b:Id>696</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:00c62e51-dca6-41cc-a7a3-eb332638e40c:0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow คะแนน (กรอกเองหรือไฟล์ Excel) Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนน (กรอกเองหรือไฟล์ Excel)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E6c6386458-3bb0-42ae-a01e-5cc88646a79700c62e51-dca6-41cc-a7a3-eb332638e40c0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>00c62e51-dca6-41cc-a7a3-eb332638e40c</b:FlowGuid><b:Id>697</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:00c62e51-dca6-41cc-a7a3-eb332638e40c:0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>4.0 บันทึกและนำเข้าคะแนน May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้สอน may be able to remotely execute code for 4.0 บันทึกและนำเข้าคะแนน.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนน (กรอกเองหรือไฟล์ Excel)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E7c6386458-3bb0-42ae-a01e-5cc88646a79700c62e51-dca6-41cc-a7a3-eb332638e40c0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>00c62e51-dca6-41cc-a7a3-eb332638e40c</b:FlowGuid><b:Id>698</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:00c62e51-dca6-41cc-a7a3-eb332638e40c:0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in 4.0 บันทึกและนำเข้าคะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into 4.0 บันทึกและนำเข้าคะแนน in order to change the flow of program execution within 4.0 บันทึกและนำเข้าคะแนน to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนน (กรอกเองหรือไฟล์ Excel)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>8404dcf5-bdd8-4902-abc2-3b6c967b0261c6386458-3bb0-42ae-a01e-5cc88646a79700c62e51-dca6-41cc-a7a3-eb332638e40c0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>00c62e51-dca6-41cc-a7a3-eb332638e40c</b:FlowGuid><b:Id>699</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:00c62e51-dca6-41cc-a7a3-eb332638e40c:0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cross Site Request Forgery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Cross-site request forgery (CSRF or XSRF) is a type of attack in which an attacker forces a user's browser to make a forged request to a vulnerable site by exploiting an existing trust relationship between the browser and the vulnerable web site.  In a simple scenario, a user is logged in to web site A using a cookie as a credential.  The other browses to web site B.  Web site B returns a page with a hidden form that posts to web site A.  Since the browser will carry the user's cookie to web site A, web site B now can take any action on web site A, for example, adding an admin to an account.  The attack can be used to exploit any requests that the browser automatically authenticates, e.g. by session cookie, integrated authentication, IP whitelisting, …  The attack can be carried out in many ways such as by luring the victim to a site under control of the attacker, getting the user to click a link in a phishing email, or hacking a reputable web site that the victim will visit. The issue can only be resolved on the server side by requiring that all authenticated state-changing requests include an additional piece of secret payload (canary or CSRF token) which is known only to the legitimate web site and the browser and which is protected in transit through SSL/TLS. See the Forgery Protection property on the flow stencil for a list of mitigations.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนน (กรอกเองหรือไฟล์ Excel)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>8404dcf5-bdd8-4902-abc2-3b6c967b0261</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S80a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28ac5ee80f-3a31-4f97-b5e7-39d9fc26c863c6386458-3bb0-42ae-a01e-5cc88646a797</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>ac5ee80f-3a31-4f97-b5e7-39d9fc26c863</b:FlowGuid><b:Id>700</b:Id><b:InteractionKey>0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28:ac5ee80f-3a31-4f97-b5e7-39d9fc26c863:c6386458-3bb0-42ae-a01e-5cc88646a797</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of the ผู้สอน External Destination Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้สอน may be spoofed by an attacker and this may lead to data being sent to the attacker's target instead of ผู้สอน. Consider using a standard authentication mechanism to identify the external entity.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ตารางคะแนน · แบบฟอร์ม Excel ผลตรวจไฟล์</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S8</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R70a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28ac5ee80f-3a31-4f97-b5e7-39d9fc26c863c6386458-3bb0-42ae-a01e-5cc88646a797</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>ac5ee80f-3a31-4f97-b5e7-39d9fc26c863</b:FlowGuid><b:Id>701</b:Id><b:InteractionKey>0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28:ac5ee80f-3a31-4f97-b5e7-39d9fc26c863:c6386458-3bb0-42ae-a01e-5cc88646a797</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>External Entity ผู้สอน Potentially Denies Receiving Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้สอน claims that it did not receive data from a process on the other side of the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ตารางคะแนน · แบบฟอร์ม Excel ผลตรวจไฟล์</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D40a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28ac5ee80f-3a31-4f97-b5e7-39d9fc26c863c6386458-3bb0-42ae-a01e-5cc88646a797</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>ac5ee80f-3a31-4f97-b5e7-39d9fc26c863</b:FlowGuid><b:Id>702</b:Id><b:InteractionKey>0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28:ac5ee80f-3a31-4f97-b5e7-39d9fc26c863:c6386458-3bb0-42ae-a01e-5cc88646a797</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow ตารางคะแนน · แบบฟอร์ม Excel ผลตรวจไฟล์ Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ตารางคะแนน · แบบฟอร์ม Excel ผลตรวจไฟล์</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S2c6386458-3bb0-42ae-a01e-5cc88646a797d2627ee7-9725-4fb3-9a0f-e872927e859ef5955920-e121-4620-becd-c3deca036284</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>d2627ee7-9725-4fb3-9a0f-e872927e859e</b:FlowGuid><b:Id>703</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:d2627ee7-9725-4fb3-9a0f-e872927e859e:f5955920-e121-4620-becd-c3deca036284</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the 6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด may be spoofed by an attacker and this may lead to information disclosure by ผู้สอน. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>เกรด · สถิติ · ไฟล์ผลการเรียน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f5955920-e121-4620-becd-c3deca036284</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T1c6386458-3bb0-42ae-a01e-5cc88646a797d2627ee7-9725-4fb3-9a0f-e872927e859ef5955920-e121-4620-becd-c3deca036284</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>d2627ee7-9725-4fb3-9a0f-e872927e859e</b:FlowGuid><b:Id>704</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:d2627ee7-9725-4fb3-9a0f-e872927e859e:f5955920-e121-4620-becd-c3deca036284</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Lack of Input Validation for 6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across เกรด · สถิติ · ไฟล์ผลการเรียน may be tampered with by an attacker. This may lead to a denial of service attack against 6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด or an elevation of privilege attack against 6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด or an information disclosure by 6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด. Failure to verify that input is as expected is a root cause of a very large number of exploitable issues. Consider all paths and the way they handle data. Verify that all input is verified for correctness using an approved list input validation approach.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>เกรด · สถิติ · ไฟล์ผลการเรียน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f5955920-e121-4620-becd-c3deca036284</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R6c6386458-3bb0-42ae-a01e-5cc88646a797d2627ee7-9725-4fb3-9a0f-e872927e859ef5955920-e121-4620-becd-c3deca036284</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>d2627ee7-9725-4fb3-9a0f-e872927e859e</b:FlowGuid><b:Id>705</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:d2627ee7-9725-4fb3-9a0f-e872927e859e:f5955920-e121-4620-becd-c3deca036284</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by 6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>เกรด · สถิติ · ไฟล์ผลการเรียน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f5955920-e121-4620-becd-c3deca036284</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I6c6386458-3bb0-42ae-a01e-5cc88646a797d2627ee7-9725-4fb3-9a0f-e872927e859ef5955920-e121-4620-becd-c3deca036284</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>d2627ee7-9725-4fb3-9a0f-e872927e859e</b:FlowGuid><b:Id>706</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:d2627ee7-9725-4fb3-9a0f-e872927e859e:f5955920-e121-4620-becd-c3deca036284</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across เกรด · สถิติ · ไฟล์ผลการเรียน may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>เกรด · สถิติ · ไฟล์ผลการเรียน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f5955920-e121-4620-becd-c3deca036284</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D3c6386458-3bb0-42ae-a01e-5cc88646a797d2627ee7-9725-4fb3-9a0f-e872927e859ef5955920-e121-4620-becd-c3deca036284</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>d2627ee7-9725-4fb3-9a0f-e872927e859e</b:FlowGuid><b:Id>707</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:d2627ee7-9725-4fb3-9a0f-e872927e859e:f5955920-e121-4620-becd-c3deca036284</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for 6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>เกรด · สถิติ · ไฟล์ผลการเรียน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f5955920-e121-4620-becd-c3deca036284</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4c6386458-3bb0-42ae-a01e-5cc88646a797d2627ee7-9725-4fb3-9a0f-e872927e859ef5955920-e121-4620-becd-c3deca036284</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>d2627ee7-9725-4fb3-9a0f-e872927e859e</b:FlowGuid><b:Id>708</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:d2627ee7-9725-4fb3-9a0f-e872927e859e:f5955920-e121-4620-becd-c3deca036284</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow เกรด · สถิติ · ไฟล์ผลการเรียน Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>เกรด · สถิติ · ไฟล์ผลการเรียน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f5955920-e121-4620-becd-c3deca036284</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E6c6386458-3bb0-42ae-a01e-5cc88646a797d2627ee7-9725-4fb3-9a0f-e872927e859ef5955920-e121-4620-becd-c3deca036284</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>d2627ee7-9725-4fb3-9a0f-e872927e859e</b:FlowGuid><b:Id>709</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:d2627ee7-9725-4fb3-9a0f-e872927e859e:f5955920-e121-4620-becd-c3deca036284</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้สอน may be able to remotely execute code for 6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>เกรด · สถิติ · ไฟล์ผลการเรียน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f5955920-e121-4620-becd-c3deca036284</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E7c6386458-3bb0-42ae-a01e-5cc88646a797d2627ee7-9725-4fb3-9a0f-e872927e859ef5955920-e121-4620-becd-c3deca036284</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>d2627ee7-9725-4fb3-9a0f-e872927e859e</b:FlowGuid><b:Id>710</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:d2627ee7-9725-4fb3-9a0f-e872927e859e:f5955920-e121-4620-becd-c3deca036284</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in 6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into 6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด in order to change the flow of program execution within 6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>เกรด · สถิติ · ไฟล์ผลการเรียน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f5955920-e121-4620-becd-c3deca036284</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>8404dcf5-bdd8-4902-abc2-3b6c967b0261c6386458-3bb0-42ae-a01e-5cc88646a797d2627ee7-9725-4fb3-9a0f-e872927e859ef5955920-e121-4620-becd-c3deca036284</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>d2627ee7-9725-4fb3-9a0f-e872927e859e</b:FlowGuid><b:Id>711</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:d2627ee7-9725-4fb3-9a0f-e872927e859e:f5955920-e121-4620-becd-c3deca036284</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cross Site Request Forgery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Cross-site request forgery (CSRF or XSRF) is a type of attack in which an attacker forces a user's browser to make a forged request to a vulnerable site by exploiting an existing trust relationship between the browser and the vulnerable web site.  In a simple scenario, a user is logged in to web site A using a cookie as a credential.  The other browses to web site B.  Web site B returns a page with a hidden form that posts to web site A.  Since the browser will carry the user's cookie to web site A, web site B now can take any action on web site A, for example, adding an admin to an account.  The attack can be used to exploit any requests that the browser automatically authenticates, e.g. by session cookie, integrated authentication, IP whitelisting, …  The attack can be carried out in many ways such as by luring the victim to a site under control of the attacker, getting the user to click a link in a phishing email, or hacking a reputable web site that the victim will visit. The issue can only be resolved on the server side by requiring that all authenticated state-changing requests include an additional piece of secret payload (canary or CSRF token) which is known only to the legitimate web site and the browser and which is protected in transit through SSL/TLS. See the Forgery Protection property on the flow stencil for a list of mitigations.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>เกรด · สถิติ · ไฟล์ผลการเรียน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f5955920-e121-4620-becd-c3deca036284</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>8404dcf5-bdd8-4902-abc2-3b6c967b0261</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S8f5955920-e121-4620-becd-c3deca036284e01eabf5-a6ff-48dd-a533-ed0af4a21068c6386458-3bb0-42ae-a01e-5cc88646a797</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>e01eabf5-a6ff-48dd-a533-ed0af4a21068</b:FlowGuid><b:Id>712</b:Id><b:InteractionKey>f5955920-e121-4620-becd-c3deca036284:e01eabf5-a6ff-48dd-a533-ed0af4a21068:c6386458-3bb0-42ae-a01e-5cc88646a797</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of the ผู้สอน External Destination Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้สอน may be spoofed by an attacker and this may lead to data being sent to the attacker's target instead of ผู้สอน. Consider using a standard authentication mechanism to identify the external entity.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ช่วงเกรด · คำสั่งตัดเกรด การปรับเกรดพร้อมเหตุผล</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f5955920-e121-4620-becd-c3deca036284</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S8</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R7f5955920-e121-4620-becd-c3deca036284e01eabf5-a6ff-48dd-a533-ed0af4a21068c6386458-3bb0-42ae-a01e-5cc88646a797</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>e01eabf5-a6ff-48dd-a533-ed0af4a21068</b:FlowGuid><b:Id>713</b:Id><b:InteractionKey>f5955920-e121-4620-becd-c3deca036284:e01eabf5-a6ff-48dd-a533-ed0af4a21068:c6386458-3bb0-42ae-a01e-5cc88646a797</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>External Entity ผู้สอน Potentially Denies Receiving Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้สอน claims that it did not receive data from a process on the other side of the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ช่วงเกรด · คำสั่งตัดเกรด การปรับเกรดพร้อมเหตุผล</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f5955920-e121-4620-becd-c3deca036284</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4f5955920-e121-4620-becd-c3deca036284e01eabf5-a6ff-48dd-a533-ed0af4a21068c6386458-3bb0-42ae-a01e-5cc88646a797</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>e01eabf5-a6ff-48dd-a533-ed0af4a21068</b:FlowGuid><b:Id>714</b:Id><b:InteractionKey>f5955920-e121-4620-becd-c3deca036284:e01eabf5-a6ff-48dd-a533-ed0af4a21068:c6386458-3bb0-42ae-a01e-5cc88646a797</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow ช่วงเกรด · คำสั่งตัดเกรด การปรับเกรดพร้อมเหตุผล Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ช่วงเกรด · คำสั่งตัดเกรด การปรับเกรดพร้อมเหตุผล</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f5955920-e121-4620-becd-c3deca036284</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S2c6386458-3bb0-42ae-a01e-5cc88646a7975ba440fa-04e3-40b9-8d92-dfdd2dc9fcbbf5955920-e121-4620-becd-c3deca036284</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>5ba440fa-04e3-40b9-8d92-dfdd2dc9fcbb</b:FlowGuid><b:Id>715</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:5ba440fa-04e3-40b9-8d92-dfdd2dc9fcbb:f5955920-e121-4620-becd-c3deca036284</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the 6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด may be spoofed by an attacker and this may lead to information disclosure by ผู้สอน. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ผลการบรรลุ CLO รายชื่อที่ต้องช่วยเหลือ · รายงาน Excel</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f5955920-e121-4620-becd-c3deca036284</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T1c6386458-3bb0-42ae-a01e-5cc88646a7975ba440fa-04e3-40b9-8d92-dfdd2dc9fcbbf5955920-e121-4620-becd-c3deca036284</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>5ba440fa-04e3-40b9-8d92-dfdd2dc9fcbb</b:FlowGuid><b:Id>716</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:5ba440fa-04e3-40b9-8d92-dfdd2dc9fcbb:f5955920-e121-4620-becd-c3deca036284</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Lack of Input Validation for 6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across ผลการบรรลุ CLO รายชื่อที่ต้องช่วยเหลือ · รายงาน Excel may be tampered with by an attacker. This may lead to a denial of service attack against 6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด or an elevation of privilege attack against 6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด or an information disclosure by 6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด. Failure to verify that input is as expected is a root cause of a very large number of exploitable issues. Consider all paths and the way they handle data. Verify that all input is verified for correctness using an approved list input validation approach.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ผลการบรรลุ CLO รายชื่อที่ต้องช่วยเหลือ · รายงาน Excel</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f5955920-e121-4620-becd-c3deca036284</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R6c6386458-3bb0-42ae-a01e-5cc88646a7975ba440fa-04e3-40b9-8d92-dfdd2dc9fcbbf5955920-e121-4620-becd-c3deca036284</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>5ba440fa-04e3-40b9-8d92-dfdd2dc9fcbb</b:FlowGuid><b:Id>717</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:5ba440fa-04e3-40b9-8d92-dfdd2dc9fcbb:f5955920-e121-4620-becd-c3deca036284</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by 6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ผลการบรรลุ CLO รายชื่อที่ต้องช่วยเหลือ · รายงาน Excel</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f5955920-e121-4620-becd-c3deca036284</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I6c6386458-3bb0-42ae-a01e-5cc88646a7975ba440fa-04e3-40b9-8d92-dfdd2dc9fcbbf5955920-e121-4620-becd-c3deca036284</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>5ba440fa-04e3-40b9-8d92-dfdd2dc9fcbb</b:FlowGuid><b:Id>718</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:5ba440fa-04e3-40b9-8d92-dfdd2dc9fcbb:f5955920-e121-4620-becd-c3deca036284</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across ผลการบรรลุ CLO รายชื่อที่ต้องช่วยเหลือ · รายงาน Excel may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ผลการบรรลุ CLO รายชื่อที่ต้องช่วยเหลือ · รายงาน Excel</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f5955920-e121-4620-becd-c3deca036284</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D3c6386458-3bb0-42ae-a01e-5cc88646a7975ba440fa-04e3-40b9-8d92-dfdd2dc9fcbbf5955920-e121-4620-becd-c3deca036284</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>5ba440fa-04e3-40b9-8d92-dfdd2dc9fcbb</b:FlowGuid><b:Id>719</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:5ba440fa-04e3-40b9-8d92-dfdd2dc9fcbb:f5955920-e121-4620-becd-c3deca036284</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for 6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ผลการบรรลุ CLO รายชื่อที่ต้องช่วยเหลือ · รายงาน Excel</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f5955920-e121-4620-becd-c3deca036284</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4c6386458-3bb0-42ae-a01e-5cc88646a7975ba440fa-04e3-40b9-8d92-dfdd2dc9fcbbf5955920-e121-4620-becd-c3deca036284</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>5ba440fa-04e3-40b9-8d92-dfdd2dc9fcbb</b:FlowGuid><b:Id>720</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:5ba440fa-04e3-40b9-8d92-dfdd2dc9fcbb:f5955920-e121-4620-becd-c3deca036284</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow ผลการบรรลุ CLO รายชื่อที่ต้องช่วยเหลือ · รายงาน Excel Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ผลการบรรลุ CLO รายชื่อที่ต้องช่วยเหลือ · รายงาน Excel</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f5955920-e121-4620-becd-c3deca036284</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E6c6386458-3bb0-42ae-a01e-5cc88646a7975ba440fa-04e3-40b9-8d92-dfdd2dc9fcbbf5955920-e121-4620-becd-c3deca036284</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>5ba440fa-04e3-40b9-8d92-dfdd2dc9fcbb</b:FlowGuid><b:Id>721</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:5ba440fa-04e3-40b9-8d92-dfdd2dc9fcbb:f5955920-e121-4620-becd-c3deca036284</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้สอน may be able to remotely execute code for 6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ผลการบรรลุ CLO รายชื่อที่ต้องช่วยเหลือ · รายงาน Excel</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f5955920-e121-4620-becd-c3deca036284</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E7c6386458-3bb0-42ae-a01e-5cc88646a7975ba440fa-04e3-40b9-8d92-dfdd2dc9fcbbf5955920-e121-4620-becd-c3deca036284</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>5ba440fa-04e3-40b9-8d92-dfdd2dc9fcbb</b:FlowGuid><b:Id>722</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:5ba440fa-04e3-40b9-8d92-dfdd2dc9fcbb:f5955920-e121-4620-becd-c3deca036284</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in 6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into 6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด in order to change the flow of program execution within 6.0 ประเมินผล CLO และติดตามนักศึกษา ตัดเกรด to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ผลการบรรลุ CLO รายชื่อที่ต้องช่วยเหลือ · รายงาน Excel</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f5955920-e121-4620-becd-c3deca036284</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>8404dcf5-bdd8-4902-abc2-3b6c967b0261c6386458-3bb0-42ae-a01e-5cc88646a7975ba440fa-04e3-40b9-8d92-dfdd2dc9fcbbf5955920-e121-4620-becd-c3deca036284</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>5ba440fa-04e3-40b9-8d92-dfdd2dc9fcbb</b:FlowGuid><b:Id>723</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:5ba440fa-04e3-40b9-8d92-dfdd2dc9fcbb:f5955920-e121-4620-becd-c3deca036284</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cross Site Request Forgery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Cross-site request forgery (CSRF or XSRF) is a type of attack in which an attacker forces a user's browser to make a forged request to a vulnerable site by exploiting an existing trust relationship between the browser and the vulnerable web site.  In a simple scenario, a user is logged in to web site A using a cookie as a credential.  The other browses to web site B.  Web site B returns a page with a hidden form that posts to web site A.  Since the browser will carry the user's cookie to web site A, web site B now can take any action on web site A, for example, adding an admin to an account.  The attack can be used to exploit any requests that the browser automatically authenticates, e.g. by session cookie, integrated authentication, IP whitelisting, …  The attack can be carried out in many ways such as by luring the victim to a site under control of the attacker, getting the user to click a link in a phishing email, or hacking a reputable web site that the victim will visit. The issue can only be resolved on the server side by requiring that all authenticated state-changing requests include an additional piece of secret payload (canary or CSRF token) which is known only to the legitimate web site and the browser and which is protected in transit through SSL/TLS. See the Forgery Protection property on the flow stencil for a list of mitigations.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ผลการบรรลุ CLO รายชื่อที่ต้องช่วยเหลือ · รายงาน Excel</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f5955920-e121-4620-becd-c3deca036284</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>8404dcf5-bdd8-4902-abc2-3b6c967b0261</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S8a9c3bd3a-15ff-4b60-83c3-0204e68b0eae2bc363e3-0355-49a1-9c4d-61d8e08bb82255aa40c0-7498-452a-b45b-52f39cf002c5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>2bc363e3-0355-49a1-9c4d-61d8e08bb822</b:FlowGuid><b:Id>724</b:Id><b:InteractionKey>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae:2bc363e3-0355-49a1-9c4d-61d8e08bb822:55aa40c0-7498-452a-b45b-52f39cf002c5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of the ผู้ดูแลระบบ External Destination Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้ดูแลระบบ may be spoofed by an attacker and this may lead to data being sent to the attacker's target instead of ผู้ดูแลระบบ. Consider using a standard authentication mechanism to identify the external entity.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายการรายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>55aa40c0-7498-452a-b45b-52f39cf002c5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S8</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R7a9c3bd3a-15ff-4b60-83c3-0204e68b0eae2bc363e3-0355-49a1-9c4d-61d8e08bb82255aa40c0-7498-452a-b45b-52f39cf002c5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>2bc363e3-0355-49a1-9c4d-61d8e08bb822</b:FlowGuid><b:Id>725</b:Id><b:InteractionKey>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae:2bc363e3-0355-49a1-9c4d-61d8e08bb822:55aa40c0-7498-452a-b45b-52f39cf002c5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>External Entity ผู้ดูแลระบบ Potentially Denies Receiving Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้ดูแลระบบ claims that it did not receive data from a process on the other side of the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายการรายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>55aa40c0-7498-452a-b45b-52f39cf002c5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4a9c3bd3a-15ff-4b60-83c3-0204e68b0eae2bc363e3-0355-49a1-9c4d-61d8e08bb82255aa40c0-7498-452a-b45b-52f39cf002c5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>2bc363e3-0355-49a1-9c4d-61d8e08bb822</b:FlowGuid><b:Id>726</b:Id><b:InteractionKey>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae:2bc363e3-0355-49a1-9c4d-61d8e08bb822:55aa40c0-7498-452a-b45b-52f39cf002c5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow รายการรายวิชา Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายการรายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>55aa40c0-7498-452a-b45b-52f39cf002c5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S8f5955920-e121-4620-becd-c3deca0362849ae6d984-7471-4202-b0ce-5256fd8999d2c6386458-3bb0-42ae-a01e-5cc88646a797</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>9ae6d984-7471-4202-b0ce-5256fd8999d2</b:FlowGuid><b:Id>727</b:Id><b:InteractionKey>f5955920-e121-4620-becd-c3deca036284:9ae6d984-7471-4202-b0ce-5256fd8999d2:c6386458-3bb0-42ae-a01e-5cc88646a797</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of the ผู้สอน External Destination Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้สอน may be spoofed by an attacker and this may lead to data being sent to the attacker's target instead of ผู้สอน. Consider using a standard authentication mechanism to identify the external entity.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอดูผลและรายงาน ช่วงเกรด · คำสั่งตัดเกรด การปรับเกรดพร้อมเหตุผล</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f5955920-e121-4620-becd-c3deca036284</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S8</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R7f5955920-e121-4620-becd-c3deca0362849ae6d984-7471-4202-b0ce-5256fd8999d2c6386458-3bb0-42ae-a01e-5cc88646a797</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>9ae6d984-7471-4202-b0ce-5256fd8999d2</b:FlowGuid><b:Id>728</b:Id><b:InteractionKey>f5955920-e121-4620-becd-c3deca036284:9ae6d984-7471-4202-b0ce-5256fd8999d2:c6386458-3bb0-42ae-a01e-5cc88646a797</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>External Entity ผู้สอน Potentially Denies Receiving Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้สอน claims that it did not receive data from a process on the other side of the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอดูผลและรายงาน ช่วงเกรด · คำสั่งตัดเกรด การปรับเกรดพร้อมเหตุผล</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f5955920-e121-4620-becd-c3deca036284</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4f5955920-e121-4620-becd-c3deca0362849ae6d984-7471-4202-b0ce-5256fd8999d2c6386458-3bb0-42ae-a01e-5cc88646a797</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>9ae6d984-7471-4202-b0ce-5256fd8999d2</b:FlowGuid><b:Id>729</b:Id><b:InteractionKey>f5955920-e121-4620-becd-c3deca036284:9ae6d984-7471-4202-b0ce-5256fd8999d2:c6386458-3bb0-42ae-a01e-5cc88646a797</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow คำขอดูผลและรายงาน ช่วงเกรด · คำสั่งตัดเกรด การปรับเกรดพร้อมเหตุผล Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอดูผลและรายงาน ช่วงเกรด · คำสั่งตัดเกรด การปรับเกรดพร้อมเหตุผล</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f5955920-e121-4620-becd-c3deca036284</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S28d1b0bf0-4bb6-4289-ad4e-335a4211e207f9639285-2cb6-40b4-bd4f-d4fab5605e3f74c38d87-e600-4de7-9224-3773aa1a4fc2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>f9639285-2cb6-40b4-bd4f-d4fab5605e3f</b:FlowGuid><b:Id>730</b:Id><b:InteractionKey>8d1b0bf0-4bb6-4289-ad4e-335a4211e207:f9639285-2cb6-40b4-bd4f-d4fab5605e3f:74c38d87-e600-4de7-9224-3773aa1a4fc2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the 4.1 แสดงตารางคะแนน และออกแบบฟอร์ม Excel Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>4.1 แสดงตารางคะแนน และออกแบบฟอร์ม Excel may be spoofed by an attacker and this may lead to information disclosure by ผู้สอน. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ตารางคะแนน · แบบฟอร์ม Excel</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>8d1b0bf0-4bb6-4289-ad4e-335a4211e207</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>74c38d87-e600-4de7-9224-3773aa1a4fc2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T18d1b0bf0-4bb6-4289-ad4e-335a4211e207f9639285-2cb6-40b4-bd4f-d4fab5605e3f74c38d87-e600-4de7-9224-3773aa1a4fc2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>f9639285-2cb6-40b4-bd4f-d4fab5605e3f</b:FlowGuid><b:Id>731</b:Id><b:InteractionKey>8d1b0bf0-4bb6-4289-ad4e-335a4211e207:f9639285-2cb6-40b4-bd4f-d4fab5605e3f:74c38d87-e600-4de7-9224-3773aa1a4fc2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Lack of Input Validation for 4.1 แสดงตารางคะแนน และออกแบบฟอร์ม Excel</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across ตารางคะแนน · แบบฟอร์ม Excel may be tampered with by an attacker. This may lead to a denial of service attack against 4.1 แสดงตารางคะแนน และออกแบบฟอร์ม Excel or an elevation of privilege attack against 4.1 แสดงตารางคะแนน และออกแบบฟอร์ม Excel or an information disclosure by 4.1 แสดงตารางคะแนน และออกแบบฟอร์ม Excel. Failure to verify that input is as expected is a root cause of a very large number of exploitable issues. Consider all paths and the way they handle data. Verify that all input is verified for correctness using an approved list input validation approach.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ตารางคะแนน · แบบฟอร์ม Excel</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>8d1b0bf0-4bb6-4289-ad4e-335a4211e207</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>74c38d87-e600-4de7-9224-3773aa1a4fc2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R68d1b0bf0-4bb6-4289-ad4e-335a4211e207f9639285-2cb6-40b4-bd4f-d4fab5605e3f74c38d87-e600-4de7-9224-3773aa1a4fc2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>f9639285-2cb6-40b4-bd4f-d4fab5605e3f</b:FlowGuid><b:Id>732</b:Id><b:InteractionKey>8d1b0bf0-4bb6-4289-ad4e-335a4211e207:f9639285-2cb6-40b4-bd4f-d4fab5605e3f:74c38d87-e600-4de7-9224-3773aa1a4fc2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by 4.1 แสดงตารางคะแนน และออกแบบฟอร์ม Excel</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>4.1 แสดงตารางคะแนน และออกแบบฟอร์ม Excel claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ตารางคะแนน · แบบฟอร์ม Excel</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>8d1b0bf0-4bb6-4289-ad4e-335a4211e207</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>74c38d87-e600-4de7-9224-3773aa1a4fc2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I68d1b0bf0-4bb6-4289-ad4e-335a4211e207f9639285-2cb6-40b4-bd4f-d4fab5605e3f74c38d87-e600-4de7-9224-3773aa1a4fc2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>f9639285-2cb6-40b4-bd4f-d4fab5605e3f</b:FlowGuid><b:Id>733</b:Id><b:InteractionKey>8d1b0bf0-4bb6-4289-ad4e-335a4211e207:f9639285-2cb6-40b4-bd4f-d4fab5605e3f:74c38d87-e600-4de7-9224-3773aa1a4fc2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across ตารางคะแนน · แบบฟอร์ม Excel may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ตารางคะแนน · แบบฟอร์ม Excel</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>8d1b0bf0-4bb6-4289-ad4e-335a4211e207</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>74c38d87-e600-4de7-9224-3773aa1a4fc2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D38d1b0bf0-4bb6-4289-ad4e-335a4211e207f9639285-2cb6-40b4-bd4f-d4fab5605e3f74c38d87-e600-4de7-9224-3773aa1a4fc2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>f9639285-2cb6-40b4-bd4f-d4fab5605e3f</b:FlowGuid><b:Id>734</b:Id><b:InteractionKey>8d1b0bf0-4bb6-4289-ad4e-335a4211e207:f9639285-2cb6-40b4-bd4f-d4fab5605e3f:74c38d87-e600-4de7-9224-3773aa1a4fc2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for 4.1 แสดงตารางคะแนน และออกแบบฟอร์ม Excel</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>4.1 แสดงตารางคะแนน และออกแบบฟอร์ม Excel crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ตารางคะแนน · แบบฟอร์ม Excel</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>8d1b0bf0-4bb6-4289-ad4e-335a4211e207</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>74c38d87-e600-4de7-9224-3773aa1a4fc2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D48d1b0bf0-4bb6-4289-ad4e-335a4211e207f9639285-2cb6-40b4-bd4f-d4fab5605e3f74c38d87-e600-4de7-9224-3773aa1a4fc2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>f9639285-2cb6-40b4-bd4f-d4fab5605e3f</b:FlowGuid><b:Id>735</b:Id><b:InteractionKey>8d1b0bf0-4bb6-4289-ad4e-335a4211e207:f9639285-2cb6-40b4-bd4f-d4fab5605e3f:74c38d87-e600-4de7-9224-3773aa1a4fc2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow ตารางคะแนน · แบบฟอร์ม Excel Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ตารางคะแนน · แบบฟอร์ม Excel</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>8d1b0bf0-4bb6-4289-ad4e-335a4211e207</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>74c38d87-e600-4de7-9224-3773aa1a4fc2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E68d1b0bf0-4bb6-4289-ad4e-335a4211e207f9639285-2cb6-40b4-bd4f-d4fab5605e3f74c38d87-e600-4de7-9224-3773aa1a4fc2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>f9639285-2cb6-40b4-bd4f-d4fab5605e3f</b:FlowGuid><b:Id>736</b:Id><b:InteractionKey>8d1b0bf0-4bb6-4289-ad4e-335a4211e207:f9639285-2cb6-40b4-bd4f-d4fab5605e3f:74c38d87-e600-4de7-9224-3773aa1a4fc2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>4.1 แสดงตารางคะแนน และออกแบบฟอร์ม Excel May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้สอน may be able to remotely execute code for 4.1 แสดงตารางคะแนน และออกแบบฟอร์ม Excel.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ตารางคะแนน · แบบฟอร์ม Excel</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>8d1b0bf0-4bb6-4289-ad4e-335a4211e207</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>74c38d87-e600-4de7-9224-3773aa1a4fc2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E78d1b0bf0-4bb6-4289-ad4e-335a4211e207f9639285-2cb6-40b4-bd4f-d4fab5605e3f74c38d87-e600-4de7-9224-3773aa1a4fc2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>f9639285-2cb6-40b4-bd4f-d4fab5605e3f</b:FlowGuid><b:Id>737</b:Id><b:InteractionKey>8d1b0bf0-4bb6-4289-ad4e-335a4211e207:f9639285-2cb6-40b4-bd4f-d4fab5605e3f:74c38d87-e600-4de7-9224-3773aa1a4fc2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in 4.1 แสดงตารางคะแนน และออกแบบฟอร์ม Excel</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into 4.1 แสดงตารางคะแนน และออกแบบฟอร์ม Excel in order to change the flow of program execution within 4.1 แสดงตารางคะแนน และออกแบบฟอร์ม Excel to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ตารางคะแนน · แบบฟอร์ม Excel</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>8d1b0bf0-4bb6-4289-ad4e-335a4211e207</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>74c38d87-e600-4de7-9224-3773aa1a4fc2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>8404dcf5-bdd8-4902-abc2-3b6c967b02618d1b0bf0-4bb6-4289-ad4e-335a4211e207f9639285-2cb6-40b4-bd4f-d4fab5605e3f74c38d87-e600-4de7-9224-3773aa1a4fc2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>f9639285-2cb6-40b4-bd4f-d4fab5605e3f</b:FlowGuid><b:Id>738</b:Id><b:InteractionKey>8d1b0bf0-4bb6-4289-ad4e-335a4211e207:f9639285-2cb6-40b4-bd4f-d4fab5605e3f:74c38d87-e600-4de7-9224-3773aa1a4fc2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cross Site Request Forgery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Cross-site request forgery (CSRF or XSRF) is a type of attack in which an attacker forces a user's browser to make a forged request to a vulnerable site by exploiting an existing trust relationship between the browser and the vulnerable web site.  In a simple scenario, a user is logged in to web site A using a cookie as a credential.  The other browses to web site B.  Web site B returns a page with a hidden form that posts to web site A.  Since the browser will carry the user's cookie to web site A, web site B now can take any action on web site A, for example, adding an admin to an account.  The attack can be used to exploit any requests that the browser automatically authenticates, e.g. by session cookie, integrated authentication, IP whitelisting, …  The attack can be carried out in many ways such as by luring the victim to a site under control of the attacker, getting the user to click a link in a phishing email, or hacking a reputable web site that the victim will visit. The issue can only be resolved on the server side by requiring that all authenticated state-changing requests include an additional piece of secret payload (canary or CSRF token) which is known only to the legitimate web site and the browser and which is protected in transit through SSL/TLS. See the Forgery Protection property on the flow stencil for a list of mitigations.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ตารางคะแนน · แบบฟอร์ม Excel</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>8d1b0bf0-4bb6-4289-ad4e-335a4211e207</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>74c38d87-e600-4de7-9224-3773aa1a4fc2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>8404dcf5-bdd8-4902-abc2-3b6c967b0261</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S874c38d87-e600-4de7-9224-3773aa1a4fc240f30fc0-8a3c-4dac-9ae4-37d00897cc0a8d1b0bf0-4bb6-4289-ad4e-335a4211e207</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>40f30fc0-8a3c-4dac-9ae4-37d00897cc0a</b:FlowGuid><b:Id>739</b:Id><b:InteractionKey>74c38d87-e600-4de7-9224-3773aa1a4fc2:40f30fc0-8a3c-4dac-9ae4-37d00897cc0a:8d1b0bf0-4bb6-4289-ad4e-335a4211e207</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of the ผู้สอน External Destination Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้สอน may be spoofed by an attacker and this may lead to data being sent to the attacker's target instead of ผู้สอน. Consider using a standard authentication mechanism to identify the external entity.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอดูตารางคะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>74c38d87-e600-4de7-9224-3773aa1a4fc2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>8d1b0bf0-4bb6-4289-ad4e-335a4211e207</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S8</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R774c38d87-e600-4de7-9224-3773aa1a4fc240f30fc0-8a3c-4dac-9ae4-37d00897cc0a8d1b0bf0-4bb6-4289-ad4e-335a4211e207</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>40f30fc0-8a3c-4dac-9ae4-37d00897cc0a</b:FlowGuid><b:Id>740</b:Id><b:InteractionKey>74c38d87-e600-4de7-9224-3773aa1a4fc2:40f30fc0-8a3c-4dac-9ae4-37d00897cc0a:8d1b0bf0-4bb6-4289-ad4e-335a4211e207</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>External Entity ผู้สอน Potentially Denies Receiving Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้สอน claims that it did not receive data from a process on the other side of the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอดูตารางคะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>74c38d87-e600-4de7-9224-3773aa1a4fc2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>8d1b0bf0-4bb6-4289-ad4e-335a4211e207</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D474c38d87-e600-4de7-9224-3773aa1a4fc240f30fc0-8a3c-4dac-9ae4-37d00897cc0a8d1b0bf0-4bb6-4289-ad4e-335a4211e207</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>40f30fc0-8a3c-4dac-9ae4-37d00897cc0a</b:FlowGuid><b:Id>741</b:Id><b:InteractionKey>74c38d87-e600-4de7-9224-3773aa1a4fc2:40f30fc0-8a3c-4dac-9ae4-37d00897cc0a:8d1b0bf0-4bb6-4289-ad4e-335a4211e207</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow คำขอดูตารางคะแนน Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอดูตารางคะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>74c38d87-e600-4de7-9224-3773aa1a4fc2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>8d1b0bf0-4bb6-4289-ad4e-335a4211e207</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S28d1b0bf0-4bb6-4289-ad4e-335a4211e20728e292c9-b87b-4cd9-990b-d3db49644526ef2f69e0-387e-4a7c-9107-ef304a699d51</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>28e292c9-b87b-4cd9-990b-d3db49644526</b:FlowGuid><b:Id>742</b:Id><b:InteractionKey>8d1b0bf0-4bb6-4289-ad4e-335a4211e207:28e292c9-b87b-4cd9-990b-d3db49644526:ef2f69e0-387e-4a7c-9107-ef304a699d51</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the 4.2 ตรวจและบันทึกคะแนน Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>4.2 ตรวจและบันทึกคะแนน may be spoofed by an attacker and this may lead to information disclosure by ผู้สอน. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนน (กรอกเองหรือไฟล์ Excel)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>8d1b0bf0-4bb6-4289-ad4e-335a4211e207</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ef2f69e0-387e-4a7c-9107-ef304a699d51</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T18d1b0bf0-4bb6-4289-ad4e-335a4211e20728e292c9-b87b-4cd9-990b-d3db49644526ef2f69e0-387e-4a7c-9107-ef304a699d51</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>28e292c9-b87b-4cd9-990b-d3db49644526</b:FlowGuid><b:Id>743</b:Id><b:InteractionKey>8d1b0bf0-4bb6-4289-ad4e-335a4211e207:28e292c9-b87b-4cd9-990b-d3db49644526:ef2f69e0-387e-4a7c-9107-ef304a699d51</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Lack of Input Validation for 4.2 ตรวจและบันทึกคะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across คะแนน (กรอกเองหรือไฟล์ Excel) may be tampered with by an attacker. This may lead to a denial of service attack against 4.2 ตรวจและบันทึกคะแนน or an elevation of privilege attack against 4.2 ตรวจและบันทึกคะแนน or an information disclosure by 4.2 ตรวจและบันทึกคะแนน. Failure to verify that input is as expected is a root cause of a very large number of exploitable issues. Consider all paths and the way they handle data. Verify that all input is verified for correctness using an approved list input validation approach.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนน (กรอกเองหรือไฟล์ Excel)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>8d1b0bf0-4bb6-4289-ad4e-335a4211e207</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ef2f69e0-387e-4a7c-9107-ef304a699d51</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R68d1b0bf0-4bb6-4289-ad4e-335a4211e20728e292c9-b87b-4cd9-990b-d3db49644526ef2f69e0-387e-4a7c-9107-ef304a699d51</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>28e292c9-b87b-4cd9-990b-d3db49644526</b:FlowGuid><b:Id>744</b:Id><b:InteractionKey>8d1b0bf0-4bb6-4289-ad4e-335a4211e207:28e292c9-b87b-4cd9-990b-d3db49644526:ef2f69e0-387e-4a7c-9107-ef304a699d51</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by 4.2 ตรวจและบันทึกคะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>4.2 ตรวจและบันทึกคะแนน claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนน (กรอกเองหรือไฟล์ Excel)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>8d1b0bf0-4bb6-4289-ad4e-335a4211e207</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ef2f69e0-387e-4a7c-9107-ef304a699d51</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I68d1b0bf0-4bb6-4289-ad4e-335a4211e20728e292c9-b87b-4cd9-990b-d3db49644526ef2f69e0-387e-4a7c-9107-ef304a699d51</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>28e292c9-b87b-4cd9-990b-d3db49644526</b:FlowGuid><b:Id>745</b:Id><b:InteractionKey>8d1b0bf0-4bb6-4289-ad4e-335a4211e207:28e292c9-b87b-4cd9-990b-d3db49644526:ef2f69e0-387e-4a7c-9107-ef304a699d51</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across คะแนน (กรอกเองหรือไฟล์ Excel) may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนน (กรอกเองหรือไฟล์ Excel)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>8d1b0bf0-4bb6-4289-ad4e-335a4211e207</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ef2f69e0-387e-4a7c-9107-ef304a699d51</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D38d1b0bf0-4bb6-4289-ad4e-335a4211e20728e292c9-b87b-4cd9-990b-d3db49644526ef2f69e0-387e-4a7c-9107-ef304a699d51</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>28e292c9-b87b-4cd9-990b-d3db49644526</b:FlowGuid><b:Id>746</b:Id><b:InteractionKey>8d1b0bf0-4bb6-4289-ad4e-335a4211e207:28e292c9-b87b-4cd9-990b-d3db49644526:ef2f69e0-387e-4a7c-9107-ef304a699d51</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for 4.2 ตรวจและบันทึกคะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>4.2 ตรวจและบันทึกคะแนน crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนน (กรอกเองหรือไฟล์ Excel)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>8d1b0bf0-4bb6-4289-ad4e-335a4211e207</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ef2f69e0-387e-4a7c-9107-ef304a699d51</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D48d1b0bf0-4bb6-4289-ad4e-335a4211e20728e292c9-b87b-4cd9-990b-d3db49644526ef2f69e0-387e-4a7c-9107-ef304a699d51</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>28e292c9-b87b-4cd9-990b-d3db49644526</b:FlowGuid><b:Id>747</b:Id><b:InteractionKey>8d1b0bf0-4bb6-4289-ad4e-335a4211e207:28e292c9-b87b-4cd9-990b-d3db49644526:ef2f69e0-387e-4a7c-9107-ef304a699d51</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow คะแนน (กรอกเองหรือไฟล์ Excel) Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนน (กรอกเองหรือไฟล์ Excel)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>8d1b0bf0-4bb6-4289-ad4e-335a4211e207</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ef2f69e0-387e-4a7c-9107-ef304a699d51</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E68d1b0bf0-4bb6-4289-ad4e-335a4211e20728e292c9-b87b-4cd9-990b-d3db49644526ef2f69e0-387e-4a7c-9107-ef304a699d51</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>28e292c9-b87b-4cd9-990b-d3db49644526</b:FlowGuid><b:Id>748</b:Id><b:InteractionKey>8d1b0bf0-4bb6-4289-ad4e-335a4211e207:28e292c9-b87b-4cd9-990b-d3db49644526:ef2f69e0-387e-4a7c-9107-ef304a699d51</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>4.2 ตรวจและบันทึกคะแนน May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้สอน may be able to remotely execute code for 4.2 ตรวจและบันทึกคะแนน.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนน (กรอกเองหรือไฟล์ Excel)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>8d1b0bf0-4bb6-4289-ad4e-335a4211e207</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ef2f69e0-387e-4a7c-9107-ef304a699d51</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E78d1b0bf0-4bb6-4289-ad4e-335a4211e20728e292c9-b87b-4cd9-990b-d3db49644526ef2f69e0-387e-4a7c-9107-ef304a699d51</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>28e292c9-b87b-4cd9-990b-d3db49644526</b:FlowGuid><b:Id>749</b:Id><b:InteractionKey>8d1b0bf0-4bb6-4289-ad4e-335a4211e207:28e292c9-b87b-4cd9-990b-d3db49644526:ef2f69e0-387e-4a7c-9107-ef304a699d51</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in 4.2 ตรวจและบันทึกคะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into 4.2 ตรวจและบันทึกคะแนน in order to change the flow of program execution within 4.2 ตรวจและบันทึกคะแนน to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนน (กรอกเองหรือไฟล์ Excel)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>8d1b0bf0-4bb6-4289-ad4e-335a4211e207</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ef2f69e0-387e-4a7c-9107-ef304a699d51</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>8404dcf5-bdd8-4902-abc2-3b6c967b02618d1b0bf0-4bb6-4289-ad4e-335a4211e20728e292c9-b87b-4cd9-990b-d3db49644526ef2f69e0-387e-4a7c-9107-ef304a699d51</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>28e292c9-b87b-4cd9-990b-d3db49644526</b:FlowGuid><b:Id>750</b:Id><b:InteractionKey>8d1b0bf0-4bb6-4289-ad4e-335a4211e207:28e292c9-b87b-4cd9-990b-d3db49644526:ef2f69e0-387e-4a7c-9107-ef304a699d51</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cross Site Request Forgery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Cross-site request forgery (CSRF or XSRF) is a type of attack in which an attacker forces a user's browser to make a forged request to a vulnerable site by exploiting an existing trust relationship between the browser and the vulnerable web site.  In a simple scenario, a user is logged in to web site A using a cookie as a credential.  The other browses to web site B.  Web site B returns a page with a hidden form that posts to web site A.  Since the browser will carry the user's cookie to web site A, web site B now can take any action on web site A, for example, adding an admin to an account.  The attack can be used to exploit any requests that the browser automatically authenticates, e.g. by session cookie, integrated authentication, IP whitelisting, …  The attack can be carried out in many ways such as by luring the victim to a site under control of the attacker, getting the user to click a link in a phishing email, or hacking a reputable web site that the victim will visit. The issue can only be resolved on the server side by requiring that all authenticated state-changing requests include an additional piece of secret payload (canary or CSRF token) which is known only to the legitimate web site and the browser and which is protected in transit through SSL/TLS. See the Forgery Protection property on the flow stencil for a list of mitigations.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนน (กรอกเองหรือไฟล์ Excel)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>8d1b0bf0-4bb6-4289-ad4e-335a4211e207</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ef2f69e0-387e-4a7c-9107-ef304a699d51</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>8404dcf5-bdd8-4902-abc2-3b6c967b0261</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S8ef2f69e0-387e-4a7c-9107-ef304a699d51c7fc563b-0108-4590-8fb9-372886ef20138d1b0bf0-4bb6-4289-ad4e-335a4211e207</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>c7fc563b-0108-4590-8fb9-372886ef2013</b:FlowGuid><b:Id>751</b:Id><b:InteractionKey>ef2f69e0-387e-4a7c-9107-ef304a699d51:c7fc563b-0108-4590-8fb9-372886ef2013:8d1b0bf0-4bb6-4289-ad4e-335a4211e207</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of the ผู้สอน External Destination Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้สอน may be spoofed by an attacker and this may lead to data being sent to the attacker's target instead of ผู้สอน. Consider using a standard authentication mechanism to identify the external entity.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ผลการบันทึก · ผลตรวจไฟล์</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ef2f69e0-387e-4a7c-9107-ef304a699d51</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>8d1b0bf0-4bb6-4289-ad4e-335a4211e207</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S8</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R7ef2f69e0-387e-4a7c-9107-ef304a699d51c7fc563b-0108-4590-8fb9-372886ef20138d1b0bf0-4bb6-4289-ad4e-335a4211e207</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>c7fc563b-0108-4590-8fb9-372886ef2013</b:FlowGuid><b:Id>752</b:Id><b:InteractionKey>ef2f69e0-387e-4a7c-9107-ef304a699d51:c7fc563b-0108-4590-8fb9-372886ef2013:8d1b0bf0-4bb6-4289-ad4e-335a4211e207</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>External Entity ผู้สอน Potentially Denies Receiving Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้สอน claims that it did not receive data from a process on the other side of the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ผลการบันทึก · ผลตรวจไฟล์</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ef2f69e0-387e-4a7c-9107-ef304a699d51</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>8d1b0bf0-4bb6-4289-ad4e-335a4211e207</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4ef2f69e0-387e-4a7c-9107-ef304a699d51c7fc563b-0108-4590-8fb9-372886ef20138d1b0bf0-4bb6-4289-ad4e-335a4211e207</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>c7fc563b-0108-4590-8fb9-372886ef2013</b:FlowGuid><b:Id>753</b:Id><b:InteractionKey>ef2f69e0-387e-4a7c-9107-ef304a699d51:c7fc563b-0108-4590-8fb9-372886ef2013:8d1b0bf0-4bb6-4289-ad4e-335a4211e207</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow ผลการบันทึก · ผลตรวจไฟล์ Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ผลการบันทึก · ผลตรวจไฟล์</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ef2f69e0-387e-4a7c-9107-ef304a699d51</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>8d1b0bf0-4bb6-4289-ad4e-335a4211e207</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S174c38d87-e600-4de7-9224-3773aa1a4fc215b4aeca-a1d6-4285-9602-cbcde66c21b2152a9786-c3ef-4613-b437-300884f70771</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>15b4aeca-a1d6-4285-9602-cbcde66c21b2</b:FlowGuid><b:Id>754</b:Id><b:InteractionKey>74c38d87-e600-4de7-9224-3773aa1a4fc2:15b4aeca-a1d6-4285-9602-cbcde66c21b2:152a9786-c3ef-4613-b437-300884f70771</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the 4.1 แสดงตารางคะแนน และออกแบบฟอร์ม Excel Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>4.1 แสดงตารางคะแนน และออกแบบฟอร์ม Excel may be spoofed by an attacker and this may lead to unauthorized access to D3 CLO กิจกรรม และเกณฑ์. Consider using a standard authentication mechanism to identify the source process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอรายการกิจกรรม</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>74c38d87-e600-4de7-9224-3773aa1a4fc2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>152a9786-c3ef-4613-b437-300884f70771</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T1874c38d87-e600-4de7-9224-3773aa1a4fc215b4aeca-a1d6-4285-9602-cbcde66c21b2152a9786-c3ef-4613-b437-300884f70771</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>15b4aeca-a1d6-4285-9602-cbcde66c21b2</b:FlowGuid><b:Id>755</b:Id><b:InteractionKey>74c38d87-e600-4de7-9224-3773aa1a4fc2:15b4aeca-a1d6-4285-9602-cbcde66c21b2:152a9786-c3ef-4613-b437-300884f70771</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>The D3 CLO กิจกรรม และเกณฑ์ Data Store Could Be Corrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across คำขอรายการกิจกรรม may be tampered with by an attacker. This may lead to corruption of D3 CLO กิจกรรม และเกณฑ์. Ensure the integrity of the data flow to the data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอรายการกิจกรรม</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>74c38d87-e600-4de7-9224-3773aa1a4fc2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>152a9786-c3ef-4613-b437-300884f70771</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T18</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R874c38d87-e600-4de7-9224-3773aa1a4fc215b4aeca-a1d6-4285-9602-cbcde66c21b2152a9786-c3ef-4613-b437-300884f70771</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>15b4aeca-a1d6-4285-9602-cbcde66c21b2</b:FlowGuid><b:Id>756</b:Id><b:InteractionKey>74c38d87-e600-4de7-9224-3773aa1a4fc2:15b4aeca-a1d6-4285-9602-cbcde66c21b2:152a9786-c3ef-4613-b437-300884f70771</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Denies D3 CLO กิจกรรม และเกณฑ์ Potentially Writing Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D3 CLO กิจกรรม และเกณฑ์ claims that it did not write data received from an entity on the other side of the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอรายการกิจกรรม</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>74c38d87-e600-4de7-9224-3773aa1a4fc2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>152a9786-c3ef-4613-b437-300884f70771</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R8</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I674c38d87-e600-4de7-9224-3773aa1a4fc215b4aeca-a1d6-4285-9602-cbcde66c21b2152a9786-c3ef-4613-b437-300884f70771</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>15b4aeca-a1d6-4285-9602-cbcde66c21b2</b:FlowGuid><b:Id>757</b:Id><b:InteractionKey>74c38d87-e600-4de7-9224-3773aa1a4fc2:15b4aeca-a1d6-4285-9602-cbcde66c21b2:152a9786-c3ef-4613-b437-300884f70771</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across คำขอรายการกิจกรรม may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอรายการกิจกรรม</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>74c38d87-e600-4de7-9224-3773aa1a4fc2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>152a9786-c3ef-4613-b437-300884f70771</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D474c38d87-e600-4de7-9224-3773aa1a4fc215b4aeca-a1d6-4285-9602-cbcde66c21b2152a9786-c3ef-4613-b437-300884f70771</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>15b4aeca-a1d6-4285-9602-cbcde66c21b2</b:FlowGuid><b:Id>758</b:Id><b:InteractionKey>74c38d87-e600-4de7-9224-3773aa1a4fc2:15b4aeca-a1d6-4285-9602-cbcde66c21b2:152a9786-c3ef-4613-b437-300884f70771</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow คำขอรายการกิจกรรม Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอรายการกิจกรรม</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>74c38d87-e600-4de7-9224-3773aa1a4fc2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>152a9786-c3ef-4613-b437-300884f70771</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D574c38d87-e600-4de7-9224-3773aa1a4fc215b4aeca-a1d6-4285-9602-cbcde66c21b2152a9786-c3ef-4613-b437-300884f70771</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>15b4aeca-a1d6-4285-9602-cbcde66c21b2</b:FlowGuid><b:Id>759</b:Id><b:InteractionKey>74c38d87-e600-4de7-9224-3773aa1a4fc2:15b4aeca-a1d6-4285-9602-cbcde66c21b2:152a9786-c3ef-4613-b437-300884f70771</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Inaccessible</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent prevents access to a data store on the other side of the trust boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอรายการกิจกรรม</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>74c38d87-e600-4de7-9224-3773aa1a4fc2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>152a9786-c3ef-4613-b437-300884f70771</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S2152a9786-c3ef-4613-b437-300884f707715096bc36-0f1d-4dfd-8d86-346d4021658774c38d87-e600-4de7-9224-3773aa1a4fc2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>5096bc36-0f1d-4dfd-8d86-346d40216587</b:FlowGuid><b:Id>760</b:Id><b:InteractionKey>152a9786-c3ef-4613-b437-300884f70771:5096bc36-0f1d-4dfd-8d86-346d40216587:74c38d87-e600-4de7-9224-3773aa1a4fc2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the 4.1 แสดงตารางคะแนน และออกแบบฟอร์ม Excel Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>4.1 แสดงตารางคะแนน และออกแบบฟอร์ม Excel may be spoofed by an attacker and this may lead to information disclosure by D3 CLO กิจกรรม และเกณฑ์. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>กิจกรรมและคะแนนเต็ม</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>152a9786-c3ef-4613-b437-300884f70771</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>74c38d87-e600-4de7-9224-3773aa1a4fc2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R6152a9786-c3ef-4613-b437-300884f707715096bc36-0f1d-4dfd-8d86-346d4021658774c38d87-e600-4de7-9224-3773aa1a4fc2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>5096bc36-0f1d-4dfd-8d86-346d40216587</b:FlowGuid><b:Id>761</b:Id><b:InteractionKey>152a9786-c3ef-4613-b437-300884f70771:5096bc36-0f1d-4dfd-8d86-346d40216587:74c38d87-e600-4de7-9224-3773aa1a4fc2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by 4.1 แสดงตารางคะแนน และออกแบบฟอร์ม Excel</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>4.1 แสดงตารางคะแนน และออกแบบฟอร์ม Excel claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>กิจกรรมและคะแนนเต็ม</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>152a9786-c3ef-4613-b437-300884f70771</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>74c38d87-e600-4de7-9224-3773aa1a4fc2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D3152a9786-c3ef-4613-b437-300884f707715096bc36-0f1d-4dfd-8d86-346d4021658774c38d87-e600-4de7-9224-3773aa1a4fc2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>5096bc36-0f1d-4dfd-8d86-346d40216587</b:FlowGuid><b:Id>762</b:Id><b:InteractionKey>152a9786-c3ef-4613-b437-300884f70771:5096bc36-0f1d-4dfd-8d86-346d40216587:74c38d87-e600-4de7-9224-3773aa1a4fc2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for 4.1 แสดงตารางคะแนน และออกแบบฟอร์ม Excel</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>4.1 แสดงตารางคะแนน และออกแบบฟอร์ม Excel crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>กิจกรรมและคะแนนเต็ม</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>152a9786-c3ef-4613-b437-300884f70771</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>74c38d87-e600-4de7-9224-3773aa1a4fc2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4152a9786-c3ef-4613-b437-300884f707715096bc36-0f1d-4dfd-8d86-346d4021658774c38d87-e600-4de7-9224-3773aa1a4fc2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>5096bc36-0f1d-4dfd-8d86-346d40216587</b:FlowGuid><b:Id>763</b:Id><b:InteractionKey>152a9786-c3ef-4613-b437-300884f70771:5096bc36-0f1d-4dfd-8d86-346d40216587:74c38d87-e600-4de7-9224-3773aa1a4fc2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow กิจกรรมและคะแนนเต็ม Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>กิจกรรมและคะแนนเต็ม</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>152a9786-c3ef-4613-b437-300884f70771</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>74c38d87-e600-4de7-9224-3773aa1a4fc2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D5152a9786-c3ef-4613-b437-300884f707715096bc36-0f1d-4dfd-8d86-346d4021658774c38d87-e600-4de7-9224-3773aa1a4fc2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>5096bc36-0f1d-4dfd-8d86-346d40216587</b:FlowGuid><b:Id>764</b:Id><b:InteractionKey>152a9786-c3ef-4613-b437-300884f70771:5096bc36-0f1d-4dfd-8d86-346d40216587:74c38d87-e600-4de7-9224-3773aa1a4fc2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Inaccessible</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent prevents access to a data store on the other side of the trust boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>กิจกรรมและคะแนนเต็ม</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>152a9786-c3ef-4613-b437-300884f70771</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>74c38d87-e600-4de7-9224-3773aa1a4fc2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E6152a9786-c3ef-4613-b437-300884f707715096bc36-0f1d-4dfd-8d86-346d4021658774c38d87-e600-4de7-9224-3773aa1a4fc2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>5096bc36-0f1d-4dfd-8d86-346d40216587</b:FlowGuid><b:Id>765</b:Id><b:InteractionKey>152a9786-c3ef-4613-b437-300884f70771:5096bc36-0f1d-4dfd-8d86-346d40216587:74c38d87-e600-4de7-9224-3773aa1a4fc2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>4.1 แสดงตารางคะแนน และออกแบบฟอร์ม Excel May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D3 CLO กิจกรรม และเกณฑ์ may be able to remotely execute code for 4.1 แสดงตารางคะแนน และออกแบบฟอร์ม Excel.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>กิจกรรมและคะแนนเต็ม</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>152a9786-c3ef-4613-b437-300884f70771</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>74c38d87-e600-4de7-9224-3773aa1a4fc2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E7152a9786-c3ef-4613-b437-300884f707715096bc36-0f1d-4dfd-8d86-346d4021658774c38d87-e600-4de7-9224-3773aa1a4fc2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>5096bc36-0f1d-4dfd-8d86-346d40216587</b:FlowGuid><b:Id>766</b:Id><b:InteractionKey>152a9786-c3ef-4613-b437-300884f70771:5096bc36-0f1d-4dfd-8d86-346d40216587:74c38d87-e600-4de7-9224-3773aa1a4fc2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in 4.1 แสดงตารางคะแนน และออกแบบฟอร์ม Excel</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into 4.1 แสดงตารางคะแนน และออกแบบฟอร์ม Excel in order to change the flow of program execution within 4.1 แสดงตารางคะแนน และออกแบบฟอร์ม Excel to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>กิจกรรมและคะแนนเต็ม</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>152a9786-c3ef-4613-b437-300884f70771</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>74c38d87-e600-4de7-9224-3773aa1a4fc2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S174c38d87-e600-4de7-9224-3773aa1a4fc223dcccb1-445d-4a7f-a998-f5b97d6c78c50d64a30e-10bc-40e3-99d4-da420c7b6c17</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>23dcccb1-445d-4a7f-a998-f5b97d6c78c5</b:FlowGuid><b:Id>767</b:Id><b:InteractionKey>74c38d87-e600-4de7-9224-3773aa1a4fc2:23dcccb1-445d-4a7f-a998-f5b97d6c78c5:0d64a30e-10bc-40e3-99d4-da420c7b6c17</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the 4.1 แสดงตารางคะแนน และออกแบบฟอร์ม Excel Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>4.1 แสดงตารางคะแนน และออกแบบฟอร์ม Excel may be spoofed by an attacker and this may lead to unauthorized access to D4 นักศึกษา. Consider using a standard authentication mechanism to identify the source process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอคะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>74c38d87-e600-4de7-9224-3773aa1a4fc2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>0d64a30e-10bc-40e3-99d4-da420c7b6c17</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T1874c38d87-e600-4de7-9224-3773aa1a4fc223dcccb1-445d-4a7f-a998-f5b97d6c78c50d64a30e-10bc-40e3-99d4-da420c7b6c17</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>23dcccb1-445d-4a7f-a998-f5b97d6c78c5</b:FlowGuid><b:Id>768</b:Id><b:InteractionKey>74c38d87-e600-4de7-9224-3773aa1a4fc2:23dcccb1-445d-4a7f-a998-f5b97d6c78c5:0d64a30e-10bc-40e3-99d4-da420c7b6c17</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>The D4 นักศึกษา Data Store Could Be Corrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across คำขอคะแนน may be tampered with by an attacker. This may lead to corruption of D4 นักศึกษา. Ensure the integrity of the data flow to the data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอคะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>74c38d87-e600-4de7-9224-3773aa1a4fc2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>0d64a30e-10bc-40e3-99d4-da420c7b6c17</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T18</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R874c38d87-e600-4de7-9224-3773aa1a4fc223dcccb1-445d-4a7f-a998-f5b97d6c78c50d64a30e-10bc-40e3-99d4-da420c7b6c17</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>23dcccb1-445d-4a7f-a998-f5b97d6c78c5</b:FlowGuid><b:Id>769</b:Id><b:InteractionKey>74c38d87-e600-4de7-9224-3773aa1a4fc2:23dcccb1-445d-4a7f-a998-f5b97d6c78c5:0d64a30e-10bc-40e3-99d4-da420c7b6c17</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Denies D4 นักศึกษา Potentially Writing Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D4 นักศึกษา claims that it did not write data received from an entity on the other side of the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอคะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>74c38d87-e600-4de7-9224-3773aa1a4fc2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>0d64a30e-10bc-40e3-99d4-da420c7b6c17</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R8</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I674c38d87-e600-4de7-9224-3773aa1a4fc223dcccb1-445d-4a7f-a998-f5b97d6c78c50d64a30e-10bc-40e3-99d4-da420c7b6c17</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>23dcccb1-445d-4a7f-a998-f5b97d6c78c5</b:FlowGuid><b:Id>770</b:Id><b:InteractionKey>74c38d87-e600-4de7-9224-3773aa1a4fc2:23dcccb1-445d-4a7f-a998-f5b97d6c78c5:0d64a30e-10bc-40e3-99d4-da420c7b6c17</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across คำขอคะแนน may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอคะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>74c38d87-e600-4de7-9224-3773aa1a4fc2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>0d64a30e-10bc-40e3-99d4-da420c7b6c17</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D474c38d87-e600-4de7-9224-3773aa1a4fc223dcccb1-445d-4a7f-a998-f5b97d6c78c50d64a30e-10bc-40e3-99d4-da420c7b6c17</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>23dcccb1-445d-4a7f-a998-f5b97d6c78c5</b:FlowGuid><b:Id>771</b:Id><b:InteractionKey>74c38d87-e600-4de7-9224-3773aa1a4fc2:23dcccb1-445d-4a7f-a998-f5b97d6c78c5:0d64a30e-10bc-40e3-99d4-da420c7b6c17</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow คำขอคะแนน Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอคะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>74c38d87-e600-4de7-9224-3