="true"/><b:TypeId>D5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E6e22e88b0-3b34-4992-a953-52751e8cfcda0875e831-0b39-4ed3-92ee-31c9983d879ae9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>0875e831-0b39-4ed3-92ee-31c9983d879a</b:FlowGuid><b:Id>908</b:Id><b:InteractionKey>e22e88b0-3b34-4992-a953-52751e8cfcda:0875e831-0b39-4ed3-92ee-31c9983d879a:e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>6.1 ประเมินผล CLO และติดตามนักศึกษา May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D4 นักศึกษา may be able to remotely execute code for 6.1 ประเมินผล CLO และติดตามนักศึกษา.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e22e88b0-3b34-4992-a953-52751e8cfcda</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E7e22e88b0-3b34-4992-a953-52751e8cfcda0875e831-0b39-4ed3-92ee-31c9983d879ae9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>0875e831-0b39-4ed3-92ee-31c9983d879a</b:FlowGuid><b:Id>909</b:Id><b:InteractionKey>e22e88b0-3b34-4992-a953-52751e8cfcda:0875e831-0b39-4ed3-92ee-31c9983d879a:e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in 6.1 ประเมินผล CLO และติดตามนักศึกษา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into 6.1 ประเมินผล CLO และติดตามนักศึกษา in order to change the flow of program execution within 6.1 ประเมินผล CLO และติดตามนักศึกษา to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e22e88b0-3b34-4992-a953-52751e8cfcda</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S230bd1f8e-e311-4fb8-987d-d47f5b757ac1835fc8de-3f0b-4ad1-98c1-5233fdcc14e6b53f4936-2fd9-4b5a-961d-015067f3fd8e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>835fc8de-3f0b-4ad1-98c1-5233fdcc14e6</b:FlowGuid><b:Id>910</b:Id><b:InteractionKey>30bd1f8e-e311-4fb8-987d-d47f5b757ac1:835fc8de-3f0b-4ad1-98c1-5233fdcc14e6:b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the 6.1 ประเมินผล CLO และติดตามนักศึกษา Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>6.1 ประเมินผล CLO และติดตามนักศึกษา may be spoofed by an attacker and this may lead to information disclosure by D3 CLO กิจกรรม และเกณฑ์. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>กิจกรรมและน้ำหนัก</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>30bd1f8e-e311-4fb8-987d-d47f5b757ac1</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R630bd1f8e-e311-4fb8-987d-d47f5b757ac1835fc8de-3f0b-4ad1-98c1-5233fdcc14e6b53f4936-2fd9-4b5a-961d-015067f3fd8e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>835fc8de-3f0b-4ad1-98c1-5233fdcc14e6</b:FlowGuid><b:Id>911</b:Id><b:InteractionKey>30bd1f8e-e311-4fb8-987d-d47f5b757ac1:835fc8de-3f0b-4ad1-98c1-5233fdcc14e6:b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by 6.1 ประเมินผล CLO และติดตามนักศึกษา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>6.1 ประเมินผล CLO และติดตามนักศึกษา claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>กิจกรรมและน้ำหนัก</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>30bd1f8e-e311-4fb8-987d-d47f5b757ac1</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D330bd1f8e-e311-4fb8-987d-d47f5b757ac1835fc8de-3f0b-4ad1-98c1-5233fdcc14e6b53f4936-2fd9-4b5a-961d-015067f3fd8e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>835fc8de-3f0b-4ad1-98c1-5233fdcc14e6</b:FlowGuid><b:Id>912</b:Id><b:InteractionKey>30bd1f8e-e311-4fb8-987d-d47f5b757ac1:835fc8de-3f0b-4ad1-98c1-5233fdcc14e6:b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for 6.1 ประเมินผล CLO และติดตามนักศึกษา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>6.1 ประเมินผล CLO และติดตามนักศึกษา crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>กิจกรรมและน้ำหนัก</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>30bd1f8e-e311-4fb8-987d-d47f5b757ac1</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D430bd1f8e-e311-4fb8-987d-d47f5b757ac1835fc8de-3f0b-4ad1-98c1-5233fdcc14e6b53f4936-2fd9-4b5a-961d-015067f3fd8e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>835fc8de-3f0b-4ad1-98c1-5233fdcc14e6</b:FlowGuid><b:Id>913</b:Id><b:InteractionKey>30bd1f8e-e311-4fb8-987d-d47f5b757ac1:835fc8de-3f0b-4ad1-98c1-5233fdcc14e6:b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow กิจกรรมและน้ำหนัก Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>กิจกรรมและน้ำหนัก</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>30bd1f8e-e311-4fb8-987d-d47f5b757ac1</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D530bd1f8e-e311-4fb8-987d-d47f5b757ac1835fc8de-3f0b-4ad1-98c1-5233fdcc14e6b53f4936-2fd9-4b5a-961d-015067f3fd8e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>835fc8de-3f0b-4ad1-98c1-5233fdcc14e6</b:FlowGuid><b:Id>914</b:Id><b:InteractionKey>30bd1f8e-e311-4fb8-987d-d47f5b757ac1:835fc8de-3f0b-4ad1-98c1-5233fdcc14e6:b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a: