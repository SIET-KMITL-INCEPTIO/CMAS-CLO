/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>4c9185da-98dc-44ea-aaf6-e27a133b3e03</b:FlowGuid><b:Id>513</b:Id><b:InteractionKey>6fbd1295-fff0-4ece-9789-a72e03749475:4c9185da-98dc-44ea-aaf6-e27a133b3e03:0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in 4.0 บันทึกและนำเข้าคะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into 4.0 บันทึกและนำเข้าคะแนน in order to change the flow of program execution within 4.0 บันทึกและนำเข้าคะแนน to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนนที่มีอยู่</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6fbd1295-fff0-4ece-9789-a72e03749475</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S24b62e68d-b4a1-4d7d-b06a-ccd8408fdf75f58d19bb-84e2-492b-9cf6-414b2b7675720a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>f58d19bb-84e2-492b-9cf6-414b2b767572</b:FlowGuid><b:Id>514</b:Id><b:InteractionKey>4b62e68d-b4a1-4d7d-b06a-ccd8408fdf75:f58d19bb-84e2-492b-9cf6-414b2b767572:0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the 4.0 บันทึกและนำเข้าคะแนน Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>4.0 บันทึกและนำเข้าคะแนน may be spoofed by an attacker and this may lead to information disclosure by D3 CLO กิจกรรม และเกณฑ์. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>กิจกรรมและคะแนนเต็ม</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>4b62e68d-b4a1-4d7d-b06a-ccd8408fdf75</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R64b62e68d-b4a1-4d7d-b06a-ccd8408fdf75f58d19bb-84e2-492b-9cf6-414b2b7675720a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>f58d19bb-84e2-492b-9cf6-414b2b767572</b:FlowGuid><b:Id>515</b:Id><b:InteractionKey>4b62e68d-b4a1-4d7d-b06a-ccd8408fdf75:f58d19bb-84e2-492b-9cf6-414b2b767572:0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by 4.0 บันทึกและนำเข้าคะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>4.0 บันทึกและนำเข้าคะแนน claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>กิจกรรมและคะแนนเต็ม</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>4b62e68d-b4a1-4d7d-b06a-ccd8408fdf75</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D34b62e68d-b4a1-4d7d-b06a-ccd8408fdf75f58d19bb-84e2-492b-9cf6-414b2b7675720a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>f58d19bb-84e2-492b-9cf6-414b2b767572</b:FlowGuid><b:Id>516</b:Id><b:InteractionKey>4b62e68d-b4a1-4d7d-b06a-ccd8408fdf75:f58d19bb-84e2-492b-9cf6-414b2b767572:0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for 4.0 บันทึกและนำเข้าคะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>4.0 บันทึกและนำเข้าคะแนน crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>กิจกรรมและคะแนนเต็ม</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyV