eId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7.1f21494b5-dcc7-4d98-9dd9-3c701f15d4fc93bea1a8-2562-4603-81d1-bc5c223facbe1f8976b5-43ee-4f0c-9f16-d8889a8ebe44</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>0df06edf-e481-4ed2-b4c5-4c53b6b2b1e4</b:DrawingSurfaceGuid><b:FlowGuid>93bea1a8-2562-4603-81d1-bc5c223facbe</b:FlowGuid><b:Id>153</b:Id><b:InteractionKey>f21494b5-dcc7-4d98-9dd9-3c701f15d4fc:93bea1a8-2562-4603-81d1-bc5c223facbe:1f8976b5-43ee-4f0c-9f16-d8889a8ebe44</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Destination Data Store D1 บัญชีผู้ใช้</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D1 บัญชีผู้ใช้ may be spoofed by an attacker and this may lead to data being written to the attacker's target instead of D1 บัญชีผู้ใช้. Consider using a standard authentication mechanism to identify the destination data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอรายชื่อผู้สอน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f21494b5-dcc7-4d98-9dd9-3c701f15d4fc</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>1f8976b5-43ee-4f0c-9f16-d8889a8ebe44</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T7f21494b5-dcc7-4d98-9dd9-3c701f15d4fc93bea1a8-2562-4603-81d1-bc5c223facbe1f8976b5-43ee-4f0c-9f16-d8889a8ebe44</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>0df06edf-e481-4ed2-b4c5-4c53b6b2b1e4</b:DrawingSurfaceGuid><b:FlowGuid>93bea1a8-2562-4603-81d1-bc5c223facbe</b:FlowGuid><b:Id>154</b:Id><b:InteractionKey>f21494b5-dcc7-4d98-9dd9-3c701f15d4fc:93bea1a8-2562-4603-81d1-bc5c223facbe:1f8976b5-43ee-4f0c-9f16-d8889a8ebe44</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential SQL Injection Vulnerability for D1 บัญชีผู้ใช้</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>SQL injection is an attack in which malicious code is inserted into strings that are later passed to an instance of SQL Server for parsing and execution. Any procedure that constructs SQL statements should be reviewed for injection vulnerabilities because SQL Server will execute all syntactically valid queries that it receives. Even parameterized data can be manipulated by a skilled and determined attacker.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอรายชื่อผู้สอน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f21494b5-dcc7-4d98-9dd9-3c701f15d4fc</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>1f8976b5-43ee-4f0c-9f16-d8889a8ebe44</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D2f21494b5-dcc7-4d98-9dd9-3c701f15d4fc93bea1a8-2562-4603-81d1-bc5c223facbe1f8976b5-43ee-4f0c-9f16-d8889a8ebe44</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>0df06edf-e481-4ed2-b4c5-4c53b6b2b1e4</b:DrawingSurfaceGuid><b:FlowGuid>93bea1a8-2562-4603-81d1-bc5c223facbe</b:FlowGuid><b:Id>155</b:Id><b:InteractionKey>f21494b5-dcc7-4d98-9dd9-3c701f15d4fc:93bea1a8-2562-4603-81d1-bc5c223facbe:1f8976b5-43ee-4f0c-9f16-d8889a8ebe44</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Excessive Resource Consumption for 2.0 จัดการรายวิชาและผู้สอน or D1 บัญชีผู้ใช้</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does 2.0 จัดการรายวิชาและผู้สอน or D1 บัญชีผู้ใช้ take explicit steps to control resource consumption? Resource consumption attacks can be hard to deal with, and there are times that it makes sense to let the OS do the job. Be careful that your resource requests don't deadlock, and that they do timeout.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอรายชื่อผู้สอน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f21494b5-dcc7-4d98-9dd9-3c701f15d4fc</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>1f8976b5-43ee-4f0c-9f16-d8889a8ebe44</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7.1a8b08151-2c62-4840-b773-a1c5bc9dc8c1368ed06d-90e0-408b-a058-b2b01cc53ba188315e4e-bada-4889-8a5a-ee3cc1a47fb9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>0df06edf-e481-4ed2-b4c5-4c53b6b2b1e4</b:DrawingSurfaceGuid><b:FlowGuid>368ed06d-90e0-408b-a058-b2b01cc53ba1</b:FlowGuid><b:Id>156</b:Id><b:InteractionKey>a8b08151-2c62-4840-b773-a1c5bc9dc8c1:368ed06d-90e0-408b-a058-b2b01cc53ba1:88315e4e-bada-4889-8a5a-ee3cc1a47fb9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Destination Data Store D3 CLO กิจกรรม และเกณฑ์</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D3 CLO กิจกรรม และเกณฑ์ may be spoofed by an attacker and this may lead to data being written to the attacker's target instead of D3 CLO กิจกรรม และเกณฑ์. Consider using a standard authentication mechanism to identify the destination data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอรายการกิจกรรม</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>a8b08151-2c62-4840-b773-a1c5bc9dc8c1</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>88315e4e-bada-4889-8a5a-ee3cc1a47fb9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T7a8b08151-2c62-4840-b773-a1c5bc9dc8c1368ed06d-90e0-408b-a058-b2b01cc53ba188315e4e-bada-4889-8a5a-ee3cc1a47fb9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>0df06edf-e481-4ed2-b4c5-4c53b6b2b1e4</b:DrawingS