09a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>f329d5d2-0f77-4947-8a34-fd9062682e09</b:FlowGuid><b:Id>17</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:f329d5d2-0f77-4947-8a34-fd9062682e09:a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>2.0 จัดการรายวิชาและผู้สอน may be able to impersonate the context of ผู้สอน in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายการรายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7.1a9c3bd3a-15ff-4b60-83c3-0204e68b0eae0b57cddd-440f-4f85-bad4-d9f0aeca484ee1eaa825-f886-4a34-b952-5f149a6868f8</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>0b57cddd-440f-4f85-bad4-d9f0aeca484e</b:FlowGuid><b:Id>18</b:Id><b:InteractionKey>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae:0b57cddd-440f-4f85-bad4-d9f0aeca484e:e1eaa825-f886-4a34-b952-5f149a6868f8</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Destination Data Store SQL Database</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D2 รายวิชา may be spoofed by an attacker and this may lead to data being written to the attacker's target instead of D2 รายวิชา. Consider using a standard authentication mechanism to identify the destination data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ข้อมูลรายวิชา · ผู้สอน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>e1eaa825-f886-4a34-b952-5f149a6868f8</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T7a9c3bd3a-15ff-4b60-83c3-0204e68b0eae0b57cddd-440f-4f85-bad4-d9f0aeca484ee1eaa825-f886-4a34-b952-5f149a6868f8</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>0b57cddd-440f-4f85-bad4-d9f0aeca484e</b:FlowGuid><b:Id>19</b:Id><b:InteractionKey>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae:0b57cddd-440f-4f85-bad4-d9f0aeca484e:e1eaa825-f886-4a34-b952-5f149a6868f8</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential SQL Injection Vulnerability for SQL Database</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>SQL injection is an attack in which malicious code is inserted into strings that are later passed to an instance of SQL Server for parsing and execution. Any procedure that constructs SQL statements should be reviewed for injection vulnerabilities because SQL Server will execute all syntactically valid queries that it receives. Even parameterized data can be manipulated by a skilled and determined attacker.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ข้อมูลรายวิชา · ผู้สอน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>e1eaa825-f886-4a34-b952-5f149a6868f8</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D2a9c3bd3a-15ff-4b60-83c3-0204e68b0eae0b57cddd-440f-4f85-bad4-d9f0aeca484ee1eaa825-f886-4a34-b952-5f149a6868f8</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>0b57cddd-440f-4f85-bad4-d9f0aeca484e</b:FlowGuid><b:Id>20</b:Id><b:InteractionKey>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae:0b57cddd-440f-4f85-bad4-d9f0aeca484e:e1eaa825-f886-4a34-b952-5f149a6868f8</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Excessive Resource Consumption for 2.0 จัดการรายวิชาและผู้สอน or SQL Database</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does 2.0 จัดการรายวิชาและผู้สอน or D2 รายวิชา take explicit steps to control resource consumption? Resource consumption attacks can be hard to deal with, and there are times that it makes sense to let the OS do the job. Be careful that your resource requests don't deadlock, and that they do timeout.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ข้อมูลรายวิชา · ผู้สอน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>e1eaa825-f886-4a34-b952-5f149a6868f8</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7e1eaa825-f886-4a34-b952-5f149a6868f8e5d67ded-283b-430c-bdc4-7d96ec7ca36ba9c3bd3a-15ff-4b60-83c3-0204e68b0eae</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>e5d67ded-283b-430c-bdc4-7d96ec7ca36b</b:FlowGuid><b:Id>21</b:Id><b:InteractionKey>e1eaa825-f886-4a34-b952-5f149a6868f8:e5d67ded-283b-430c-bdc4-7d96ec7ca36b:a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Source Data Store SQL Database</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D2 รายวิชา may be spoofed by an attacker and this may lead to incorrect data delivered to 2.0 จัดการรายวิชาและผู้สอน. Consider using a standard authentication mechanism to identify the source data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ข้อมูลรายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e1eaa825-f886-4a34-b952-5f149a6868f8</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I23e1eaa825-f886-4a34-b952-5f149a6868f8e5d67ded-283b-430c-bdc4-7d96ec7ca36ba9c3bd3a-15ff-4b60-83c3-0204e68b0eae</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>e5d67ded-283b-430c-bdc4-7d96ec7ca36b</b:FlowGuid><b:Id>22</b:Id><b:InteractionKey>e1eaa825-f886-4a34-b952-5f149a6868f8:e5d67ded-283b-430c-bdc4-7d96ec7ca36b:a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Access Control for a Resource</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Improper data protection of D2 รายวิชา can allow an attacker to read information not intended for disclosure. Review authorization settings.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ข้อมูลรายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e1eaa825-f886-4a34-b952-5f149a6868f8</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a9c3bd3a-15ff-4b60-83c3-0204e68b0eae</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I23</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S3c6386458-3bb0-42ae-a01e-5cc88646a7974872c01e-c731-45fd-b256-1ae753c4a36190902f09-4482-4985-ae7b-15a3f9714ac1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>4872c01e-c731-45fd-b256-1ae753c4a361</b:FlowGuid><b:Id>23</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:4872c01e-c731-45fd-b256-1ae753c4a361:90902f09-4482-4985-ae7b-15a3f9714ac1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the ผู้ดูแลระบบ External Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้สอน may be spoofed by an attacker and this may lead to unauthorized access to 3.0 กำหนด CLO กิจกรรมและเกณฑ์วัดผล. Consider using a standard authentication mechanism to identify the external entity.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>CLO · จุดประสงค์ · กิจกรรม · น้ำหนัก</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>90902f09-4482-4985-ae7b-15a3f9714ac1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E5c6386458-3bb0-42ae-a01e-5cc88646a7974872c01e-c731-45fd-b256-1ae753c4a36190902f09-4482-4985-ae7b-15a3f9714ac1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>4872c01e-c731-45fd-b256-1ae753c4a361</b:FlowGuid><b:Id>24</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:4872c01e-c731-45fd-b256-1ae753c4a361:90902f09-4482-4985-ae7b-15a3f9714ac1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>3.0 กำหนด CLO กิจกรรมและเกณฑ์วัดผล may be able to impersonate the context of ผู้สอน in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>CLO · จุดประสงค์ · กิจกรรม · น้ำหนัก</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>90902f09-4482-4985-ae7b-15a3f9714ac1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7.190902f09-4482-4985-ae7b-15a3f9714ac1b9d5cc1b-0092-4823-9ae5-80d2ecb805fe4b62e68d-b4a1-4d7d-b06a-ccd8408fdf75</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>b9d5cc1b-0092-4823-9ae5-80d2ecb805fe</b:FlowGuid><b:Id>25</b:Id><b:InteractionKey>90902f09-4482-4985-ae7b-15a3f9714ac1:b9d5cc1b-0092-4823-9ae5-80d2ecb805fe:4b62e68d-b4a1-4d7d-b06a-ccd8408fdf75</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Destination Data Store D3 CLO กิจกรรม และเกณฑ์</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D3 CLO กิจกรรม และเกณฑ์ may be spoofed by an attacker and this may lead to data being written to the attacker's target instead of D3 CLO กิจกรรม และเกณฑ์. Consider using a standard authentication mechanism to identify the destination data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>CLO · กิจกรรม · เกณฑ์</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>90902f09-4482-4985-ae7b-15a3f9714ac1</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>4b62e68d-b4a1-4d7d-b06a-ccd8408fdf75</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T790902f09-4482-4985-ae7b-15a3f9714ac1b9d5cc1b-0092-4823-9ae5-80d2ecb805fe4b62e68d-b4a1-4d7d-b06a-ccd8408fdf75</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>b9d5cc1b-0092-4823-9ae5-80d2ecb805fe</b:FlowGuid><b:Id>26</b:Id><b:InteractionKey>90902f09-4482-4985-ae7b-15a3f9714ac1:b9d5cc1b-0092-4823-9ae5-80d2ecb805fe:4b62e68d-b4a1-4d7d-b06a-ccd8408fdf75</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential SQL Injection Vulnerability for D3 CLO กิจกรรม และเกณฑ์</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>SQL injection is an attack in which malicious code is inserted into strings that are later passed to an instance of SQL Server for parsing and execution. Any procedure that constructs SQL statements should be reviewed for injection vulnerabilities because SQL Server will execute all syntactically valid queries that it receives. Even parameterized data can be manipulated by a skilled and determined attacker.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>CLO · กิจกรรม · เกณฑ์</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>90902f09-4482-4985-ae7b-15a3f9714ac1</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>4b62e68d-b4a1-4d7d-b06a-ccd8408fdf75</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D290902f09-4482-4985-ae7b-15a3f9714ac1b9d5cc1b-0092-4823-9ae5-80d2ecb805fe4b62e68d-b4a1-4d7d-b06a-ccd8408fdf75</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>b9d5cc1b-0092-4823-9ae5-80d2ecb805fe</b:FlowGuid><b:Id>27</b:Id><b:InteractionKey>90902f09-4482-4985-ae7b-15a3f9714ac1:b9d5cc1b-0092-4823-9ae5-80d2ecb805fe:4b62e68d-b4a1-4d7d-b06a-ccd8408fdf75</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Excessive Resource Consumption for 3.0 กำหนด CLO กิจกรรมและเกณฑ์วัดผล or D3 CLO กิจกรรม และเกณฑ์</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does 3.0 กำหนด CLO กิจกรรมและเกณฑ์วัดผล or D3 CLO กิจกรรม และเกณฑ์ take explicit steps to control resource consumption? Resource consumption attacks can be hard to deal with, and there are times that it makes sense to let the OS do the job. Be careful that your resource requests don't deadlock, and that they do timeout.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>CLO · กิจกรรม · เกณฑ์</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>90902f09-4482-4985-ae7b-15a3f9714ac1</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>4b62e68d-b4a1-4d7d-b06a-ccd8408fdf75</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S74b62e68d-b4a1-4d7d-b06a-ccd8408fdf757e3d5154-8afb-4e53-b970-667733a3fadc90902f09-4482-4985-ae7b-15a3f9714ac1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>7e3d5154-8afb-4e53-b970-667733a3fadc</b:FlowGuid><b:Id>28</b:Id><b:InteractionKey>4b62e68d-b4a1-4d7d-b06a-ccd8408fdf75:7e3d5154-8afb-4e53-b970-667733a3fadc:90902f09-4482-4985-ae7b-15a3f9714ac1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Source Data Store D3 CLO กิจกรรม และเกณฑ์</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D3 CLO กิจกรรม และเกณฑ์ may be spoofed by an attacker and this may lead to incorrect data delivered to 3.0 กำหนด CLO กิจกรรมและเกณฑ์วัดผล. Consider using a standard authentication mechanism to identify the source data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>CLO และกิจกรรมที่มีอยู่</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>4b62e68d-b4a1-4d7d-b06a-ccd8408fdf75</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>90902f09-4482-4985-ae7b-15a3f9714ac1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I234b62e68d-b4a1-4d7d-b06a-ccd8408fdf757e3d5154-8afb-4e53-b970-667733a3fadc90902f09-4482-4985-ae7b-15a3f9714ac1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>7e3d5154-8afb-4e53-b970-667733a3fadc</b:FlowGuid><b:Id>29</b:Id><b:InteractionKey>4b62e68d-b4a1-4d7d-b06a-ccd8408fdf75:7e3d5154-8afb-4e53-b970-667733a3fadc:90902f09-4482-4985-ae7b-15a3f9714ac1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Access Control for a Resource</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Improper data protection of D3 CLO กิจกรรม และเกณฑ์ can allow an attacker to read information not intended for disclosure. Review authorization settings.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>CLO และกิจกรรมที่มีอยู่</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>4b62e68d-b4a1-4d7d-b06a-ccd8408fdf75</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>90902f09-4482-4985-ae7b-15a3f9714ac1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I23</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S3c6386458-3bb0-42ae-a01e-5cc88646a7971bb1318c-bde8-406d-b704-c20f171a39f51b11bd38-67d1-4d31-9e54-bf5c662948b1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>1bb1318c-bde8-406d-b704-c20f171a39f5</b:FlowGuid><b:Id>30</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:1bb1318c-bde8-406d-b704-c20f171a39f5:1b11bd38-67d1-4d31-9e54-bf5c662948b1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the ผู้ดูแลระบบ External Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้สอน may be spoofed by an attacker and this may lead to unauthorized access to 5.0 จัดการรายชื่อนักศึกษา. Consider using a standard authentication mechanism to identify the external entity.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายชื่อ (กรอกเองหรือไฟล์ Excel) การถอนรายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>1b11bd38-67d1-4d31-9e54-bf5c662948b1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E5c6386458-3bb0-42ae-a01e-5cc88646a7971bb1318c-bde8-406d-b704-c20f171a39f51b11bd38-67d1-4d31-9e54-bf5c662948b1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>1bb1318c-bde8-406d-b704-c20f171a39f5</b:FlowGuid><b:Id>31</b:Id><b:InteractionKey>c6386458-3bb0-42ae-a01e-5cc88646a797:1bb1318c-bde8-406d-b704-c20f171a39f5:1b11bd38-67d1-4d31-9e54-bf5c662948b1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>5.0 จัดการรายชื่อนักศึกษา may be able to impersonate the context of ผู้สอน in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายชื่อ (กรอกเองหรือไฟล์ Excel) การถอนรายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c6386458-3bb0-42ae-a01e-5cc88646a797</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>1b11bd38-67d1-4d31-9e54-bf5c662948b1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7.11b11bd38-67d1-4d31-9e54-bf5c662948b1f0844e00-dd18-4d44-9dfe-5579d42d5343c16770c8-07a4-424e-b80f-b45e5eb2beb4</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>f0844e00-dd18-4d44-9dfe-5579d42d5343</b:FlowGuid><b:Id>32</b:Id><b:InteractionKey>1b11bd38-67d1-4d31-9e54-bf5c662948b1:f0844e00-dd18-4d44-9dfe-5579d42d5343:c16770c8-07a4-424e-b80f-b45e5eb2beb4</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Destination Data Store SQL Database</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D4 นักศึกษา may be spoofed by an attacker and this may lead to data being written to the attacker's target instead of D4 นักศึกษา. Consider using a standard authentication mechanism to identify the destination data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ข้อมูลนักศึกษา · สถานะถอน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>1b11bd38-67d1-4d31-9e54-bf5c662948b1</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c16770c8-07a4-424e-b80f-b45e5eb2beb4</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T71b11bd38-67d1-4d31-9e54-bf5c662948b1f0844e00-dd18-4d44-9dfe-5579d42d5343c16770c8-07a4-424e-b80f-b45e5eb2beb4</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>f0844e00-dd18-4d44-9dfe-5579d42d5343</b:FlowGuid><b:Id>33</b:Id><b:InteractionKey>1b11bd38-67d1-4d31-9e54-bf5c662948b1:f0844e00-dd18-4d44-9dfe-5579d42d5343:c16770c8-07a4-424e-b80f-b45e5eb2beb4</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential SQL Injection Vulnerability for SQL Database</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>SQL injection is an attack in which malicious code is inserted into strings that are later passed to an instance of SQL Server for parsing and execution. Any procedure that constructs SQL statements should be reviewed for injection vulnerabilities because SQL Server will execute all syntactically valid queries that it receives. Even parameterized data can be manipulated by a skilled and determined attacker.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ข้อมูลนักศึกษา · สถานะถอน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>1b11bd38-67d1-4d31-9e54-bf5c662948b1</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c16770c8-07a4-424e-b80f-b45e5eb2beb4</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D21b11bd38-67d1-4d31-9e54-bf5c662948b1f0844e00-dd18-4d44-9dfe-5579d42d5343c16770c8-07a4-424e-b80f-b45e5eb2beb4</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>f0844e00-dd18-4d44-9dfe-5579d42d5343</b:FlowGuid><b:Id>34</b:Id><b:InteractionKey>1b11bd38-67d1-4d31-9e54-bf5c662948b1:f0844e00-dd18-4d44-9dfe-5579d42d5343:c16770c8-07a4-424e-b80f-b45e5eb2beb4</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Excessive Resource Consumption for 4.0 จัดการรายชื่อนักศึกษา or SQL Database</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does 5.0 จัดการรายชื่อนักศึกษา or D4 นักศึกษา take explicit steps to control resource consumption? Resource consumption attacks can be hard to deal with, and there are times that it makes sense to let the OS do the job. Be careful that your resource requests don't deadlock, and that they do timeout.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ข้อมูลนักศึกษา · สถานะถอน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>1b11bd38-67d1-4d31-9e54-bf5c662948b1</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c16770c8-07a4-424e-b80f-b45e5eb2beb4</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7c16770c8-07a4-424e-b80f-b45e5eb2beb45225b2a8-af09-4d0d-aaec-fc4b3a4a828b1b11bd38-67d1-4d31-9e54-bf5c662948b1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>5225b2a8-af09-4d0d-aaec-fc4b3a4a828b</b:FlowGuid><b:Id>35</b:Id><b:InteractionKey>c16770c8-07a4-424e-b80f-b45e5eb2beb4:5225b2a8-af09-4d0d-aaec-fc4b3a4a828b:1b11bd38-67d1-4d31-9e54-bf5c662948b1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Source Data Store SQL Database</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D4 นักศึกษา may be spoofed by an attacker and this may lead to incorrect data delivered to 5.0 จัดการรายชื่อนักศึกษา. Consider using a standard authentication mechanism to identify the source data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายชื่อที่มีอยู่</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c16770c8-07a4-424e-b80f-b45e5eb2beb4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>1b11bd38-67d1-4d31-9e54-bf5c662948b1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I23c16770c8-07a4-424e-b80f-b45e5eb2beb45225b2a8-af09-4d0d-aaec-fc4b3a4a828b1b11bd38-67d1-4d31-9e54-bf5c662948b1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>5225b2a8-af09-4d0d-aaec-fc4b3a4a828b</b:FlowGuid><b:Id>36</b:Id><b:InteractionKey>c16770c8-07a4-424e-b80f-b45e5eb2beb4:5225b2a8-af09-4d0d-aaec-fc4b3a4a828b:1b11bd38-67d1-4d31-9e54-bf5c662948b1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Access Control for a Resource</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Improper data protection of D4 นักศึกษา can allow an attacker to read information not intended for disclosure. Review authorization settings.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายชื่อที่มีอยู่</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c16770c8-07a4-424e-b80f-b45e5eb2beb4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>1b11bd38-67d1-4d31-9e54-bf5c662948b1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I23</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7.10a5e9a2e-215d-4a9c-b2a1-ec2fc491ab280584238b-a0ef-44c1-93b7-3720b5e21ba86fbd1295-fff0-4ece-9789-a72e03749475</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>0584238b-a0ef-44c1-93b7-3720b5e21ba8</b:FlowGuid><b:Id>37</b:Id><b:InteractionKey>0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28:0584238b-a0ef-44c1-93b7-3720b5e21ba8:6fbd1295-fff0-4ece-9789-a72e03749475</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Destination Data Store D5 คะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D5 คะแนน may be spoofed by an attacker and this may lead to data being written to the attacker's target instead of D5 คะแนน. Consider using a standard authentication mechanism to identify the destination data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนน · ประวัติการแก้</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6fbd1295-fff0-4ece-9789-a72e03749475</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D20a5e9a2e-215d-4a9c-b2a1-ec2fc491ab280584238b-a0ef-44c1-93b7-3720b5e21ba86fbd1295-fff0-4ece-9789-a72e03749475</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>0584238b-a0ef-44c1-93b7-3720b5e21ba8</b:FlowGuid><b:Id>38</b:Id><b:InteractionKey>0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28:0584238b-a0ef-44c1-93b7-3720b5e21ba8:6fbd1295-fff0-4ece-9789-a72e03749475</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Excessive Resource Consumption for 5.0 บันทึกและนำเข้าคะแนน or D5 คะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does 4.0 บันทึกและนำเข้าคะแนน or D5 คะแนน take explicit steps to control resource consumption? Resource consumption attacks can be hard to deal with, and there are times that it makes sense to let the OS do the job. Be careful that your resource requests don't deadlock, and that they do timeout.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนน · ประวัติการแก้</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6fbd1295-fff0-4ece-9789-a72e03749475</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S76fbd1295-fff0-4ece-9789-a72e037494754c9185da-98dc-44ea-aaf6-e27a133b3e030a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>4c9185da-98dc-44ea-aaf6-e27a133b3e03</b:FlowGuid><b:Id>39</b:Id><b:InteractionKey>6fbd1295-fff0-4ece-9789-a72e03749475:4c9185da-98dc-44ea-aaf6-e27a133b3e03:0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Source Data Store D5 คะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D5 คะแนน may be spoofed by an attacker and this may lead to incorrect data delivered to 4.0 บันทึกและนำเข้าคะแนน. Consider using a standard authentication mechanism to identify the source data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนนที่มีอยู่</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6fbd1295-fff0-4ece-9789-a72e03749475</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>0a5e9a2e-215d-4a9c-b2a1-ec2fc491ab28</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></