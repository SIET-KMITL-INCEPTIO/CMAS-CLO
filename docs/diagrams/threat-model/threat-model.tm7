ValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ข้อมูลรายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>46a3fc6e-cb1e-40ec-a7c5-c6afecc8b41c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f21494b5-dcc7-4d98-9dd9-3c701f15d4fc</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E746a3fc6e-cb1e-40ec-a7c5-c6afecc8b41c69a12ef2-1649-4f7e-891f-9939352d1aa5f21494b5-dcc7-4d98-9dd9-3c701f15d4fc</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>0df06edf-e481-4ed2-b4c5-4c53b6b2b1e4</b:DrawingSurfaceGuid><b:FlowGuid>69a12ef2-1649-4f7e-891f-9939352d1aa5</b:FlowGuid><b:Id>311</b:Id><b:InteractionKey>46a3fc6e-cb1e-40ec-a7c5-c6afecc8b41c:69a12ef2-1649-4f7e-891f-9939352d1aa5:f21494b5-dcc7-4d98-9dd9-3c701f15d4fc</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in 2.0 จัดการรายวิชาและผู้สอน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into 2.0 จัดการรายวิชาและผู้สอน in order to change the flow of program execution within 2.0 จัดการรายวิชาและผู้สอน to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ข้อมูลรายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>46a3fc6e-cb1e-40ec-a7c5-c6afecc8b41c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f21494b5-dcc7-4d98-9dd9-3c701f15d4fc</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S1965d89d1-db84-4edd-a8c8-41ca3bb62f8fbbf77010-b880-43e7-9cdd-e6088d8a7ded88315e4e-bada-4889-8a5a-ee3cc1a47fb9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>0df06edf-e481-4ed2-b4c5-4c53b6b2b1e4</b:DrawingSurfaceGuid><b:FlowGuid>bbf77010-b880-43e7-9cdd-e6088d8a7ded</b:FlowGuid><b:Id>312</b:Id><b:InteractionKey>965d89d1-db84-4edd-a8c8-41ca3bb62f8f:bbf77010-b880-43e7-9cdd-e6088d8a7ded:88315e4e-bada-4889-8a5a-ee3cc1a47fb9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the 3.0 กำหนด CLO กิจกรรมและเกณฑ์วัดผล Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>3.0 กำหนด CLO กิจกรรมและเกณฑ์วัดผล may be spoofed by an attacker and this may lead to unauthorized access to D3 CLO กิจกรรม และเกณฑ์. Consider using a standard authentication mechanism to identify the source process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>CLO · กิจกรรม · เกณฑ์</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>965d89d1-db84-4edd-a8c8-41ca3bb62f8f</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>88315e4e-bada-4889-8a5a-ee3cc1a47fb9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T18965d89d1-db84-4edd-a8c8-41ca3bb62f8fbbf77010-b880-43e7-9cdd-e6088d8a7ded88315e4e-bada-4889-8a5a-ee3cc1a47fb9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>0df06edf-e481-4ed2-b4c5-4c53b6b2b1e4</b:DrawingSurfaceGuid><b:FlowGuid>bbf77010-b880-43e7-9cdd-e6088d8a7ded</b:FlowGuid><b:Id>313</b:Id><b:InteractionKey>965d89d1-db84-4edd-a8c8-41ca3bb62f8f:bbf77010-b880-43e7-9cdd-e6088d8a7ded:88315e4e-bada-4889-8a5a-ee3cc1a47fb9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>The D3 CLO กิจกรรม และเกณฑ์ Data Store Could Be Corrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across CLO · กิจกรรม · เกณฑ์ may be tampered with by an attacker. This may lead to corruption of D3 CLO กิจกรรม และเกณฑ์. Ensure the integrity of the data flow to the data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>CLO · กิจกรรม · เกณฑ์</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>965d89d1-db84-4edd-a8c8-41ca3bb62f8f</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>88315e4e-bada-4889-8a5a-ee3cc1a47fb9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T18</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R8965d89d1-db84-4edd-a8c8-41ca3bb62f8fbbf77010-b880-43e7-9cdd-e6088d8a7ded88315e4e-bada-4889-8a5a-ee3cc1a47fb9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>0df06edf-e481-4ed2-b4c5-4c53b6b2b1e4</b:DrawingSurfaceGuid><b:FlowGuid>bbf77010-b880-43e7-9cdd-e6088d8a7ded</b:FlowGuid><b:Id>314</b:Id><b:InteractionKey>965d89d1-db84-4edd-a8c8-41ca3bb62f8f:bbf77010-b880-43e7-9cdd-e6088d8a7ded:88315e4e-bada-4889-8a5a-ee3cc1a47fb9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Denies D3 CLO กิจกรรม และเกณฑ์ Potentially Writing Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D3 CLO กิจกรรม และเกณฑ์ claims that it did not write data received from an entity on the other side of the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>CLO · กิจกรรม · เกณฑ์</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>965d89d1-db84-4edd-a8c8-41ca3bb62f8f</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>88315e4e-bada-4889-8a5a-ee3cc1a47fb9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R8</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I6965d89d1-db84-4edd-a8c8-41ca3bb62f8fbbf77010-b880-43e7-9cdd-e6088d8a7ded88315e4e-bada-4889-8a5a-ee3cc1a47fb9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>0df06edf-e481-4ed2-b4c5-4c53b6b2b1e4</b:DrawingSurfaceGuid><b:FlowGuid>bbf77010-b880-43e7-9cdd-e6088d8a7ded</b:FlowGuid><b:Id>315</b:Id><b:InteractionKey>965d89d1-db84-4edd-a8c8-41ca3bb62f8f:bbf77010-b880-43e7-9cdd-e6088d8a7ded:88315e4e-bada-4889-8a5a-ee3cc1a47fb9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across CLO · กิจกรรม · เกณฑ์ may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>CLO · กิจกรรม · เกณฑ์</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>965d89d1-db84-4edd-a8c8-41ca3bb62f8f</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>88315e4e-bada-4889-8a5a-ee3cc1a47fb9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4965d89d1-db84-4edd-a8c8-41ca3bb62f8fbbf77010-b880-43e7-9cdd-e6088d8a7ded88315e4e-bada-4889-8a5a-ee3cc1a47fb9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>0df06edf-e481-4ed2-b4c5-4c53b6b2b1e4</b:DrawingSurfaceGuid><b:FlowGuid>bbf77010-b880-43e7-9cdd-e6088d8a7ded</b:FlowGuid><b:Id>316</b:Id><b:InteractionKey>965d89d1-db84-4edd-a8c8-41ca3bb62f8f:bbf77010-b880-43e7-9cdd-e6088d8a7ded:88315e4e-bada-4889-8a5a-ee3cc1a47fb9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow CLO · กิจกรรม · เกณฑ์ Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>CLO · กิจกรรม · เกณฑ์</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>965d89d1-db84-4edd-a8c8-41ca3bb62f8f</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>88315e4e-bada-4889-8a5a-ee3cc1a47fb9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D5965d89d1-db84-4edd-a8c8-41ca3bb62f8fbbf77010-b880-43e7-9cdd-e6088d8a7ded88315e4e-bada-4889-8a5a-ee3cc1a47fb9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>0df06edf-e481-4ed2-b4c5-4c53b6b2b1e4</b:DrawingSurfaceGuid><b:FlowGuid>bbf77010-b880-43e7-9cdd-e6088d8a7ded</b:FlowGuid><b:Id>317</b:Id><b:InteractionKey>965d89d1-db84-4edd-a8c8-41ca3bb62f8f:bbf77010-b880-43e7-9cdd-e6088d8a7ded:88315e4e-bada-4889-8a5a-ee3cc1a47fb9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Inaccessible</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent prevents access to a data store on the other side of the trust boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>CLO · กิจกรรม · เกณฑ์</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>965d89d1-db84-4edd-a8c8-41ca3bb62f8f</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>88315e4e-bada-4889-8a5a-ee3cc1a47fb9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S288315e4e-bada-4889-8a5a-ee3cc1a47fb96e555217-782f-4233-95d7-7092ebfdbe94965d89d1-db84-4edd-a8c8-41ca3bb62f8f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>0df06edf-e481-4ed2-b4c5-4c53b6b2b1e4</b:DrawingSurfaceGuid><b:FlowGuid>6e555217-782f-4233-95d7-7092ebfdbe94</b:FlowGuid><b:Id>318</b:Id><b:InteractionKey>88315e4e-bada-4889-8a5a-ee3cc1a47fb9:6e555217-782f-4233-95d7-7092ebfdbe94:965d89d1-db84-4edd-a8c8-41ca3bb62f8f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the 3.0 กำหนด CLO กิจกรรมและเกณฑ์วัดผล Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>3.0 กำหนด CLO กิจกรรมและเกณฑ์วัดผล may be spoofed by an attacker and this may lead to information disclosure by D3 CLO กิจกรรม และเกณฑ์. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>CLO และกิจกรรมที่มีอยู่</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>88315e4e-bada-4889-8a5a-ee3cc1a47fb9</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>965d89d1-db84-4edd-a8c8-41ca3bb62f8f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R688315e4e-bada-4889-8a5a-ee3cc1a47fb96e555217-782f-4233-95d7-7092ebfdbe94965d89d1-db84-4edd-a8c8-41ca3bb62f8f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>0df06edf-e481-4ed2-b4c5-4c53b6b2b1e4</b:DrawingSurfaceGuid><b:FlowGuid>6e555217-782f-4233-95d7-7092ebfdbe94</b:FlowGuid><b:Id>319</b:Id><b:InteractionKey>88315e4e-bada-4889-8a5a-ee3cc1a47fb9:6e555217-782f-4233-95d7-7092ebfdbe94:965d89d1-db84-4edd-a8c8-41ca3bb62f8f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by 3.0 กำหนด CLO กิจกรรมและเกณฑ์วัดผล</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>3.0 กำหนด CLO กิจกรรมและเกณฑ์วัดผล claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>CLO และกิจกรรมที่มีอยู่</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a