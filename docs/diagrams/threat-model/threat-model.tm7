ngstring></b:Properties><b:SourceGuid>74c38d87-e600-4de7-9224-3773aa1a4fc2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>0d64a30e-10bc-40e3-99d4-da420c7b6c17</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S20d64a30e-10bc-40e3-99d4-da420c7b6c17c3077b4e-cb9d-48be-be8d-30e76937374674c38d87-e600-4de7-9224-3773aa1a4fc2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>c3077b4e-cb9d-48be-be8d-30e769373746</b:FlowGuid><b:Id>773</b:Id><b:InteractionKey>0d64a30e-10bc-40e3-99d4-da420c7b6c17:c3077b4e-cb9d-48be-be8d-30e769373746:74c38d87-e600-4de7-9224-3773aa1a4fc2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the 4.1 แสดงตารางคะแนน และออกแบบฟอร์ม Excel Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>4.1 แสดงตารางคะแนน และออกแบบฟอร์ม Excel may be spoofed by an attacker and this may lead to information disclosure by D4 นักศึกษา. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนนที่มีอยู่</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>0d64a30e-10bc-40e3-99d4-da420c7b6c17</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>74c38d87-e600-4de7-9224-3773aa1a4fc2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R60d64a30e-10bc-40e3-99d4-da420c7b6c17c3077b4e-cb9d-48be-be8d-30e76937374674c38d87-e600-4de7-9224-3773aa1a4fc2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>c3077b4e-cb9d-48be-be8d-30e769373746</b:FlowGuid><b:Id>774</b:Id><b:InteractionKey>0d64a30e-10bc-40e3-99d4-da420c7b6c17:c3077b4e-cb9d-48be-be8d-30e769373746:74c38d87-e600-4de7-9224-3773aa1a4fc2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by 4.1 แสดงตารางคะแนน และออกแบบฟอร์ม Excel</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>4.1 แสดงตารางคะแนน และออกแบบฟอร์ม Excel claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนนที่มีอยู่</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>0d64a30e-10bc-40e3-99d4-da420c7b6c17</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>74c38d87-e600-4de7-9224-3773aa1a4fc2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D30d64a30e-10bc-40e3-99d4-da420c7b6c17c3077b4e-cb9d-48be-be8d-30e76937374674c38d87-e600-4de7-9224-3773aa1a4fc2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>c3077b4e-cb9d-48be-be8d-30e769373746</b:FlowGuid><b:Id>775</b:Id><b:InteractionKey>0d64a30e-10bc-40e3-99d4-da420c7b6c17:c3077b4e-cb9d-48be-be8d-30e769373746:74c38d87-e600-4de7-9224-3773aa1a4fc2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for 4.1 แสดงตารางคะแนน และออกแบบฟอร์ม Excel</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>4.1 แสดงตารางคะแนน และออกแบบฟอร์ม Excel crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนนที่มีอยู่</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>0d64a30e-10bc-40e3-99d4-da420c7b6c17</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>74c38d87-e600-4de7-9224-3773aa1a4fc2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D40d64a30e-10bc-40e3-99d4-da420c7b6c17c3077b4e-cb9d-48be-be8d-30e76937374674c38d87-e600-4de7-9224-3773aa1a4fc2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>c3077b4e-cb9d-48be-be8d-30e769373746</b:FlowGuid><b:Id>776</b:Id><b:InteractionKey>0d64a30e-10bc-40e3-99d4-da420c7b6c17:c3077b4e-cb9d-48be-be8d-30e769373746:74c38d87-e600-4de7-9224-3773aa1a4fc2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow คะแนนที่มีอยู่ Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Val