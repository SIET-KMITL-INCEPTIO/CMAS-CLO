ingstring></b:Properties><b:SourceGuid>72971263-a604-4105-a156-a34385c34227</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>74c38d87-e600-4de7-9224-3773aa1a4fc2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I23</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S38d1b0bf0-4bb6-4289-ad4e-335a4211e20728e292c9-b87b-4cd9-990b-d3db49644526ef2f69e0-387e-4a7c-9107-ef304a699d51</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>28e292c9-b87b-4cd9-990b-d3db49644526</b:FlowGuid><b:Id>202</b:Id><b:InteractionKey>8d1b0bf0-4bb6-4289-ad4e-335a4211e207:28e292c9-b87b-4cd9-990b-d3db49644526:ef2f69e0-387e-4a7c-9107-ef304a699d51</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the ผู้สอน External Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้สอน may be spoofed by an attacker and this may lead to unauthorized access to 4.2 ตรวจและบันทึกคะแนน. Consider using a standard authentication mechanism to identify the external entity.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนน (กรอกเองหรือไฟล์ Excel)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>8d1b0bf0-4bb6-4289-ad4e-335a4211e207</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ef2f69e0-387e-4a7c-9107-ef304a699d51</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E58d1b0bf0-4bb6-4289-ad4e-335a4211e20728e292c9-b87b-4cd9-990b-d3db49644526ef2f69e0-387e-4a7c-9107-ef304a699d51</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>28e292c9-b87b-4cd9-990b-d3db49644526</b:FlowGuid><b:Id>203</b:Id><b:InteractionKey>8d1b0bf0-4bb6-4289-ad4e-335a4211e207:28e292c9-b87b-4cd9-990b-d3db49644526:ef2f69e0-387e-4a7c-9107-ef304a699d51</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>4.2 ตรวจและบันทึกคะแนน may be able to impersonate the context of ผู้สอน in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนน (กรอกเองหรือไฟล์ Excel)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>8d1b0bf0-4bb6-4289-ad4e-335a4211e207</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ef2f69e0-387e-4a7c-9107-ef304a699d51</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7152a9786-c3ef-4613-b437-300884f70771e32725cf-dbf7-469d-aab7-84f43102220cef2f69e0-387e-4a7c-9107-ef304a699d51</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>e32725cf-dbf7-469d-aab7-84f43102220c</b:FlowGuid><b:Id>204</b:Id><b:InteractionKey>152a9786-c3ef-4613-b437-300884f70771:e32725cf-dbf7-469d-aab7-84f43102220c:ef2f69e0-387e-4a7c-9107-ef304a699d51</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Source Data Store D3 CLO กิจกรรม และเกณฑ์</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D3 CLO กิจกรรม และเกณฑ์ may be spoofed by an attacker and this may lead to incorrect data delivered to 4.2 ตรวจและบันทึกคะแนน. Consider using a standard authentication mechanism to identify the source data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนนเต็ม · สถานะปิดรับ</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>152a9786-c3ef-4613-b437-300884f70771</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ef2f69e0-387e-4a7c-9107-ef304a699d51</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I23152a9786-c3ef-4613-b437-300884f70771e32725cf-dbf7-469d-aab7-84f43102220cef2f69e0-387e-4a7c-9107-ef304a699d51</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>e32725cf-dbf7-469d-aab7-84f43102220c</b:FlowGuid><b:Id>205</b:Id><b:InteractionKey>152a9786-c3ef-4613-b437-300884f70771:e32725cf-dbf7-469d-aab7-84f43102220c:ef2f69e0-387e-4a7c-9107-ef304a699d51</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Access Control for a Resource</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Improper data protection of D3 CLO กิจกรรม และเกณฑ์ can allow an attacker to read information not intended for disclosure. Review authorization settings.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนนเต็ม · สถานะปิดรับ</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>152a9786-c3ef-4613-b437-300884f70771</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ef2f69e0-387e-4a7c-9107-ef304a699d51</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I23</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7.1ef2f69e0-387e-4a7c-9107-ef304a699d5150d86119-ddbc-4ef1-a194-27d2b2183a77152a9786-c3ef-4613-b437-300884f70771</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>50d86119-ddbc-4ef1-a194-27d2b2183a77</b:FlowGuid><b:Id>206</b:Id><b:InteractionKey>ef2f69e0-387e-4a7c-9107-ef304a699d51:50d86119-ddbc-4ef1-a194-27d2b2183a77:152a9786-c3ef-4613-b437-300884f70771</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Destination Data Store D3 CLO กิจกรรม และเกณฑ์</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D3 CLO กิจกรรม และเกณฑ์ may be spoofed by an attacker and this may lead to data being written to the attacker's target instead of D3 CLO กิจกรรม และเกณฑ์. Consider using a standard authentication mechanism to identify the destination data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอคะแนนเต็มของกิจกรรม</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ef2f69e0-387e-4a7c-9107-ef304a699d51</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>152a9786-c3ef-4613-b437-300884f70771</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T7ef2f69e0-387e-4a7c-9107-ef304a699d5150d86119-ddbc-4ef1-a194-27d2b2183a77152a9786-c3ef-4613-b437-300884f70771</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>50d86119-ddbc-4ef1-a194-27d2b2183a77</b:FlowGuid><b:Id>207</b:Id><b:InteractionKey>ef2f69e0-387e-4a7c-9107-ef304a699d51:50d86119-ddbc-4ef1-a194-27d2b2183a77:152a9786-c3ef-4613-b437-300884f70771</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential SQL Injection Vulnerability for D3 CLO กิจกรรม และเกณฑ์</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>SQL injection is an attack in which malicious code is inserted into strings that are later passed to an instance of SQL Server for parsing and execution. Any procedure that constructs SQL statements should be reviewed for injection vulnerabilities because SQL Server will execute all syntactically valid queries that it receives. Even parameterized data can be manipulated by a skilled and determined attacker.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอคะแนนเต็มของกิจกรรม</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ef2f69e0-387e-4a7c-9107-ef304a699d51</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>152a9786-c3ef-4613-b437-300884f70771</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D2ef2f69e0-387e-4a7c-9107-ef304a699d5150d86119-ddbc-4ef1-a194-27d2b2183a77152a9786-c3ef-4613-b437-300884f70771</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>50d86119-ddbc-4ef1-a194-27d2b2183a77</b:FlowGuid><b:Id>208</b:Id><b:InteractionKey>ef2f69e0-387e-4a7c-9107-ef304a699d51:50d86119-ddbc-4ef1-a194-27d2b2183a77:152a9786-c3ef-4613-b437-300884f70771</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Excessive Resource Consumption for 4.2 ตรวจและบันทึกคะแนน or D3 CLO กิจกรรม และเกณฑ์</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does 4.2 ตรวจและบันทึกคะแนน or D3 CLO กิจกรรม และเกณฑ์ take explicit steps to control resource consumption? Resource consumption attacks can be hard to deal with, and there are times that it makes sense to let the OS do the job. Be careful that your resource requests don't deadlock, and that they do timeout.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอคะแนนเต็มของกิจกรรม</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ef2f69e0-387e-4a7c-9107-ef304a699d51</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>152a9786-c3ef-4613-b437-300884f70771</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S70d64a30e-10bc-40e3-99d4-da420c7b6c17154f3364-c4ba-46ac-b966-01a70c856891ef2f69e0-387e-4a7c-9107-ef304a699d51</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>154f3364-c4ba-46ac-b966-01a70c856891</b:FlowGuid><b:Id>209</b:Id><b:InteractionKey>0d64a30e-10bc-40e3-99d4-da420c7b6c17:154f3364-c4ba-46ac-b966-01a70c856891:ef2f69e0-387e-4a7c-9107-ef304a699d51</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Source Data Store D4 นักศึกษา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D4 นักศึกษา may be spoofed by an attacker and this may lead to incorrect data delivered to 4.2 ตรวจและบันทึกคะแนน. Consider using a standard authentication mechanism to identify the source data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนนเดิม</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>0d64a30e-10bc-40e3-99d4-da420c7b6c17</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ef2f69e0-387e-4a7c-9107-ef304a699d51</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I230d64a30e-10bc-40e3-99d4-da420c7b6c17154f3364-c4ba-46ac-b966-01a70c856891ef2f69e0-387e-4a7c-9107-ef304a699d51</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>154f3364-c4ba-46ac-b966-01a70c856891</b:FlowGuid><b:Id>210</b:Id><b:InteractionKey>0d64a30e-10bc-40e3-99d4-da420c7b6c17:154f3364-c4ba-46ac-b966-01a70c856891:ef2f69e0-387e-4a7c-9107-ef304a699d51</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Access Control for a Resource</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Improper data protection of D4 นักศึกษา can allow an attacker to read information not intended for disclosure. Review authorization settings.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนนเดิม</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>0d64a30e-10bc-40e3-99d4-da420c7b6c17</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ef2f69e0-387e-4a7c-9107-ef304a699d51</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I23</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7.1ef2f69e0-387e-4a7c-9107-ef304a699d51ddce0456-d444-4d81-be4a-42e7765869480d64a30e-10bc-40e3-99d4-da420c7b6c17</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>ddce0456-d444-4d81-be4a-42e776586948</b:FlowGuid><b:Id>211</b:Id><b:InteractionKey>ef2f69e0-387e-4a7c-9107-ef304a699d51:ddce0456-d444-4d81-be4a-42e776586948:0d64a30e-10bc-40e3-99d4-da420c7b6c17</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Destination Data Store D4 นักศึกษา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D4 นักศึกษา may be spoofed by an attacker and this may lead to data being written to the attacker's target instead of D4 นักศึกษา. Consider using a standard authentication mechanism to identify the destination data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนน · ประวัติการแก้</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ef2f69e0-387e-4a7c-9107-ef304a699d51</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>0d64a30e-10bc-40e3-99d4-da420c7b6c17</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T7ef2f69e0-387e-4a7c-9107-ef304a699d51ddce0456-d444-4d81-be4a-42e7765869480d64a30e-10bc-40e3-99d4-da420c7b6c17</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>ddce0456-d444-4d81-be4a-42e776586948</b:FlowGuid><b:Id>212</b:Id><b:InteractionKey>ef2f69e0-387e-4a7c-9107-ef304a699d51:ddce0456-d444-4d81-be4a-42e776586948:0d64a30e-10bc-40e3-99d4-da420c7b6c17</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential SQL Injection Vulnerability for D4 นักศึกษา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>SQL injection is an attack in which malicious code is inserted into strings that are later passed to an instance of SQL Server for parsing and execution. Any procedure that constructs SQL statements should be reviewed for injection vulnerabilities because SQL Server will execute all syntactically valid queries that it receives. Even parameterized data can be manipulated by a skilled and determined attacker.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนน · ประวัติการแก้</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ef2f69e0-387e-4a7c-9107-ef304a699d51</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>0d64a30e-10bc-40e3-99d4-da420c7b6c17</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D2ef2f69e0-387e-4a7c-9107-ef304a699d51ddce0456-d444-4d81-be4a-42e7765869480d64a30e-10bc-40e3-99d4-da420c7b6c17</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>ddce0456-d444-4d81-be4a-42e776586948</b:FlowGuid><b:Id>213</b:Id><b:InteractionKey>ef2f69e0-387e-4a7c-9107-ef304a699d51:ddce0456-d444-4d81-be4a-42e776586948:0d64a30e-10bc-40e3-99d4-da420c7b6c17</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Excessive Resource Consumption for 4.2 ตรวจและบันทึกคะแนน or D4 นักศึกษา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does 4.2 ตรวจและบันทึกคะแนน or D4 นักศึกษา take explicit steps to control resource consumption? Resource consumption attacks can be hard to deal with, and there are times that it makes sense to let the OS do the job. Be careful that your resource requests don't deadlock, and that they do timeout.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนน · ประวัติการแก้</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ef2f69e0-387e-4a7c-9107-ef304a699d51</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>0d64a30e-10bc-40e3-99d4-da420c7b6c17</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7.1ef2f69e0-387e-4a7c-9107-ef304a699d513218b022-4c69-4799-a3fa-47205edaaacd72971263-a604-4105-a156-a34385c34227</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>3218b022-4c69-4799-a3fa-47205edaaacd</b:FlowGuid><b:Id>214</b:Id><b:InteractionKey>ef2f69e0-387e-4a7c-9107-ef304a699d51:3218b022-4c69-4799-a3fa-47205edaaacd:72971263-a604-4105-a156-a34385c34227</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Destination Data Store D5 คะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D5 คะแนน may be spoofed by an attacker and this may lead to data being written to the attacker's target instead of D5 คะแนน. Consider using a standard authentication mechanism to identify the destination data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอตรวจรหัสนักศึกษา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ef2f69e0-387e-4a7c-9107-ef304a699d51</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>72971263-a604-4105-a156-a34385c34227</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D2ef2f69e0-387e-4a7c-9107-ef304a699d513218b022-4c69-4799-a3fa-47205edaaacd72971263-a604-4105-a156-a34385c34227</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>3218b022-4c69-4799-a3fa-47205edaaacd</b:FlowGuid><b:Id>215</b:Id><b:InteractionKey>ef2f69e0-387e-4a7c-9107-ef304a699d51:3218b022-4c69-4799-a3fa-47205edaaacd:72971263-a604-4105-a156-a34385c34227</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Excessive Resource Consumption for 4.2 ตรวจและบันทึกคะแนน or D5 คะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does 4.2 ตรวจและบันทึกคะแนน or D5 คะแนน take explicit steps to control resource consumption? Resource consumption attacks can be hard to deal with, and there are times that it makes sense to let the OS do the job. Be careful that your resource requests don't deadlock, and that they do timeout.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอตรวจรหัสนักศึกษา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ef2f69e0-387e-4a7c-9107-ef304a699d51</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>72971263-a604-4105-a156-a34385c34227</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S772971263-a604-4105-a156-a34385c34227f5b845a5-7642-4848-be64-fdb07b25913def2f69e0-387e-4a7c-9107-ef304a699d51</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>f5b845a5-7642-4848-be64-fdb07b25913d</b:FlowGuid><b:Id>216</b:Id><b:InteractionKey>72971263-a604-4105-a156-a34385c34227:f5b845a5-7642-4848-be64-fdb07b25913d:ef2f69e0-387e-4a7c-9107-ef304a699d51</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Source Data Store D5 คะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D5 คะแนน may be spoofed by an attacker and this may lead to incorrect data delivered to 4.2 ตรวจและบันทึกคะแนน. Consider using a standard authentication mechanism to identify the source data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายชื่อและสถานะถอน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>72971263-a604-4105-a156-a34385c34227</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ef2f69e0-387e-4a7c-9107-ef304a699d51</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I2372971263-a604-4105-a156-a34385c34227f5b845a5-7642-4848-be64-fdb07b25913def2f69e0-387e-4a7c-9107-ef304a699d51</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>25f1ab97-5552-4fbe-9ef1-e73d9c561bb8</b:DrawingSurfaceGuid><b:FlowGuid>f5b845a5-7642-4848-be64-fdb07b25913d</b:FlowGuid><b:Id>217</b:Id><b:InteractionKey>72971263-a604-4105-a156-a34385c34227:f5b845a5-7642-4848-be64-fdb07b25913d:ef2f69e0-387e-4a7c-9107-ef304a699d51</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Access Control for a Resource</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Improper data protection of D5 คะแนน can allow an attacker to read information not intended for disclosure. Review authorization settings.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายชื่อและสถานะถอน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>72971263-a604-4105-a156-a34385c34227</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ef2f69e0-387e-4a7c-9107-ef304a699d51</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I23</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S3bf752304-447a-4c8a-8bd4-b2c80afdcd79c68c2a41-dba2-46bb-8c21-bbac56799a68e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>c68c2a41-dba2-46bb-8c21-bbac56799a68</b:FlowGuid><b:Id>218</b:Id><b:InteractionKey>bf752304-447a-4c8a-8bd4-b2c80afdcd79:c68c2a41-dba2-46bb-8c21-bbac56799a68:e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the ผู้สอน External Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้สอน may be spoofed by an attacker and this may lead to unauthorized access to 6.1 ประเมินผล CLO และติดตามนักศึกษา. Consider using a standard authentication mechanism to identify the external entity.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ผลการบรรลุ CLO · รายงาน Excel รายชื่อที่ต้องช่วยเหลือ</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>bf752304-447a-4c8a-8bd4-b2c80afdcd79</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E5bf752304-447a-4c8a-8bd4-b2c80afdcd79c68c2a41-dba2-46bb-8c21-bbac56799a68e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>c68c2a41-dba2-46bb-8c21-bbac56799a68</b:FlowGuid><b:Id>219</b:Id><b:InteractionKey>bf752304-447a-4c8a-8bd4-b2c80afdcd79:c68c2a41-dba2-46bb-8c21-bbac56799a68:e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>6.1 ประเมินผล CLO และติดตามนักศึกษา may be able to impersonate the context of ผู้สอน in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ผลการบรรลุ CLO · รายงาน Excel รายชื่อที่ต้องช่วยเหลือ</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>bf752304-447a-4c8a-8bd4-b2c80afdcd79</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7.1e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be4f2d6bb1-0f38-4f0a-bfb3-5fe96f548a72782935bb-a69c-4a0c-a166-daf122d94e1c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>4f2d6bb1-0f38-4f0a-bfb3-5fe96f548a72</b:FlowGuid><b:Id>220</b:Id><b:InteractionKey>e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be:4f2d6bb1-0f38-4f0a-bfb3-5fe96f548a72:782935bb-a69c-4a0c-a166-daf122d94e1c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Destination Data Store D2 รายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D2 รายวิชา may be spoofed by an attacker and this may lead to data being written to the attacker's target instead of D2 รายวิชา. Consider using a standard authentication mechanism to identify the destination data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอเกณฑ์ผ่าน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>782935bb-a69c-4a0c-a166-daf122d94e1c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T7e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be4f2d6bb1-0f38-4f0a-bfb3-5fe96f548a72782935bb-a69c-4a0c-a166-daf122d94e1c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>4f2d6bb1-0f38-4f0a-bfb3-5fe96f548a72</b:FlowGuid><b:Id>221</b:Id><b:InteractionKey>e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be:4f2d6bb1-0f38-4f0a-bfb3-5fe96f548a72:782935bb-a69c-4a0c-a166-daf122d94e1c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential SQL Injection Vulnerability for D2 รายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>SQL injection is an attack in which malicious code is inserted into strings that are later passed to an instance of SQL Server for parsing and execution. Any procedure that constructs SQL statements should be reviewed for injection vulnerabilities because SQL Server will execute all syntactically valid queries that it receives. Even parameterized data can be manipulated by a skilled and determined attacker.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอเกณฑ์ผ่าน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>782935bb-a69c-4a0c-a166-daf122d94e1c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D2e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be4f2d6bb1-0f38-4f0a-bfb3-5fe96f548a72782935bb-a69c-4a0c-a166-daf122d94e1c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>4f2d6bb1-0f38-4f0a-bfb3-5fe96f548a72</b:FlowGuid><b:Id>222</b:Id><b:InteractionKey>e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be:4f2d6bb1-0f38-4f0a-bfb3-5fe96f548a72:782935bb-a69c-4a0c-a166-daf122d94e1c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Excessive Resource Consumption for 6.1 ประเมินผล CLO และติดตามนักศึกษา or D2 รายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does 6.1 ประเมินผล CLO และติดตามนักศึกษา or D2 รายวิชา take explicit steps to control resource consumption? Resource consumption attacks can be hard to deal with, and there are times that it makes sense to let the OS do the job. Be careful that your resource requests don't deadlock, and that they do timeout.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอเกณฑ์ผ่าน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>782935bb-a69c-4a0c-a166-daf122d94e1c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7782935bb-a69c-4a0c-a166-daf122d94e1c34fc6ce3-a086-4259-b310-5cda9dfa9c46e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>34fc6ce3-a086-4259-b310-5cda9dfa9c46</b:FlowGuid><b:Id>223</b:Id><b:InteractionKey>782935bb-a69c-4a0c-a166-daf122d94e1c:34fc6ce3-a086-4259-b310-5cda9dfa9c46:e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Source Data Store D2 รายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D2 รายวิชา may be spoofed by an attacker and this may lead to incorrect data delivered to 6.1 ประเมินผล CLO และติดตามนักศึกษา. Consider using a standard authentication mechanism to identify the source data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>เกณฑ์ผ่านของรายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>782935bb-a69c-4a0c-a166-daf122d94e1c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I23782935bb-a69c-4a0c-a166-daf122d94e1c34fc6ce3-a086-4259-b310-5cda9dfa9c46e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>34fc6ce3-a086-4259-b310-5cda9dfa9c46</b:FlowGuid><b:Id>224</b:Id><b:InteractionKey>782935bb-a69c-4a0c-a166-daf122d94e1c:34fc6ce3-a086-4259-b310-5cda9dfa9c46:e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Access Control for a Resource</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Improper data protection of D2 รายวิชา can allow an attacker to read information not intended for disclosure. Review authorization settings.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>เกณฑ์ผ่านของรายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>782935bb-a69c-4a0c-a166-daf122d94e1c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I23</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7.1e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be9ad732b8-c716-44dd-b82e-f3dd5099cfb9e22e88b0-3b34-4992-a953-52751e8cfcda</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>9ad732b8-c716-44dd-b82e-f3dd5099cfb9</b:FlowGuid><b:Id>225</b:Id><b:InteractionKey>e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be:9ad732b8-c716-44dd-b82e-f3dd5099cfb9:e22e88b0-3b34-4992-a953-52751e8cfcda</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Destination Data Store D4 นักศึกษา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D4 นักศึกษา may be spoofed by an attacker and this may lead to data being written to the attacker's target instead of D4 นักศึกษา. Consider using a standard authentication mechanism to identify the destination data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอคะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>e22e88b0-3b34-4992-a953-52751e8cfcda</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T7e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be9ad732b8-c716-44dd-b82e-f3dd5099cfb9e22e88b0-3b34-4992-a953-52751e8cfcda</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>9ad732b8-c716-44dd-b82e-f3dd5099cfb9</b:FlowGuid><b:Id>226</b:Id><b:InteractionKey>e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be:9ad732b8-c716-44dd-b82e-f3dd5099cfb9:e22e88b0-3b34-4992-a953-52751e8cfcda</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential SQL Injection Vulnerability for D4 นักศึกษา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>SQL injection is an attack in which malicious code is inserted into strings that are later passed to an instance of SQL Server for parsing and execution. Any procedure that constructs SQL statements should be reviewed for injection vulnerabilities because SQL Server will execute all syntactically valid queries that it receives. Even parameterized data can be manipulated by a skilled and determined attacker.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอคะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>e22e88b0-3b34-4992-a953-52751e8cfcda</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D2e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be9ad732b8-c716-44dd-b82e-f3dd5099cfb9e22e88b0-3b34-4992-a953-52751e8cfcda</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>9ad732b8-c716-44dd-b82e-f3dd5099cfb9</b:FlowGuid><b:Id>227</b:Id><b:InteractionKey>e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be:9ad732b8-c716-44dd-b82e-f3dd5099cfb9:e22e88b0-3b34-4992-a953-52751e8cfcda</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Excessive Resource Consumption for 6.1 ประเมินผล CLO และติดตามนักศึกษา or D4 นักศึกษา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does 6.1 ประเมินผล CLO และติดตามนักศึกษา or D4 นักศึกษา take explicit steps to control resource consumption? Resource consumption attacks can be hard to deal with, and there are times that it makes sense to let the OS do the job. Be careful that your resource requests don't deadlock, and that they do timeout.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอคะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>e22e88b0-3b34-4992-a953-52751e8cfcda</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7e22e88b0-3b34-4992-a953-52751e8cfcda0875e831-0b39-4ed3-92ee-31c9983d879ae9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>0875e831-0b39-4ed3-92ee-31c9983d879a</b:FlowGuid><b:Id>228</b:Id><b:InteractionKey>e22e88b0-3b34-4992-a953-52751e8cfcda:0875e831-0b39-4ed3-92ee-31c9983d879a:e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Source Data Store D4 นักศึกษา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D4 นักศึกษา may be spoofed by an attacker and this may lead to incorrect data delivered to 6.1 ประเมินผล CLO และติดตามนักศึกษา. Consider using a standard authentication mechanism to identify the source data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e22e88b0-3b34-4992-a953-52751e8cfcda</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I23e22e88b0-3b34-4992-a953-52751e8cfcda0875e831-0b39-4ed3-92ee-31c9983d879ae9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>0875e831-0b39-4ed3-92ee-31c9983d879a</b:FlowGuid><b:Id>229</b:Id><b:InteractionKey>e22e88b0-3b34-4992-a953-52751e8cfcda:0875e831-0b39-4ed3-92ee-31c9983d879a:e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Access Control for a Resource</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Improper data protection of D4 นักศึกษา can allow an attacker to read information not intended for disclosure. Review authorization settings.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e22e88b0-3b34-4992-a953-52751e8cfcda</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I23</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7.1e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be94d7fec9-39cc-449c-ae55-fa852919693630bd1f8e-e311-4fb8-987d-d47f5b757ac1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>94d7fec9-39cc-449c-ae55-fa8529196936</b:FlowGuid><b:Id>230</b:Id><b:InteractionKey>e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be:94d7fec9-39cc-449c-ae55-fa8529196936:30bd1f8e-e311-4fb8-987d-d47f5b757ac1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Destination Data Store D3 CLO กิจกรรม และเกณฑ์</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D3 CLO กิจกรรม และเกณฑ์ may be spoofed by an attacker and this may lead to data being written to the attacker's target instead of D3 CLO กิจกรรม และเกณฑ์. Consider using a standard authentication mechanism to identify the destination data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอ CLO และกิจกรรม</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>30bd1f8e-e311-4fb8-987d-d47f5b757ac1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T7e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be94d7fec9-39cc-449c-ae55-fa852919693630bd1f8e-e311-4fb8-987d-d47f5b757ac1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>94d7fec9-39cc-449c-ae55-fa8529196936</b:FlowGuid><b:Id>231</b:Id><b:InteractionKey>e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be:94d7fec9-39cc-449c-ae55-fa8529196936:30bd1f8e-e311-4fb8-987d-d47f5b757ac1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential SQL Injection Vulnerability for D3 CLO กิจกรรม และเกณฑ์</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>SQL injection is an attack in which malicious code is inserted into strings that are later passed to an instance of SQL Server for parsing and execution. Any procedure that constructs SQL statements should be reviewed for injection vulnerabilities because SQL Server will execute all syntactically valid queries that it receives. Even parameterized data can be manipulated by a skilled and determined attacker.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอ CLO และกิจกรรม</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>30bd1f8e-e311-4fb8-987d-d47f5b757ac1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D2e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be94d7fec9-39cc-449c-ae55-fa852919693630bd1f8e-e311-4fb8-987d-d47f5b757ac1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>94d7fec9-39cc-449c-ae55-fa8529196936</b:FlowGuid><b:Id>232</b:Id><b:InteractionKey>e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be:94d7fec9-39cc-449c-ae55-fa8529196936:30bd1f8e-e311-4fb8-987d-d47f5b757ac1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Excessive Resource Consumption for 6.1 ประเมินผล CLO และติดตามนักศึกษา or D3 CLO กิจกรรม และเกณฑ์</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does 6.1 ประเมินผล CLO และติดตามนักศึกษา or D3 CLO กิจกรรม และเกณฑ์ take explicit steps to control resource consumption? Resource consumption attacks can be hard to deal with, and there are times that it makes sense to let the OS do the job. Be careful that your resource requests don't deadlock, and that they do timeout.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอ CLO และกิจกรรม</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>30bd1f8e-e311-4fb8-987d-d47f5b757ac1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S730bd1f8e-e311-4fb8-987d-d47f5b757ac163c276ec-cc37-445a-9323-507ad3da7a6ae9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>63c276ec-cc37-445a-9323-507ad3da7a6a</b:FlowGuid><b:Id>233</b:Id><b:InteractionKey>30bd1f8e-e311-4fb8-987d-d47f5b757ac1:63c276ec-cc37-445a-9323-507ad3da7a6a:e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Source Data Store D3 CLO กิจกรรม และเกณฑ์</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D3 CLO กิจกรรม และเกณฑ์ may be spoofed by an attacker and this may lead to incorrect data delivered to 6.1 ประเมินผล CLO และติดตามนักศึกษา. Consider using a standard authentication mechanism to identify the source data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>CLO · กิจกรรม · น้ำหนัก</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>30bd1f8e-e311-4fb8-987d-d47f5b757ac1</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I2330bd1f8e-e311-4fb8-987d-d47f5b757ac163c276ec-cc37-445a-9323-507ad3da7a6ae9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>63c276ec-cc37-445a-9323-507ad3da7a6a</b:FlowGuid><b:Id>234</b:Id><b:InteractionKey>30bd1f8e-e311-4fb8-987d-d47f5b757ac1:63c276ec-cc37-445a-9323-507ad3da7a6a:e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Access Control for a Resource</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Improper data protection of D3 CLO กิจกรรม และเกณฑ์ can allow an attacker to read information not intended for disclosure. Review authorization settings.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>CLO · กิจกรรม · น้ำหนัก</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>30bd1f8e-e311-4fb8-987d-d47f5b757ac1</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I23</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7.1e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be80f3d191-9bfe-4639-b26a-48ae84527af43a183061-e82a-4278-ac3d-b13f48ea57e9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>80f3d191-9bfe-4639-b26a-48ae84527af4</b:FlowGuid><b:Id>235</b:Id><b:InteractionKey>e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be:80f3d191-9bfe-4639-b26a-48ae84527af4:3a183061-e82a-4278-ac3d-b13f48ea57e9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Destination Data Store D5 คะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D5 คะแนน may be spoofed by an attacker and this may lead to data being written to the attacker's target instead of D5 คะแนน. Consider using a standard authentication mechanism to identify the destination data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอรายชื่อ</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3a183061-e82a-4278-ac3d-b13f48ea57e9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D2e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be80f3d191-9bfe-4639-b26a-48ae84527af43a183061-e82a-4278-ac3d-b13f48ea57e9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>80f3d191-9bfe-4639-b26a-48ae84527af4</b:FlowGuid><b:Id>236</b:Id><b:InteractionKey>e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be:80f3d191-9bfe-4639-b26a-48ae84527af4:3a183061-e82a-4278-ac3d-b13f48ea57e9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Excessive Resource Consumption for 6.1 ประเมินผล CLO และติดตามนักศึกษา or D5 คะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does 6.1 ประเมินผล CLO และติดตามนักศึกษา or D5 คะแนน take explicit steps to control resource consumption? Resource consumption attacks can be hard to deal with, and there are times that it makes sense to let the OS do the job. Be careful that your resource requests don't deadlock, and that they do timeout.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอรายชื่อ</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3a183061-e82a-4278-ac3d-b13f48ea57e9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S73a183061-e82a-4278-ac3d-b13f48ea57e9c0eab6d3-c600-4aac-999b-638507fac020e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>c0eab6d3-c600-4aac-999b-638507fac020</b:FlowGuid><b:Id>237</b:Id><b:InteractionKey>3a183061-e82a-4278-ac3d-b13f48ea57e9:c0eab6d3-c600-4aac-999b-638507fac020:e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Source Data Store D5 คะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D5 คะแนน may be spoofed by an attacker and this may lead to incorrect data delivered to 6.1 ประเมินผล CLO และติดตามนักศึกษา. Consider using a standard authentication mechanism to identify the source data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายชื่อ (ไม่นับผู้ถอน)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>3a183061-e82a-4278-ac3d-b13f48ea57e9</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I233a183061-e82a-4278-ac3d-b13f48ea57e9c0eab6d3-c600-4aac-999b-638507fac020e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>c0eab6d3-c600-4aac-999b-638507fac020</b:FlowGuid><b:Id>238</b:Id><b:InteractionKey>3a183061-e82a-4278-ac3d-b13f48ea57e9:c0eab6d3-c600-4aac-999b-638507fac020:e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Access Control for a Resource</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Improper data protection of D5 คะแนน can allow an attacker to read information not intended for disclosure. Review authorization settings.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายชื่อ (ไม่นับผู้ถอน)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>3a183061-e82a-4278-ac3d-b13f48ea57e9</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>e9a7eaea-e508-43bb-8e9c-9fa8f7b7b5be</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I23</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S3bf752304-447a-4c8a-8bd4-b2c80afdcd795ae3594e-3e66-4369-bf89-a204a92f6defb53f4936-2fd9-4b5a-961d-015067f3fd8e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>5ae3594e-3e66-4369-bf89-a204a92f6def</b:FlowGuid><b:Id>239</b:Id><b:InteractionKey>bf752304-447a-4c8a-8bd4-b2c80afdcd79:5ae3594e-3e66-4369-bf89-a204a92f6def:b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the ผู้สอน External Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ผู้สอน may be spoofed by an attacker and this may lead to unauthorized access to 6.1 ประเมินผล CLO และติดตามนักศึกษา. Consider using a standard authentication mechanism to identify the external entity.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ช่วงเกรด · คำสั่งตัดเกรด การปรับเกรดพร้อมเหตุผล</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>bf752304-447a-4c8a-8bd4-b2c80afdcd79</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E5bf752304-447a-4c8a-8bd4-b2c80afdcd795ae3594e-3e66-4369-bf89-a204a92f6defb53f4936-2fd9-4b5a-961d-015067f3fd8e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>5ae3594e-3e66-4369-bf89-a204a92f6def</b:FlowGuid><b:Id>240</b:Id><b:InteractionKey>bf752304-447a-4c8a-8bd4-b2c80afdcd79:5ae3594e-3e66-4369-bf89-a204a92f6def:b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>6.1 ประเมินผล CLO และติดตามนักศึกษา may be able to impersonate the context of ผู้สอน in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ช่วงเกรด · คำสั่งตัดเกรด การปรับเกรดพร้อมเหตุผล</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>bf752304-447a-4c8a-8bd4-b2c80afdcd79</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7.1b53f4936-2fd9-4b5a-961d-015067f3fd8e102f77d2-90dd-4bde-b8cf-38d1b92ae03a782935bb-a69c-4a0c-a166-daf122d94e1c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>102f77d2-90dd-4bde-b8cf-38d1b92ae03a</b:FlowGuid><b:Id>241</b:Id><b:InteractionKey>b53f4936-2fd9-4b5a-961d-015067f3fd8e:102f77d2-90dd-4bde-b8cf-38d1b92ae03a:782935bb-a69c-4a0c-a166-daf122d94e1c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Destination Data Store D2 รายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D2 รายวิชา may be spoofed by an attacker and this may lead to data being written to the attacker's target instead of D2 รายวิชา. Consider using a standard authentication mechanism to identify the destination data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอวิธีตัดเกรด</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>782935bb-a69c-4a0c-a166-daf122d94e1c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T7b53f4936-2fd9-4b5a-961d-015067f3fd8e102f77d2-90dd-4bde-b8cf-38d1b92ae03a782935bb-a69c-4a0c-a166-daf122d94e1c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>102f77d2-90dd-4bde-b8cf-38d1b92ae03a</b:FlowGuid><b:Id>242</b:Id><b:InteractionKey>b53f4936-2fd9-4b5a-961d-015067f3fd8e:102f77d2-90dd-4bde-b8cf-38d1b92ae03a:782935bb-a69c-4a0c-a166-daf122d94e1c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential SQL Injection Vulnerability for D2 รายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>SQL injection is an attack in which malicious code is inserted into strings that are later passed to an instance of SQL Server for parsing and execution. Any procedure that constructs SQL statements should be reviewed for injection vulnerabilities because SQL Server will execute all syntactically valid queries that it receives. Even parameterized data can be manipulated by a skilled and determined attacker.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอวิธีตัดเกรด</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>782935bb-a69c-4a0c-a166-daf122d94e1c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D2b53f4936-2fd9-4b5a-961d-015067f3fd8e102f77d2-90dd-4bde-b8cf-38d1b92ae03a782935bb-a69c-4a0c-a166-daf122d94e1c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>102f77d2-90dd-4bde-b8cf-38d1b92ae03a</b:FlowGuid><b:Id>243</b:Id><b:InteractionKey>b53f4936-2fd9-4b5a-961d-015067f3fd8e:102f77d2-90dd-4bde-b8cf-38d1b92ae03a:782935bb-a69c-4a0c-a166-daf122d94e1c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Excessive Resource Consumption for 6.1 ประเมินผล CLO และติดตามนักศึกษา or D2 รายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does 6.1 ประเมินผล CLO และติดตามนักศึกษา or D2 รายวิชา take explicit steps to control resource consumption? Resource consumption attacks can be hard to deal with, and there are times that it makes sense to let the OS do the job. Be careful that your resource requests don't deadlock, and that they do timeout.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอวิธีตัดเกรด</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>782935bb-a69c-4a0c-a166-daf122d94e1c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7782935bb-a69c-4a0c-a166-daf122d94e1c138a81c8-c421-42d9-a71e-eef03d3821b9b53f4936-2fd9-4b5a-961d-015067f3fd8e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>138a81c8-c421-42d9-a71e-eef03d3821b9</b:FlowGuid><b:Id>244</b:Id><b:InteractionKey>782935bb-a69c-4a0c-a166-daf122d94e1c:138a81c8-c421-42d9-a71e-eef03d3821b9:b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Source Data Store D2 รายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D2 รายวิชา may be spoofed by an attacker and this may lead to incorrect data delivered to 6.1 ประเมินผล CLO และติดตามนักศึกษา. Consider using a standard authentication mechanism to identify the source data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>วิธีตัดเกรด</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>782935bb-a69c-4a0c-a166-daf122d94e1c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I23782935bb-a69c-4a0c-a166-daf122d94e1c138a81c8-c421-42d9-a71e-eef03d3821b9b53f4936-2fd9-4b5a-961d-015067f3fd8e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>138a81c8-c421-42d9-a71e-eef03d3821b9</b:FlowGuid><b:Id>245</b:Id><b:InteractionKey>782935bb-a69c-4a0c-a166-daf122d94e1c:138a81c8-c421-42d9-a71e-eef03d3821b9:b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Access Control for a Resource</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Improper data protection of D2 รายวิชา can allow an attacker to read information not intended for disclosure. Review authorization settings.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>วิธีตัดเกรด</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>782935bb-a69c-4a0c-a166-daf122d94e1c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I23</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S730bd1f8e-e311-4fb8-987d-d47f5b757ac1835fc8de-3f0b-4ad1-98c1-5233fdcc14e6b53f4936-2fd9-4b5a-961d-015067f3fd8e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>835fc8de-3f0b-4ad1-98c1-5233fdcc14e6</b:FlowGuid><b:Id>246</b:Id><b:InteractionKey>30bd1f8e-e311-4fb8-987d-d47f5b757ac1:835fc8de-3f0b-4ad1-98c1-5233fdcc14e6:b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Source Data Store D3 CLO กิจกรรม และเกณฑ์</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D3 CLO กิจกรรม และเกณฑ์ may be spoofed by an attacker and this may lead to incorrect data delivered to 6.1 ประเมินผล CLO และติดตามนักศึกษา. Consider using a standard authentication mechanism to identify the source data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>กิจกรรมและน้ำหนัก</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>30bd1f8e-e311-4fb8-987d-d47f5b757ac1</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I2330bd1f8e-e311-4fb8-987d-d47f5b757ac1835fc8de-3f0b-4ad1-98c1-5233fdcc14e6b53f4936-2fd9-4b5a-961d-015067f3fd8e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>835fc8de-3f0b-4ad1-98c1-5233fdcc14e6</b:FlowGuid><b:Id>247</b:Id><b:InteractionKey>30bd1f8e-e311-4fb8-987d-d47f5b757ac1:835fc8de-3f0b-4ad1-98c1-5233fdcc14e6:b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Access Control for a Resource</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Improper data protection of D3 CLO กิจกรรม และเกณฑ์ can allow an attacker to read information not intended for disclosure. Review authorization settings.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>กิจกรรมและน้ำหนัก</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>30bd1f8e-e311-4fb8-987d-d47f5b757ac1</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I23</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7.1b53f4936-2fd9-4b5a-961d-015067f3fd8e3ff1e4b0-9989-48e0-b05a-3105728ddb2730bd1f8e-e311-4fb8-987d-d47f5b757ac1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>3ff1e4b0-9989-48e0-b05a-3105728ddb27</b:FlowGuid><b:Id>248</b:Id><b:InteractionKey>b53f4936-2fd9-4b5a-961d-015067f3fd8e:3ff1e4b0-9989-48e0-b05a-3105728ddb27:30bd1f8e-e311-4fb8-987d-d47f5b757ac1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Destination Data Store D3 CLO กิจกรรม และเกณฑ์</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D3 CLO กิจกรรม และเกณฑ์ may be spoofed by an attacker and this may lead to data being written to the attacker's target instead of D3 CLO กิจกรรม และเกณฑ์. Consider using a standard authentication mechanism to identify the destination data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอน้ำหนักกิจกรรม</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>30bd1f8e-e311-4fb8-987d-d47f5b757ac1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T7b53f4936-2fd9-4b5a-961d-015067f3fd8e3ff1e4b0-9989-48e0-b05a-3105728ddb2730bd1f8e-e311-4fb8-987d-d47f5b757ac1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>3ff1e4b0-9989-48e0-b05a-3105728ddb27</b:FlowGuid><b:Id>249</b:Id><b:InteractionKey>b53f4936-2fd9-4b5a-961d-015067f3fd8e:3ff1e4b0-9989-48e0-b05a-3105728ddb27:30bd1f8e-e311-4fb8-987d-d47f5b757ac1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential SQL Injection Vulnerability for D3 CLO กิจกรรม และเกณฑ์</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>SQL injection is an attack in which malicious code is inserted into strings that are later passed to an instance of SQL Server for parsing and execution. Any procedure that constructs SQL statements should be reviewed for injection vulnerabilities because SQL Server will execute all syntactically valid queries that it receives. Even parameterized data can be manipulated by a skilled and determined attacker.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอน้ำหนักกิจกรรม</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>30bd1f8e-e311-4fb8-987d-d47f5b757ac1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D2b53f4936-2fd9-4b5a-961d-015067f3fd8e3ff1e4b0-9989-48e0-b05a-3105728ddb2730bd1f8e-e311-4fb8-987d-d47f5b757ac1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>3ff1e4b0-9989-48e0-b05a-3105728ddb27</b:FlowGuid><b:Id>250</b:Id><b:InteractionKey>b53f4936-2fd9-4b5a-961d-015067f3fd8e:3ff1e4b0-9989-48e0-b05a-3105728ddb27:30bd1f8e-e311-4fb8-987d-d47f5b757ac1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Excessive Resource Consumption for 6.1 ประเมินผล CLO และติดตามนักศึกษา or D3 CLO กิจกรรม และเกณฑ์</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does 6.1 ประเมินผล CLO และติดตามนักศึกษา or D3 CLO กิจกรรม และเกณฑ์ take explicit steps to control resource consumption? Resource consumption attacks can be hard to deal with, and there are times that it makes sense to let the OS do the job. Be careful that your resource requests don't deadlock, and that they do timeout.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอน้ำหนักกิจกรรม</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>30bd1f8e-e311-4fb8-987d-d47f5b757ac1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7e22e88b0-3b34-4992-a953-52751e8cfcdaea89b429-69b8-4c2f-bef2-8df03b1ee9c3b53f4936-2fd9-4b5a-961d-015067f3fd8e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6494801e-5c12-44c5-9f44-0efa1e5bce93</b:DrawingSurfaceGuid><b:FlowGuid>ea89b429-69b8-4c2f-bef2-8df03b1ee9c3</b:FlowGuid><b:Id>251</b:Id><b:InteractionKey>e22e88b0-3b34-4992-a953-52751e8cfcda:ea89b429-69b8-4c2f-bef2-8df03b1ee9c3:b53f4936-2fd9-4b5a-961d-015067f3fd8e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Source Data Store D4 นักศึกษา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D4 นักศึกษา may be spoofed by an attacker and this may lead to incorrect data delivered to 6.1 ประเมินผล CLO และติดตามนักศึกษา. Consider using a standard authentication mechanism to identify the source data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอคะแนน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e22e88b0-3b34-4992-a953-52751e8cfcda</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b53f4936-2fd9-4b5a-961d-015067