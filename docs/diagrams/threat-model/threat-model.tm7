yValueOfstringstring></b:Properties><b:SourceGuid>1f8976b5-43ee-4f0c-9f16-d8889a8ebe44</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f21494b5-dcc7-4d98-9dd9-3c701f15d4fc</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E61f8976b5-43ee-4f0c-9f16-d8889a8ebe44c559f97b-e30a-4469-b622-d8e0160236d2f21494b5-dcc7-4d98-9dd9-3c701f15d4fc</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>0df06edf-e481-4ed2-b4c5-4c53b6b2b1e4</b:DrawingSurfaceGuid><b:FlowGuid>c559f97b-e30a-4469-b622-d8e0160236d2</b:FlowGuid><b:Id>297</b:Id><b:InteractionKey>1f8976b5-43ee-4f0c-9f16-d8889a8ebe44:c559f97b-e30a-4469-b622-d8e0160236d2:f21494b5-dcc7-4d98-9dd9-3c701f15d4fc</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>2.0 จัดการรายวิชาและผู้สอน May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D1 บัญชีผู้ใช้ may be able to remotely execute code for 2.0 จัดการรายวิชาและผู้สอน.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายชื่อผู้สอน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>1f8976b5-43ee-4f0c-9f16-d8889a8ebe44</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f21494b5-dcc7-4d98-9dd9-3c701f15d4fc</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E71f8976b5-43ee-4f0c-9f16-d8889a8ebe44c559f97b-e30a-4469-b622-d8e0160236d2f21494b5-dcc7-4d98-9dd9-3c701f15d4fc</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>0df06edf-e481-4ed2-b4c5-4c53b6b2b1e4</b:DrawingSurfaceGuid><b:FlowGuid>c559f97b-e30a-4469-b622-d8e0160236d2</b:FlowGuid><b:Id>298</b:Id><b:InteractionKey>1f8976b5-43ee-4f0c-9f16-d8889a8ebe44:c559f97b-e30a-4469-b622-d8e0160236d2:f21494b5-dcc7-4d98-9dd9-3c701f15d4fc</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in 2.0 จัดการรายวิชาและผู้สอน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into 2.0 จัดการรายวิชาและผู้สอน in order to change the flow of program execution within 2.0 จัดการรายวิชาและผู้สอน to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>รายชื่อผู้สอน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>1f8976b5-43ee-4f0c-9f16-d8889a8ebe44</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f21494b5-dcc7-4d98-9dd9-3c701f15d4fc</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S1f21494b5-dcc7-4d98-9dd9-3c701f15d4fccb63383c-9398-4813-9ec3-b79b542afd9146a3fc6e-cb1e-40ec-a7c5-c6afecc8b41c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>0df06edf-e481-4ed2-b4c5-4c53b6b2b1e4</b:DrawingSurfaceGuid><b:FlowGuid>cb63383c-9398-4813-9ec3-b79b542afd91</b:FlowGuid><b:Id>299</b:Id><b:InteractionKey>f21494b5-dcc7-4d98-9dd9-3c701f15d4fc:cb63383c-9398-4813-9ec3-b79b542afd91:46a3fc6e-cb1e-40ec-a7c5-c6afecc8b41c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the 2.0 จัดการรายวิชาและผู้สอน Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>2.0 จัดการรายวิชาและผู้สอน may be spoofed by an attacker and this may lead to unauthorized access to D2 รายวิชา. Consider using a standard authentication mechanism to identify the source process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ข้อมูลรายวิชา · ผู้สอน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f21494b5-dcc7-4d98-9dd9-3c701f15d4fc</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>46a3fc6e-cb1e-40ec-a7c5-c6afecc8b41c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T18f21494b5-dcc7-4d98-9dd9-3c701f15d4fccb63383c-9398-4813-9ec3-b79b542afd9146a3fc6e-cb1e-40ec-a7c5-c6afecc8b41c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>0df06edf-e481-4ed2-b4c5-4c53b6b2b1e4</b:DrawingSurfaceGuid><b:FlowGuid>cb63383c-9398-4813-9ec3-b79b542afd91</b:FlowGuid><b:Id>300</b:Id><b:InteractionKey>f21494b5-dcc7-4d98-9dd9-3c701f15d4fc:cb63383c-9398-4813-9ec3-b79b542afd91:46a3fc6e-cb1e-40ec-a7c5-c6afecc8b41c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>The D2 รายวิชา Data Store Could Be Corrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across ข้อมูลรายวิชา · ผู้สอน may be tampered with by an attacker. This may lead to corruption of D2 รายวิชา. Ensure the integrity of the data flow to the data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ข้อมูลรายวิชา · ผู้สอน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f21494b5-dcc7-4d98-9dd9-3c701f15d4fc</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>46a3fc6e-cb1e-40ec-a7c5-c6afecc8b41c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T18</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R8f21494b5-dcc7-4d98-9dd9-3c701f15d4fccb63383c-9398-4813-9ec3-b79b542afd9146a3fc6e-cb1e-40ec-a7c5-c6afecc8b41c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>0df06edf-e481-4ed2-b4c5-4c53b6b2b1e4</b:DrawingSurfaceGuid><b:FlowGuid>cb63383c-9398-4813-9ec3-b79b542afd91</b:FlowGuid><b:Id>301</b:Id><b:InteractionKey>f21494b5-dcc7-4d98-9dd9-3c701f15d4fc:cb63383c-9398-4813-9ec3-b79b542afd91:46a3fc6e-cb1e-40ec-a7c5-c6afecc8b41c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Denies D2 รายวิชา Potentially Writing Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>D2 รายวิชา claims that it did not write data received from an entity on the other side of the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ข้อมูลรายวิชา · ผู้สอน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f21494b5-dcc7-4d98-9dd9-3c701f15d4fc</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>46a3fc6e-cb1e-40ec-a7c5-c6afecc8b41c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R8</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I6f21494b5-dcc7-4d98-9dd9-3c701f15d4fccb63383c-9398-4813-9ec3-b79b542afd9146a3fc6e-cb1e-40ec-a7c5-c6afecc8b41c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>0df06edf-e481-4ed2-b4c5-4c53b6b2b1e4</b:DrawingSurfaceGuid><b:FlowGuid>cb63383c-9398-4813-9ec3-b79b542afd91</b:FlowGuid><b:Id>302</b:Id><b:InteractionKey>f21494b5-dcc7-4d98-9dd9-3c701f15d4fc:cb63383c-9398-4813-9ec3-b79b542afd91:46a3fc6e-cb1e-40ec-a7c5-c6afecc8b41c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across ข้อมูลรายวิชา · ผู้สอน may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ข้อมูลรายวิชา · ผู้สอน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f21494b5-dcc7-4d98-9dd9-3c701f15d4fc</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>46a3fc6e-cb1e-40ec-a7c5-c6afecc8b41c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4f21494b5-dcc7-4d98-9dd9-3c701f15d4fccb63383c-9398-4813-9ec3-b79b542afd9146a3fc6e-cb1e-40ec-a7c5-c6afecc8b41c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>0df06edf-e481-4ed2-b4c5-4c53b6b2b1e4</b:DrawingSurfaceGuid><b:FlowGuid>cb63383c-9398-4813-9ec3-b79b542afd91</b:FlowGuid><b:Id>303</b:Id><b:InteractionKey>f21494b5-dcc7-4d98-9dd9-3c701f15d4fc:cb63383c-9398-4813-9ec3-b79b542afd91:46a3fc6e-cb1e-40ec-a7c5-c6afecc8b41c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow ข้อมูลรายวิชา · ผู้สอน Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ข้อมูลรายวิชา · ผู้สอน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f21494b5-dcc7-4d98-9dd9-3c701f15d4fc</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>46a3fc6e-cb1e-40ec-a7c5-c6afecc8b41c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D5f21494b5-dcc7-4d98-9dd9-3c701f15d4fccb63383c-9398-4813-9ec3-b79b542afd9146a3fc6e-cb1e-40ec-a7c5-c6afecc8b41c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>0df06edf-e481-4ed2-b4c5-4c53b6b2b1e4</b:DrawingSurfaceGuid><b:FlowGuid>cb63383c-9398-4813-9ec3-b79b542afd91</b:FlowGuid><b:Id>304</b:Id><b:InteractionKey>f21494b5-dcc7-4d98-9dd9-3c701f15d4fc:cb63383c-9398-4813-9ec3-b79b542afd91:46a3fc6e-cb1e-40ec-a7c5-c6afecc8b41c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Inaccessible</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent prevents access to a data store on the other side of the trust boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ข้อมูลรายวิชา · ผู้สอน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f21494b5-dcc7-4d98-9dd9-3c701f15d4fc</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>46a3fc6e-cb1e-40ec-a7c5-c6afecc8b41c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S246a3fc6e-cb1e-40ec-a7c5-c6afecc8b41c69a12ef2-1649-4f7e-891f-9939352d1aa5f21494b5-dcc7-4d98-9dd9-3c701f15d4fc</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>0df06edf-e481-4ed2-b4c5-4c53b6b2b1e4</b:DrawingSurfaceGuid><b:FlowGuid>69a12ef2-1649-4f7e-891f-9939352d1aa5</b:FlowGuid><b:Id>305</b:Id><b:InteractionKey>46a3fc6e-cb1e-40ec-a7c5-c6afecc8b41c:69a12ef2-1649-4f7e-891f-9939352d1aa5:f21494b5-dcc7-4d98-9dd9-3c701f15d4fc</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the 2.0 จัดการรายวิชาและผู้สอน Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>2.0 จัดการรายวิชาและผู้สอน may be spoofed by an attacker and this may lead to information disclosure by D2 รายวิชา. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ข้อมูลรายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>46a3fc6e-cb1e-40ec-a7c5-c6afecc8b41c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f21494b5-dcc7-4d98-9dd9-3c701f15d4fc</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R646a3fc6e-cb1e-40ec-a7c5-c6afecc8b41c69a12ef2-1649-4f7e-891f-9939352d1aa5f21494b5-dcc7-4d98-9dd9-3c701f15d4fc</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>0df06edf-e481-4ed2-b4c5-4c53b6b2b1e4</b:DrawingSurfaceGuid><b:FlowGuid>69a12ef2-1649-4f7e-891f-9939352d1aa5</b:FlowGuid><b:Id>306</b:Id><b:InteractionKey>46a3fc6e-cb1e-40ec-a7c5-c6afecc8b41c:69a12ef2-1649-4f7e-891f-9939352d1aa5:f21494b5-dcc7-4d98-9dd9-3c701f15d4fc</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by 2.0 จัดการรายวิชาและผู้สอน</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>2.0 จัดการรายวิชาและผู้สอน claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ข้อมูลรายวิชา</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>46a3fc6e-cb1e-40ec-a7c5-c6afecc8b41c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f21494b5-dcc7-4d98-9dd9-3c