>UserThreatDescription</a:Key><a:Value>5.0 บันทึกและนำเข้าคะแนน crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คะแนนที่มีอยู่</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>fbe1c175-d357-4073-8a6f-3ecd790c743c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a8b08151-2c62-4840-b773-a1c5bc9dc8c1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4fbe1c175-d357-4073-8a6f-3ecd790c743c52cbc5e9-5961-4225-a72d-713782196b00a8b08151-2c62-4840-b773-a1c5bc9dc8c1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>0df06edf-e481-4ed2-b4c5-4c53b6b2b1e4</b:DrawingSurfaceGuid><b:FlowGuid>52cbc5e9-5961-4225-a72d-713782196b00</b:FlowGuid><b:Id>361</b:Id><b:InteractionKey>fbe1c175-d357-4073-8a6f-3ecd790c743c:52cbc5e9-5961-4225-a72d-713782196b00:a8b08151-2c62-4840-b773-a1c5bc9dc8c1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow คะแนนที่มีอยู่ Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to se