yValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>คำขอเข้าสู่ระบบ การอนุมัติและปิดบัญชี</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>55aa40c0-7498-452a-b45b-52f39cf002c5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E555aa40c0-7498-452a-b45b-52f39cf002c57e3cc16e-58cc-41fa-acfd-ffb3ed8d266ffa2e0525-17fd-47e8-8a55-efdca2f2acb5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>6bb13faf-99a2-46be-9b0d-a25075c9a323</b:DrawingSurfaceGuid><b:FlowGuid>7e3cc16e-58cc-41fa-acfd-ffb3ed8d266f</b:FlowGuid><b:Id>2</b:Id><b:InteractionKey>55aa40c0-7498-452a-b45b-52f39cf002c5:7e3cc16e-58cc-41fa-acfd-ffb3ed8d266f:fa2e0525-17fd-47e8-8a55-efdca2f2acb5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>1.0 เข้าสู่ระบบและดูแลบัญชี