y"></mxGeometry></mxCell><mxCell id="e21" value="" style="endArrow=none;html=1;strokeColor=#1E233C;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v5" target="v16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22" value="" style="endArrow=none;html=1;strokeColor=#1E233C;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v5" target="v13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e23" value="" style="endArrow=none;html=1;strokeColor=#1E233C;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v5" target="v14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e24" value="" style="endArrow=none;html=1;strokeColor=#1E233C;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v5" target="v11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e25" value="" style="endArrow=none;html=1;strokeColor=#1E233C;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v5" target="v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e26" value="" style="endArrow=none;html=1;strokeColor=#1E233C;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v5" target="v12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e27" value="" style="endArrow=none;html=1;strokeColor=#1E233C;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v5" target="v15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e28" value="" style="endArrow=none;html=1;strokeColor=#1E233C;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v8" target="v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v29" value="ภาพนี้อยู่ระดับ &lt;i&gt;summary use case&lt;/i&gt; — หนึ่งวงรีคือหนึ่งแพ็กเกจ รายละเอียดอยู่หน้า 2–3 และรายการครบทุกข้ออยู่หน้า 4&lt;br&gt;&lt;br&gt;ในรายวิชามี&lt;b&gt;บทบาทเดียว&lt;/b&gt; — ผู้สอนทุกคนของวิชามีสิทธิ์เท่ากัน (D1) · ผู้ดูแลระบบ&lt;b&gt;ไม่ทำงานในรายวิชา&lt;/b&gt; — สร้าง ลบ และผูกผู้สอนเข้ากับรายวิชา แล้วงานในรายวิชาเป็นของผู้สอน · ผู้ยังไม่มีบัญชีลงทะเบียนเองได้ด้วยอีเมลคณะหรือ Google (D6)" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7192;fontColor=#1E233C;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=14;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%2BThai;" vertex="1" parent="1"><mxGeometry x="1050" y="110" width="400" height="124" as="geometry"/></mxCell><mxCell id="v30" value="แพ็กเกจ 2 · &lt;b&gt;สร้างและลบรายวิชา&lt;/b&gt; (2.1 · 2.3) ทำได้ทั้งผู้ดูแลระบบ และผู้สอน (ลบได้เฉพาะวิชาที่ตนสอน) · &lt;b&gt;ผู้ดูแลระบบ&lt;/b&gt; แต่งตั้งผู้สอน (2.4) · &lt;b&gt;ผู้สอน&lt;/b&gt; เพิ่ม/ถอดเพื่อนผู้สอน (2.6 · 2.8) และแก้ข้อมูลวิชา (2.2 · 2.5)" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7192;fontColor=#1E233C;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=14;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%2BThai;" vertex="1" parent="1"><mxGeometry x="1050" y="690" width="400" height="90" as="geometry"/></mxCell><mxCell id="e31" value="" style="endArrow=none;dashed=1;dashPattern=2 3;html=1;strokeColor=#6B7192;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v30" target="v16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v32" value="สัญลักษณ์เฉพาะเอกสารนี้ (นอกเหนือ UML 2.5)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1E233C;fontSize=10;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%2BThai;fontColor=#6B7192;" vertex="1" parent="1"><mxGeometry x="440" y="896" width="300" height="16" as="geometry"/></mxCell><mxCell id="v