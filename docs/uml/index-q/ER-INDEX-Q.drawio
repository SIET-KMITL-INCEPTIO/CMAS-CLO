10;startSize=10;strokeColor=#1E233C;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;startArrow=ERmandOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="v53" target="v37"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="852" y="172"/><mxPoint x="852" y="382"/></Array></mxGeometry></mxCell><mxCell id="e139" style="edgeStyle=none;rounded=0;html=1;endSize=10;startSize=10;strokeColor=#1E233C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=ERmandOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="v2" target="v38"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="432" y="172"/><mxPoint x="432" y="406"/></Array></mxGeometry></mxCell><mxCell id="e140" style="edgeStyle=none;rounded=0;html=1;endSize=10;startSize=10;strokeColor=#1E233C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;startArrow=ERmandOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="v36" target="v46"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="778" y="358"/><mxPoint x="778" y="664"/></Array></mxGeometry></mxCell><mxCell id="e141" style="edgeStyle=none;rounded=0;html=1;endSize=10;startSize=10;strokeColor=#1E233C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;startArrow=ERmandOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="v2" target="v18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="358" y="172"/><mxPoint x="358" y="622"/></Array></mxGeometry></mxCell><mxCell id="e142" style="edgeStyle=none;rounded=0;html=1;endSize=10;startSize=10;strokeColor=#1E233C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;startArrow=ERmandOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="v2" target="v19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="376.5" y="172"/><mxPoint x="376.5" y="646"/></Array></mxGeometry></mxCell><mxCell id="v143" value="ER Diagram · ข้อมูลของ index-q.html" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;fontStyle=1;fontColor=#1E233C;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="900" height="34" as="geometry"/></mxCell><mxCell id="v144" value="สร้างจาก docs/reference/db/mysql/index-q.sql ด้วย scripts/build-er-index-q-drawio.py — แก้ที่ไฟล์ SQL แล้วสร้างใหม่ อย่าแก้ที่ภาพ · 15 ตาราง · 18 ความสัมพันธ์ · สัญกรณ์ crow's foot" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#6B7192;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1600" height="40" as="geometry"/></mxCell><mxCell id="v145" value="&lt;b&gt;อ่านภาพนี้อย่างไร&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; คีย์หลัก (ขีดเส้นใต้) · &lt;b&gt;FK&lt;/b&gt; คีย์นอก · &lt;b&gt;UQ&lt;/b&gt; ค่าไม่ซ้ำ&lt;br&gt;&lt;b&gt;เส้น&lt;/b&gt; — ขีดคู่ฝั่งตารางแม่ = ต้องมีหนึ่งแถว · ตีนกาฝั่งตารางลูก = ศูนย์ถึงหลายแถว · วงกลมกับขีด = ศูนย์หรือหนึ่งแถว&lt;br&gt;&lt;br&gt;&lt;b&gt;StudentGrade → Student เป็น 1:1&lt;/b&gt; เพราะ studentId เป็น UNIQUE — หนึ่งการลงทะเบียนมีเกรดเดียว&lt;br&gt;&lt;b&gt;AuthEvent มีเส้นไป User สองเส้น&lt;/b&gt; — userId คือบัญชีที่ถูกกระทำ actorId คือผู้กระทำ&lt;br&gt;&lt;b&gt;คะแนน CLO ไปถึงผ่านจุดประสงค์&lt;/b&gt; — Activity → AssessmentCriteria → BehavioralObjective → CLO (migration 0006)&lt;br&gt;&lt;b&gt;Course คือราก&lt;/b&gt; — ไม่มีตารางใดอยู่เหนือรายวิชา (ตัด Curriculum/PLO ตามมติ 2.7)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7192;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#1E233C;" vertex="1" parent="1"><mxGeometry x="40" y="1014" width="820" height="175" as="geometry"/></mxCell><mxCell id="v146" value="&lt;b&gt;พื้นเหลือง = [index-q]&lt;/b&gt; ต้นแบบเสนอเพิ่ม ยังไม่อยู่ใน schema.prisma — ตาราง UploadReject · AuthEvent · คอลัมน์ User.mustChangePassword · User.pwResetAt · User.pwChangedAt · ScoreUploadLog.kind" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#6B7192;" vertex="1" parent="1"><mxGeometry x="940" y="1014" width="640" height="60" as="geometry"/></mxCell><mxCell id="v147" value="&lt;b&gt;สิ่งที่ SQL บังคับไม่ได้ และอยู่ที่แอป&lt;/b&gt;&lt;br&gt;&lt;br&gt;สิทธิ์ในรายวิชา — บทบาทเดียว ผู้สอนทุกคนของวิชาทำได้เท่ากัน (D1) จึงไม่มี CourseInstructor.role · ใครทำอะไรได้ตัดสินที่ rbac middleware (course-role-permissions.md)&lt;br&gt;&lt;br&gt;น้ำหนักรวม 100% · คะแนนไม่เกินคะแนนเต็ม · กิจกรรมกับจุดประสงค์อยู่วิชาเดียวกัน · passwordHash หรือ googleSub ต้องมีอย่างน้อยหนึ่ง — อยู่ใน migrations/0002 0004 0005 0006 ไม่ได้อยู่ในไฟล์ diagram นี้" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7192;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#1E233C;" vertex="1" parent="1"><mxGeometry x="902" y="1086" width="720" height="160" as="geometry"/></mxCell><mxCell id="v148" value="" style="rounded=0;html=1;fillColor=#FFF2CC;strokeColor=#B8912B;" vertex="1" parent="1"><mxGeometry x="902" y="1018" width="28" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
