<mxfile host="drawio" agent="CMAS scripts/build-dfd-index-q-drawio.py" version="24.0.0"><diagram id="dfd0" name="ระดับ 0 · Context"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="920" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="แผนภาพกระแสข้อมูล ระดับ 0 (Context Diagram) — ระบบ CMAS" style="text;align=left;verticalAlign=top;fontSize=22;fontStyle=1;whiteSpace=wrap;html=1;fontColor=#1E233C;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%2BThai;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1100" height="40" as="geometry"/></mxCell><mxCell id="v2" value="มองทั้งระบบเป็นกล่องเดียว: ใครส่งอะไรเข้ามา และได้อะไรกลับไป · รุ่น 1.1 · 2026-10-12" style="text;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;html=1;fontColor=#6B7192;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%2BThai;" vertex="1" parent="1"><mxGeometry x="60" y="72" width="1100" height="30" as="geometry"/></mxCell><mxCell id="v3" value="ผู้สอน" style="rounded=0;strokeWidth=2;fillColor=#E9EBF5;strokeColor=#1E233C;fontSize=16;fontStyle=1;whiteSpace=wrap;html=1;fontColor=#1E233C;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%2BThai;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="200" height="140" as="geometry"/></mxCell><mxCell id="v4" value="ผู้ดูแลระบบ" style="rounded=0;strokeWidth=2;fillColor=#E9EBF5;strokeColor=#1E233C;fontSize=16;fontStyle=1;whiteSpace=wrap;html=1;fontColor=#1E233C;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%2BThai;" vertex="1" parent="1"><mxGeometry x="1500" y="190" width="200" height="100" as="geometry"/></mxCell><mxCell id="v5" value="Google&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:12px&quot;&gt;บริการยืนยันตัวตน&lt;/span&gt;" style="rounded=0;strokeWidth=2;fillColor=#E9EBF5;strokeColor=#1E233C;fontSize=16;fontStyle=1;whiteSpace=wrap;html=1;fontColor=#1E233C;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%2BThai;" vertex="1" parent="1"><mxGeometry x="1500" y="650" width="200" height="100" as="geometry"/></mxCell><mxCell id="v6" value="&lt;b&gt;0&lt;/b&gt;&lt;hr size=&quot;1&quot; color=&quot;#1E233C&quot;&gt;&lt;b&gt;ระบบ CMAS&lt;/b&gt;&lt;br&gt;ติดตามและประเมินผลลัพธ์การเรียนรู้&lt;br&gt;ระดับรายวิชา (CLO)" style="rounded=1;arcSize=16;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#1E233C;fontSize=15;verticalAlign=middle;whiteSpace=wrap;html=1;fontColor=#1E233C;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%2BThai;" vertex="1" parent="1"><mxGeometry x="760" y="380" width="340" height="180" as="geometry"/></mxCell><mxCell id="e7" style="endArrow=block;endFill=1;endSize=7;rounded=1;jumpStyle=arc;jumpSize=10;strokeColor=#1E233C;fontSize=12;labelBackgroundColor=#FFFFFF;html=1;fontColor=#1E233C;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%2BThai;exitX=1;exitY=0.214286;exitDx=0;exitDy=0;entryX=0;entryY=0.277778;entryDx=0;entryDy=0;" edge="1" parent="1" source="v3" target="v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l8" value="คำขอเข้าสู่ระบบ&lt;br&gt;ข้อมูลรายวิชาและการตั้งค่า&lt;br&gt;CLO กิจกรรม และเกณฑ์วัดผล&lt;br&gt;คะแนน (กรอกเองหรือไฟล์ Excel)&lt;br&gt;รายชื่อนักศึกษา&lt;br&gt;คำขอดูผลและรายงาน&lt;br&gt;ช่วงเกรดและการปรับเกรด" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=14;fontColor=#1E233C;labelBackgroundColor=#FFFFFF;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%2BThai;" vertex="1" connectable="0" parent="e7"><mxGeometry x="0" y="-82" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e9" style="endArrow=block;endFill=1;endSize=7;rounded=1;jumpStyle=arc;jumpSize=10;strokeColor=#1E233C;fontSize=12;labelBackgroundColor=#FFFFFF;html=1;fontColor=#1E233C;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%2BThai;exitX=0;exitY=0.722222;exitDx=0;exitDy=0;entryX=1;entryY=0.785714;entryDx=0;entryDy=0;" edge="1" parent="1" source="v6" target="v3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l10" value="ผลการเข้าสู่ระบบ&lt;br&gt;รายการรายวิชา&lt;br&gt;ตาราง CLO และกิจกรรม&lt;br&gt;ตารางคะแนนและผลตรวจไฟล์&lt;br&gt;รายชื่อนักศึกษา&lt;br&gt;ผลการบรรลุ CLO และรายชื่อที่ต้องช่วยเหลือ&lt;br&gt;เกรดและรายงาน" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=14;fontColor=#1E233C;labelBackgroundColor=#FFFFFF;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%2BThai;" vertex="1" connectable="0" parent="e9"><mxGeometry x="0" y="-82" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e11" style="endArrow=block;endFill=1;endSize=7;rounded=1;jumpStyle=arc;jumpSize=10;strokeColor=#1E233C;fontSize=12;labelBackgroundColor=#FFFFFF;html=1;fontColor=#1E233C;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%2BThai;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=0.352941;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v4" target="v6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="220"/></Array></mxGeometry></mxCell><mxCell id="l12" value="คำขอเข้าสู่ระบบ&lt;br&gt;การอนุมัติและปิดบัญชี&lt;br&gt;การมอบหมายผู้สอน" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=14;fontColor=#1E233C;labelBackgroundColor=#FFFFFF;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%2BThai;" vertex="1" connectable="0" parent="e11"><mxGeometry x="-0.35" y="-40" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e13" style="endArrow=block;endFill=1;endSize=7;rounded=1;jumpStyle=arc;jumpSize=10;strokeColor=#1E233C;fontSize=12;labelBackgroundColor=#FFFFFF;html=1;fontColor=#1E233C;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%2BThai;exitX=1;exitY=0.277778;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v6" target="v4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1600" y="430"/></Array></mxGeometry></mxCell><mxCell id="l14" value="รายการบัญชีและประวัติการใช้งาน&lt;br&gt;ผลการมอบหมายผู้สอน" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=14;fontColor=#1E233C;labelBackgroundColor=#FFFFFF;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%2BThai;" vertex="1" connectable="0" parent="e13"><mxGeometry x="-0.3" y="-28" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e15" style="endArrow=block;endFill=1;endSize=7;rounded=1;jumpStyle=arc;jumpSize=10;strokeColor=#1E233C;fontSize=12;labelBackgroundColor=#FFFFFF;html=1;fontColor=#1E233C;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%2BThai;exitX=1;exitY=0.722222;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v6" target="v5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1600" y="510"/></Array></mxGeometry></mxCell><mxCell id="l16" value="คำขอยืนยันตัวตน" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=14;fontColor=#1E233C;labelBackgroundColor=#FFFFFF;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%2BThai;" vertex="1" connectable="0" parent="e15"><mxGeometry x="-0.3" y="16" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e17" style="endArrow=block;endFill=1;endSize=7;rounded=1;jumpStyle=arc;jumpSize=10;strokeColor=#1E233C;fontSize=12;labelBackgroundColor=#FFFFFF;html=1;fontColor=#1E233C;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%2BThai;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=0.352941;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v5" target="v6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="720"/></Array></mxGeometry></mxCell><mxCell id="l18" value="ผลยืนยันตัวตน (อีเมล ชื่อ)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=14;fontColor=#1E233C;labelBackgroundColor=#FFFFFF;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%2BThai;" vertex="1" connectable="0" parent="e17"><mxGeometry x="-0.35" y="16" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="v19" value="&lt;b&gt;อ่านแผนภาพอย่างไร&lt;/b&gt;&lt;br&gt;▪ &lt;b&gt;กล่องสี่เหลี่ยมทึบ&lt;/b&gt; = คนหรือระบบภายนอกที่ส่งหรือรับข้อมูล&lt;br&gt;▪ &lt;b&gt;กล่องมุมมน มีเลข&lt;/b&gt; = งานที่ระบบทำกับข้อมูล · เลขเป็นชื่อเรียก ไม่ใช่ลำดับการทำงาน&lt;br&gt;▪ &lt;b&gt;กล่องเปิดด้านขวา (D1, D2 …)&lt;/b&gt; = ที่เก็บข้อมูล&lt;br&gt;▪ &lt;b&gt;ลูกศร&lt;/b&gt; = ข้อมูลที่ถูกส่ง หัวลูกศรชี้ไปหาผู้รับ&lt;br&gt;▪ &lt;b&gt;ลูกศรมาเป็นคู่เสมอ&lt;/b&gt; = เส้นหนึ่งขอหรือส่งข้อมูล อีกเส้นคือคำตอบที่ได้กลับ&lt;br&gt;&lt;br&gt;นักศึกษาไม่ได้ใช้ระบบเอง — ข้อมูลของนักศึกษาเข้ามาทางผู้สอน" style="rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#6B7192;dashed=1;align=left;verticalAlign=top;spacing=12;fontSize=12;whiteSpace=wrap;html=1;fontColor=#1E233C;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%2BThai;" vertex="1" parent="1"><mxGeometry x="60" y="720" width="620" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="dfd1" name="ระดับ 1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2640" pageHeight="1460" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="แผนภาพกระแสข้อมูล ระดับ 1 — ระบบ CMAS" style="text;align=left;verticalAlign=top;fontSize=22;fontStyle=1;whiteSpace=wrap;html=1;fontColor=#1E233C;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%2BThai;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="900" height="40" as="geometry"/></mxCell><mxCell id="v2" value="เปิดกล่อง &quot;ระบบ CMAS&quot; ของระดับ 0 ออกเป็น 6 งาน · ซ้ายคือการป้อนข้อมูล ขวาคือผลที่ได้ · รุ่น 1.1 · 2026-10-12" style="text;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;html=1;fontColor=#6B7192;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%2BThai;" vertex="1" parent="1"><mxGeometry x="60" y="62" width="1000" height="30" as="geometry"/></mxCell><mxCell id="v3" value="ผู้สอน" style="rounded=0;strokeWidth=2;fillColor=#E9EBF5;strokeColor=#1E233C;fontSize=16;fontStyle=1;whiteSpace=wrap;html=1;fontColor=#1E233C;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%2BThai;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="170" height="1150" as="geometry"/></mxCell><mxCell id="v4" value="Google&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:12px&quot;&gt;บริการยืนยันตัวตน&lt;/span&gt;" style="rounded=0;strokeWidth=2;fillColor=#E9EBF5;strokeColor=#1E233C;fontSize=16;font