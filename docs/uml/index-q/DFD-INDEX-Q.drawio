#1E233C;fontSize=12;labelBackgroundColor=#FFFFFF;html=1;fontColor=#1E233C;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%2BThai;exitX=1;exitY=0.660714;exitDx=0;exitDy=0;entryX=0;entryY=0.584906;entryDx=0;entryDy=0;" edge="1" parent="1" source="v16" target="v18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l102" value="ผลการบรรลุ CLO · รายชื่อที่ต้องช่วยเหลือ&lt;br&gt;เกรด · สถิติ · รายงาน Excel" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=12;fontColor=#1E233C;labelBackgroundColor=#FFFFFF;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%2BThai;" vertex="1" connectable="0" parent="e101"><mxGeometry x="0" y="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e103" style="endArrow=block;endFill=1;endSize=7;rounded=1;jumpStyle=arc;jumpSize=10;strokeColor=#1E233C;fontSize=12;labelBackgroundColor=#FFFFFF;html=1;fontColor=#1E233C;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%2BThai;exitX=0.28;exitY=0;exitDx=0;exitDy=0;entryX=0.288462;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v16" target="v17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l104" value="ช่วงเกรด&lt;br&gt;เกรดที่ตรึง" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=12;fontColor=#1E233C;labelBackgroundColor=#FFFFFF;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%2BThai;" vertex="1" connectable="0" parent="e103"><mxGeometry x="0" y="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e105" style="endArrow=block;endFill=1;endSize=7;rounded=1;jumpStyle=arc;jumpSize=10;strokeColor=#1E233C;fontSize=12;labelBackgroundColor=#FFFFFF;html=1;fontColor=#1E233C;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%2BThai;exitX=0.711538;exitY=1;exitDx=0;exitDy=0;entryX=0.72;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v17" target="v16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l106" value="ช่วงเกรด&lt;br&gt;เกรดที่มีอยู่" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=12;fontColor=#1E233C;labelBackgroundColor=#FFFFFF;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%2BThai;" vertex="1" connectable="0" parent="e105"><mxGeometry x="0" y="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="v107" value="&lt;b&gt;อ่านแผนภาพอย่างไร&lt;/b&gt;&lt;br&gt;▪ &lt;b&gt;กล่องสี่เหลี่ยมทึบ&lt;/b&gt; = คนหรือระบบภายนอกที่ส่งหรือรับข้อมูล&lt;br&gt;▪ &lt;b&gt;กล่องมุมมน มีเลข&lt;/b&gt; = งานที่ระบบทำกับข้อมูล · เลขเป็นชื่อเรียก ไม่ใช่ลำดับการทำงาน&lt;br&gt;▪ &lt;b&gt;กล่องเปิดด้านขวา (D1, D2 …)&lt;/b&gt; = ที่เก็บข้อมูล&lt;br&gt;▪ &lt;b&gt;ลูกศร&lt;/b&gt; = ข้อมูลที่ถูกส่ง หัวลูกศรชี้ไปหาผู้รับ&lt;br&gt;▪ &lt;b&gt;ลูกศรมาเป็นคู่เสมอ&lt;/b&gt; = เส้นหนึ่งขอหรือส่งข้อมูล อีกเส้นคือคำตอบที่ได้กลับ&lt;br&gt;&lt;br&gt;&lt;b&gt;แต่ละที่เก็บข้อมูลคือตารางใดในฐานข้อมูล&lt;/b&gt;&lt;br&gt;&lt;b&gt;D1 บัญชีผู้ใช้&lt;/b&gt; — User, EmailVerificationToken, AuthEvent&lt;br&gt;&lt;b&gt;D2 รายวิชา&lt;/b&gt; — Course, CourseInstructor&lt;br&gt;&lt;b&gt;D3 CLO กิจกรรม และเกณฑ์&lt;/b&gt; — CLO, BehavioralObjective, Activity, AssessmentCriteria, CourseGroupWeight&lt;br&gt;&lt;b&gt;D4 คะแนน&lt;/b&gt; — Score, ScoreChange, ScoreUploadLog, UploadReject&lt;br&gt;&lt;b&gt;D5 นักศึกษา&lt;/b&gt; — Student&lt;br&gt;&lt;b&gt;D6 เกรด&lt;/b&gt; — GradeBand, StudentGrade" style="rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#6B7192;dashed=1;align=left;verticalAlign=top;spacing=12;fontSize=12;whiteSpace=wrap;html=1;fontColor=#1E233C;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%2BThai;" vertex="1" parent="1"><mxGeometry x="1640" y="110" width="930" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>